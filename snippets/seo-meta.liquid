{% liquid
  assign seo_title = page_title
  if current_tags
    assign meta_tags = current_tags | join: ', '
    assign seo_title = seo_title | append: ' – ' | append: meta_tags
  endif
  unless seo_title contains shop.name
    assign seo_title = seo_title | append: ' – ' | append: shop.name
  endunless
  assign seo_description = page_description | default: shop.description | strip_html | strip_newlines | truncate: 160
%}
<title>{{ seo_title | escape }}</title>
{% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- liquid
  assign favicon_image = settings.favicon
  if favicon_image != blank
    assign favicon_png = favicon_image | image_url: width: 32
    assign favicon_apple = favicon_image | image_url: width: 180
  else
    assign favicon_png = 'favicon.png' | asset_url
    assign favicon_apple = 'favicon-apple-touch.png' | asset_url
  endif
  assign favicon_svg = 'favicon.svg' | asset_url
-%}
<link rel="icon" href="{{ favicon_svg }}" type="image/svg+xml">
<link rel="icon" href="{{ favicon_png }}" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="{{ favicon_apple }}">
<meta name="theme-color" content="#1f473e">
{% if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == '404' %}<meta name="robots" content="noindex,follow">{% else %}<meta name="robots" content="index,follow,max-image-preview:large">{% endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{% if seo_description != blank %}<meta property="og:description" content="{{ seo_description | escape }}">{% endif %}
{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}"><meta property="og:image:width" content="1200">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{% if seo_description != blank %}<meta name="twitter:description" content="{{ seo_description | escape }}">{% endif %}
{% if page_image %}<meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
