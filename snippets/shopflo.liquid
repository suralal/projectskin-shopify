{%- comment -%}
  Shopflo Flo Cart + Flo Checkout.

  Shopflo's bridge keys off window.location.host for health checks.
  Theme Dev (127.0.0.1) fails that check, so we rewrite shop-url /
  shop_url / shopUrl to the real storefront domain before the bundle runs.
{%- endcomment -%}
{%- assign is_shopflo_enabled = true -%}
{%- if settings.shopflo_enabled == false -%}
  {%- assign is_shopflo_enabled = false -%}
{%- endif -%}
{%- if is_shopflo_enabled -%}
  <script>
    window.PurityTheme = window.PurityTheme || {};
    window.PurityTheme.shopfloEnabled = true;
    window.PurityTheme.shopfloUseFloCart = {% if settings.shopflo_use_flo_cart == false %}false{% else %}true{% endif %};
    window.PurityTheme.shopUrl = {{ shop.url | json }};
    window.PurityTheme.shopDomain = {{ shop.permanent_domain | json }};
    window.PurityTheme.shopfloHost = 'theprojectskin.com';

    (function installShopfloShopUrlShim() {
      var realHost = 'theprojectskin.com';
      var current = window.location.host || '';
      var hostname = window.location.hostname || '';
      if (current === realHost) return;

      function shouldRewriteValue(value) {
        if (!value) return false;
        var decoded = value;
        try { decoded = decodeURIComponent(value); } catch (e) {}
        return (
          decoded === current ||
          decoded === hostname ||
          decoded === 'q9wi15-80.myshopify.com' ||
          /^(127\.0\.0\.1|localhost)(:\d+)?$/i.test(decoded)
        );
      }

      function rewriteUrl(url) {
        if (typeof url !== 'string') return url;
        if (
          url.indexOf('shop-url=') === -1 &&
          url.indexOf('shop_url=') === -1 &&
          url.indexOf('shopUrl=') === -1
        ) {
          return url;
        }
        return url.replace(/(shop-url=|shop_url=|shopUrl=)([^&#]*)/g, function (_, key, raw) {
          return shouldRewriteValue(raw) ? key + encodeURIComponent(realHost) : key + raw;
        });
      }

      var originalFetch = window.fetch;
      if (typeof originalFetch === 'function') {
        window.fetch = function (input, init) {
          try {
            if (typeof input === 'string') {
              input = rewriteUrl(input);
            } else if (input && typeof input.url === 'string') {
              var rewritten = rewriteUrl(input.url);
              if (rewritten !== input.url) input = new Request(rewritten, input);
            }
          } catch (e) {}
          return originalFetch.call(this, input, init);
        };
      }

      if (window.XMLHttpRequest) {
        var originalOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function (method, url) {
          if (typeof url === 'string') arguments[1] = rewriteUrl(url);
          return originalOpen.apply(this, arguments);
        };
      }

      try {
        var srcDescriptor = Object.getOwnPropertyDescriptor(HTMLIFrameElement.prototype, 'src');
        if (srcDescriptor && srcDescriptor.set) {
          Object.defineProperty(HTMLIFrameElement.prototype, 'src', {
            configurable: true,
            enumerable: srcDescriptor.enumerable,
            get: srcDescriptor.get,
            set: function (value) {
              srcDescriptor.set.call(this, rewriteUrl(String(value || '')));
            }
          });
        }
      } catch (e) {}

      var originalSetAttribute = Element.prototype.setAttribute;
      Element.prototype.setAttribute = function (name, value) {
        if (String(name).toLowerCase() === 'src' && this.tagName === 'IFRAME') {
          value = rewriteUrl(String(value || ''));
        }
        return originalSetAttribute.call(this, name, value);
      };
    })();

    // The 540 KB bridge used to load `async` in <head>, so it parsed and executed
    // while the page was still painting. Nothing on the first screen needs it —
    // it is only required once someone touches cart or checkout. Load it on the
    // first user interaction, or when the browser goes idle, or 2s after load,
    // whichever comes first; and force it immediately if a cart path asks.
    window.PurityShopfloLoader = (function () {
      var injected = false;

      function inject() {
        if (injected) return;
        injected = true;
        var script = document.createElement('script');
        script.src = 'https://bridge.shopflo.com/js/shopflo.bundle.js';
        script.async = true;
        document.head.appendChild(script);
      }

      var events = ['pointerdown', 'keydown', 'touchstart'];
      function onIntent() {
        events.forEach(function (type) { window.removeEventListener(type, onIntent, true); });
        inject();
      }
      events.forEach(function (type) {
        window.addEventListener(type, onIntent, { capture: true, passive: true });
      });

      function scheduleIdle() {
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(inject, { timeout: 2000 });
        } else {
          setTimeout(inject, 2000);
        }
      }
      if (document.readyState === 'complete') scheduleIdle();
      else window.addEventListener('load', scheduleIdle, { once: true });

      return { ensureLoaded: inject };
    })();

    window.PurityShopflo = (function () {
      function ensureLoaded() {
        window.PurityShopfloLoader && window.PurityShopfloLoader.ensureLoaded();
      }

      function floActive() {
        if (window.Shopflo && window.Shopflo.isFloCheckoutEnabled) return true;
        var cfg = window.shopfloConfig || {};
        if (cfg.enableShopfloCheckout) return true;
        // Bundle may swap in real handlers before shopfloConfig flips.
        if (typeof window.handleFloCartBtn === 'function' && !isFallbackCartHandler()) return true;
        return false;
      }

      function isFallbackCartHandler() {
        try {
          return String(window.handleFloCartBtn || '').indexOf('flo_skip_cart_redirect') !== -1;
        } catch (e) {
          return true;
        }
      }

      function storeCheckoutUrl() {
        var base = (window.PurityTheme && window.PurityTheme.shopUrl) || '';
        if (!base && window.Shopify && window.Shopify.shop) {
          base = 'https://' + window.Shopify.shop;
        }
        return (base || '') + '/checkout';
      }

      return {
        floActive: floActive,

        ensureLoaded: ensureLoaded,

        /**
         * The bridge now loads lazily, so a very early checkout click can land
         * before it is ready. Give it a short budget to arrive rather than
         * falling straight through to the native checkout — the fallback is
         * still there, it just isn't taken on a race.
         */
        checkout: function () {
          ensureLoaded();
          var started = Date.now();

          function open() {
            if (floActive() && typeof window.handleFloCheckoutBtn === 'function' && !isFallbackCartHandler()) {
              window.handleFloCheckoutBtn();
              return true;
            }
            if (floActive() && window.Shopflo && typeof window.Shopflo.openCheckout === 'function') {
              window.Shopflo.openCheckout();
              return true;
            }
            return false;
          }

          function attempt() {
            if (open()) return;
            if (Date.now() - started >= 1500) {
              window.location.assign(storeCheckoutUrl());
              return;
            }
            setTimeout(attempt, 100);
          }
          attempt();
          return true;
        },

        buyNow: function (event) {
          ensureLoaded();
          if (!floActive()) return false;
          if (typeof window.handleFloBuyNowBtn === 'function') {
            window.handleFloBuyNowBtn(event);
            return true;
          }
          return false;
        },

        cart: function () {
          ensureLoaded();
          if (!window.PurityTheme || !window.PurityTheme.shopfloUseFloCart) return false;

          if (floActive() && !isFallbackCartHandler() && typeof window.handleFloCartBtn === 'function') {
            window.handleFloCartBtn();
            return true;
          }

          if (window.Shopflo && typeof window.Shopflo.openFloCart === 'function' && floActive()) {
            window.Shopflo.openFloCart();
            return true;
          }

          return false;
        },

        /**
         * Wait briefly for Shopflo health to flip floActive, then open Flo Cart.
         * Matches live theme: ATC / bag icon should open the "Powered by shopflo" drawer.
         */
        openCartWhenReady: function (timeoutMs) {
          ensureLoaded();
          var self = this;
          var budget = typeof timeoutMs === 'number' ? timeoutMs : 4000;
          var started = Date.now();

          return new Promise(function (resolve) {
            function attempt() {
              if (self.cart()) {
                resolve(true);
                return;
              }
              if (Date.now() - started >= budget) {
                resolve(false);
                return;
              }
              setTimeout(attempt, 120);
            }
            attempt();
          });
        }
      };
    })();
  </script>
{%- endif -%}
