{% assign review_rows = reviews_blob | strip | split: '###' %}
{% assign review_total = 0 %}
{% for row in review_rows %}
  {% assign parts = row | strip | split: '|' %}
  {% if parts.size >= 4 %}
    {% assign review_total = review_total | plus: 1 %}
  {% endif %}
{% endfor %}

<div class="pdp-reviews-fallback" data-reviews-fallback>
  <div class="pdp-reviews-fallback__board">
    <div class="pdp-reviews-fallback__score">
      <strong>{{ review_rating }}</strong>
      <div class="pdp-reviews-fallback__stars" aria-hidden="true">★★★★★</div>
      <small>Based on {{ review_count_label }}</small>
    </div>
    <div class="pdp-reviews-fallback__bars" aria-hidden="true">
      <div class="pdp-reviews-fallback__bar"><span>5</span><i style="--w: {{ bar_5 }}%"></i></div>
      <div class="pdp-reviews-fallback__bar"><span>4</span><i style="--w: {{ bar_4 }}%"></i></div>
      <div class="pdp-reviews-fallback__bar"><span>3</span><i style="--w: {{ bar_3 }}%"></i></div>
      <div class="pdp-reviews-fallback__bar"><span>2</span><i style="--w: {{ bar_2 }}%"></i></div>
      <div class="pdp-reviews-fallback__bar"><span>1</span><i style="--w: {{ bar_1 }}%"></i></div>
    </div>
    <div class="pdp-reviews-fallback__cta">
      <p>Real voices on texture, climate, and consistency — while verified Judge.me reviews accumulate.</p>
      <button
        type="button"
        class="pdp-reviews-fallback__write"
        data-write-review-trigger
        data-product-id="{{ product.id }}"
        data-fallback-url="https://api.judge.me/storefront_reviews/new?shop_domain={{ shop.permanent_domain | default: 'q9wi15-80.myshopify.com' }}&platform=shopify&product_id={{ product.id }}"
        aria-label="Write a verified review for {{ product.title | escape }}"
      >
        Write a verified review
      </button>
    </div>
  </div>

  <div class="pdp-reviews-fallback__filters" role="tablist" aria-label="Filter feedback">
    <button type="button" class="is-active" data-review-filter="all" aria-pressed="true">All</button>
    <button type="button" data-review-filter="texture" aria-pressed="false">Texture</button>
    <button type="button" data-review-filter="routine" aria-pressed="false">Routine</button>
    <button type="button" data-review-filter="climate" aria-pressed="false">Climate</button>
    <button type="button" data-review-filter="formula" aria-pressed="false">Formula</button>
    <button type="button" data-review-filter="results" aria-pressed="false">Results</button>
  </div>

  <div class="pdp-reviews-fallback__list" data-review-list data-collapsed="true">
    {% for row in review_rows %}
      {% assign parts = row | strip | split: '|' %}
      {% if parts.size >= 4 %}
        {% liquid
          assign r_name = parts[0] | strip
          assign r_city = parts[1] | strip
          assign r_title = parts[2] | strip
          assign r_body = parts[3] | strip
          assign r_skin = parts[4] | default: 'Project Skin' | strip
          assign r_duration = parts[5] | default: '' | strip
          assign r_theme = parts[6] | default: 'routine' | strip | downcase
        %}
        <article class="pdp-review pdp-reviews-fallback__card" data-review-theme="{{ r_theme }}">
          <div class="pdp-reviews-fallback__card-top">
            <div class="pdp-review__stars" aria-label="5 out of 5 stars">★★★★★</div>
            {% if r_duration != blank %}
              <span class="pdp-reviews-fallback__duration">{{ r_duration }}</span>
            {% endif %}
          </div>
          <h3>{{ r_title }}</h3>
          <div class="pdp-review__copy"><p>{{ r_body }}</p></div>
          <div class="pdp-review__meta">
            <span class="pdp-review__avatar" aria-hidden="true">{{ r_name | slice: 0 }}</span>
            <div>
              <strong>{{ r_name }}</strong>
              <span>{{ r_city }}{% if r_skin != blank %} · {{ r_skin }}{% endif %}</span>
            </div>
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {% if review_total > 4 %}
    <button type="button" class="pdp-reviews-fallback__more" data-review-more>
      Show more feedback
    </button>
  {% endif %}
</div>

<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-reviews-fallback')) {
      root = document.querySelector('[data-reviews-fallback]');
    }
    if (!root) return;
    var list = root.querySelector('[data-review-list]');
    var more = root.querySelector('[data-review-more]');
    var filters = root.querySelectorAll('[data-review-filter]');
    var cards = root.querySelectorAll('[data-review-theme]');

    function applyFilter(theme) {
      cards.forEach(function (card) {
        var match = theme === 'all' || card.getAttribute('data-review-theme') === theme;
        card.hidden = !match;
      });
      if (list) list.setAttribute('data-collapsed', theme === 'all' ? 'true' : 'false');
      if (more) more.hidden = theme !== 'all';
    }

    filters.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filters.forEach(function (b) {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        applyFilter(btn.getAttribute('data-review-filter'));
      });
    });

    if (more && list) {
      more.addEventListener('click', function () {
        var collapsed = list.getAttribute('data-collapsed') !== 'false';
        list.setAttribute('data-collapsed', collapsed ? 'false' : 'true');
        more.textContent = collapsed ? 'Show less' : 'Show more feedback';
      });
    }
  })();
</script>
