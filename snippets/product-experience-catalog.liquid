{% comment %}
  Product-aware FOR / FEEL / FINISH experience cards.
{% endcomment %}
{% case product.handle %}
  {% when 'protecting-sunscreen-acne-prone-skin' %}
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FOR</p>
      <h3>Acne-prone Indian skin</h3>
      <p>Built for heat, humidity, and pigmentation-prone skin that still needs serious UV coverage.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FEEL</p>
      <h3>Lightweight aqua gel</h3>
      <p>Water-light glide that settles without a thick white cast or greasy film.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FINISH</p>
      <h3>Wearable all day</h3>
      <p>Zinc PCA helps keep the finish comfortable so SPF stays on — not wiped off.</p>
    </article>

  {% when 'calming-moisturiser-acne-prone-skin' %}
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FOR</p>
      <h3>Barrier-compromised, acne-prone skin</h3>
      <p>Hydration and lipid support for skin that gets dry, reactive, or stripped by treatments.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FEEL</p>
      <h3>Lightweight gel cream</h3>
      <p>Cushion without grease — designed to sit under sunscreen without pilling.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FINISH</p>
      <h3>Calm and SPF-ready</h3>
      <p>Hypoallergenic, dermatologically tested comfort that doesn’t fight the rest of your routine.</p>
    </article>

  {% when 'refreshing-cleanser-acne-prone-skin' %}
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FOR</p>
      <h3>Oily, congestion-prone skin</h3>
      <p>Clears excess oil and impurities without the tight, squeaky aftermath of harsh cleansers.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FEEL</p>
      <h3>Fresh, soap-free cleanse</h3>
      <p>Amino-acid and plant-derived surfactants rinse clean while barrier lipids stay supported.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FINISH</p>
      <h3>Soft, not stripped</h3>
      <p>Skin feels clear and comfortable — ready for serum, not begging for moisture.</p>
    </article>

  {% when '5-niacinamide-serum-acne-prone-skin' %}
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FOR</p>
      <h3>Oily and acne-prone skin</h3>
      <p>Built for congestion, excess oil, and everyday Indian climate.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FEEL</p>
      <h3>Lightweight water-serum</h3>
      <p>Fast-absorbing texture that layers cleanly under moisturiser and SPF.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FINISH</p>
      <h3>Fragrance-free focus</h3>
      <p>No added fragrance — centred on actives, comfort, and clarity.</p>
    </article>

  {% when 'active-boba-encapsulated-cream-acne-prone-skin' %}
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FOR</p>
      <h3>Breakout-prone skin that needs barrier care</h3>
      <p>Treatment and comfort in one cream — for days when a serum alone isn’t enough.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FEEL</p>
      <h3>Encapsulated gel cream</h3>
      <p>Visible capsules release into a hydrating base as you apply — fresh actives, cushioned finish.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FINISH</p>
      <h3>Balanced, non-comedogenic</h3>
      <p>Dermatologically tested cream that targets clarity without a heavy, pore-clogging feel.</p>
    </article>

  {% when 'clear-seal' %}
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FOR</p>
      <h3>Active, visible breakouts</h3>
      <p>Spot-focused care when you need treatment and a discreet shield in one step.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FEEL</p>
      <h3>Liquid-to-film texture</h3>
      <p>Pumps on as a liquid, dries into an invisible protective film — no bulky patch.</p>
    </article>
    <article class="pdp-experience__card">
      <p class="pdp-experience__kicker">FINISH</p>
      <h3>Virtually undetectable</h3>
      <p>Shields from dirt, friction, and picking while moisture support helps limit dryness.</p>
    </article>
{% endcase %}
