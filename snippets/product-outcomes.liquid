  {% when 'project-skin-complete-4-step-skincare-routine-kit' %}
    {% unless concern_only %}
      <div class="pdp-outcomes" aria-label="Key product outcomes">
        <article class="pdp-outcome"><strong>4</strong><span>Essential steps</span><small>Cleanse, treat, moisturise, protect — one complete system</small></article>
        <article class="pdp-outcome"><strong>₹647</strong><span>You save</span><small>Vs buying each step separately at full price</small></article>
        <article class="pdp-outcome"><strong>Derm</strong><span>Dermatologically tested</span><small>Formulated for oily and acne-prone Indian skin</small></article>
