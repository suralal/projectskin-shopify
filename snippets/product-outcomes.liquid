{% comment %}
  Product-specific buy-box concern + outcome tiles when section blocks are empty.
{% endcomment %}
{% case product.handle %}
  {% when '5-niacinamide-serum-acne-prone-skin' %}
    {% unless concern_only %}
      <div class="pdp-outcomes" aria-label="Key product outcomes">
        <article class="pdp-outcome"><strong>5%</strong><span>Encapsulated niacinamide</span><small>pH-stabilised delivery for oil balance and clearer texture</small></article>
        <article class="pdp-outcome"><strong>Dual</strong><span>Sebum-control system</span><small>SEPICONCONTROL™ A5 + Zinc PCA on two pathways</small></article>
        <article class="pdp-outcome"><strong>PDRN</strong><span>Recovery support</span><small>Plus Saccharide Isomerate for lasting hydration</small></article>
      </div>
    {% endunless %}
  {% when 'calming-moisturiser-acne-prone-skin' %}
    {% unless concern_only %}
      <div class="pdp-outcomes" aria-label="Key product outcomes">
        <article class="pdp-outcome"><strong>6</strong><span>Botanical complex</span><small>Amla, Licorice, Tulsi, Black Seed, Neem, Phytic Acid</small></article>
        <article class="pdp-outcome"><strong>Barrier</strong><span>Ceramide + lipids</span><small>Phospholipids and sphingolipids replenish the matrix</small></article>
        <article class="pdp-outcome"><strong>SPF</strong><span>Sits under sunscreen</span><small>Lightweight gel — no pilling, no grease</small></article>
      </div>
