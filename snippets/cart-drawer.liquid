<div class="drawer-backdrop" data-drawer-backdrop></div><aside class="cart-drawer" data-cart-drawer aria-label="Shopping cart"><div class="cart-drawer__header"><strong>Shopping bag</strong><button class="icon-button" type="button" data-drawer-close aria-label="Close cart">{% render 'icon', name:'close' %}</button></div>{% if settings.free_shipping_message %}<div class="shipping-progress" data-shipping-progress data-threshold="{{ settings.free_shipping_threshold | times: 100 }}"><div class="shipping-progress__message" data-shipping-message></div><div class="shipping-progress__bar"><span data-shipping-bar></span></div></div>{% endif %}<div class="cart-drawer__body" data-cart-body>{% if cart.item_count == 0 %}<div class="cart-empty"><h3>Your cart is empty</h3><p class="muted">Discover something made for your routine.</p></div>{% else %}
  {% for item in cart.items %}
    <div class="cart-item" data-line="{{ forloop.index }}">
      {% if item.image %}{{ item.image | image_url:width:160 | image_tag }}{% endif %}
      <div class="cart-item__main">
        <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
        {% unless item.variant.title == 'Default Title' %}
          <div class="cart-item__variant">{{ item.variant.title }}</div>
        {% endunless %}
        <div class="cart-item__unit-price">{{ item.final_price | money }}</div>
        <div class="cart-item__controls">
          <div class="cart-item__quantity">
            <button type="button" class="cart-item__qty-btn" data-cart-qty="minus" data-line="{{ forloop.index }}" aria-label="Decrease quantity">−</button>
            <span class="cart-item__qty-val" data-cart-qty-val>{{ item.quantity }}</span>
            <button type="button" class="cart-item__qty-btn" data-cart-qty="plus" data-line="{{ forloop.index }}" aria-label="Increase quantity">+</button>
          </div>
          <button class="cart-item__remove" type="button" data-cart-remove="{{ forloop.index }}" aria-label="Remove item">Remove</button>
        </div>
      </div>
      <strong class="cart-item__line-price">{{ item.final_line_price | money }}</strong>
    </div>
  {% endfor %}
{% endif %}</div>{% if settings.cart_recommendations != blank %}<div class="cart-recommendations"><div class="cart-recommendations__head"><strong>You may also like</strong></div><div class="cart-recommendations__track">{% for product in settings.cart_recommendations.products limit: 4 %}<div class="cart-rec"> <a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url:width:180 | image_tag:loading:'lazy' }}{% endif %}<span>{{ product.title }}</span><small>{{ product.price | money }}</small></a>{% form 'product', product, class:'cart-rec__form' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit" class="cart-rec__add" {% unless product.available %}disabled{% endunless %}>{% if product.available %}+ Add{% else %}Sold out{% endif %}</button>{% endform %}</div>{% endfor %}</div></div>{% endif %}<div class="cart-drawer__footer"><form class="cart-discount" data-discount-form><label for="CartDiscount">Discount code</label><div><input id="CartDiscount" type="text" placeholder="Enter code" data-discount-code><button type="submit">Apply</button></div></form><div class="cart-subtotal"><span>Subtotal</span><strong data-cart-subtotal>{{ cart.total_price | money }}</strong></div><p class="cart-note muted">Taxes and shipping calculated at checkout.</p><a href="{{ routes.cart_url }}" class="button button--secondary button--full">View cart</a><button type="button" id="checkout2" name="checkout2" class="button button--full" data-shopflo-checkout onclick="if(typeof handleFloCheckoutBtn==='function'){handleFloCheckoutBtn();return false;}">Checkout</button></div></aside><div class="cart-toast" data-toast></div>