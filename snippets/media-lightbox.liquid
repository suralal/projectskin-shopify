<div class="media-lightbox" data-media-lightbox aria-hidden="true">
  <button class="media-lightbox__close" type="button" data-lightbox-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
  <button class="media-lightbox__nav media-lightbox__prev" type="button" data-lightbox-prev aria-label="Previous">‹</button>
  <div class="media-lightbox__stage"><img data-lightbox-image src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" width="1200" height="1200" alt=""></div>
  <button class="media-lightbox__nav media-lightbox__next" type="button" data-lightbox-next aria-label="Next">›</button>
</div>
