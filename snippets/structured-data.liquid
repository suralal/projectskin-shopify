{% capture search_target %}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{% endcapture %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop.url }}/#website",
  "name": "Project Skin",
  "alternateName": ["The Project Skin", "Project Skin India"],
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{% if request.page_type == 'collection' and collection %}
{% liquid
  assign col_title = collection.title
  if col_title == 'Products' or col_title == blank or collection.handle == 'all'
    assign col_title = 'Targeted Acne Care & Barrier Formulations | Project Skin'
  endif
  assign col_desc = collection.description
  if col_desc == blank
    assign col_desc = 'Dermatologist-formulated acne care and barrier repair formulations engineered for Indian humidity, UV exposure, and acne-prone skin.'
  endif
%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ col_title | json }},
  "url": {{ canonical_url | json }},
  "description": {{ col_desc | strip_html | truncate: 500 | json }},
  "isPartOf": {
    "@type": "WebSite",
    "@id": "{{ shop.url }}/#website"
  },
  "about": {
    "@type": "Thing",
    "name": "Dermatological Acne Skincare & Barrier Repair for Indian Skin"
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count | default: collection.products.size }},
    "itemListElement": [
      {% for item in collection.products limit: 12 %}
        {% liquid
          assign item_brand = item.vendor
          if item_brand == blank or item_brand == 'My Store'
            assign item_brand = 'Project Skin'
          endif

          assign item_rating = 5.0
          assign item_count = 1

          case item.handle
            when '5-niacinamide-serum-acne-prone-skin'
              assign item_rating = 5.0
              assign item_count = 2
            when 'calming-moisturiser-acne-prone-skin'
              assign item_rating = 5.0
              assign item_count = 2
            when 'refreshing-cleanser-acne-prone-skin'
              assign item_rating = 5.0
              assign item_count = 2
            when 'clear-seal'
              assign item_rating = 5.0
              assign item_count = 1
            when 'protecting-sunscreen-acne-prone-skin'
              assign item_rating = 5.0
              assign item_count = 1
            when 'active-boba-encapsulated-cream-acne-prone-skin'
              assign item_rating = 5.0
              assign item_count = 1
            when 'project-skin-complete-4-step-skincare-routine-kit'
              assign item_rating = 4.9
              assign item_count = 9
          endcase

          if item.metafields.judgeme.all_reviews_count != blank
            assign jm_cnt = item.metafields.judgeme.all_reviews_count | plus: 0
            if jm_cnt > 0
              assign item_count = jm_cnt
              assign item_rating = item.metafields.judgeme.all_reviews_rating | plus: 0.0
            endif
          endif
        %}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "item": {
            "@type": "Product",
            "name": {{ item.title | json }},
            "url": "{{ shop.url }}{{ item.url }}",
            {% if item.featured_image %}
              "image": {{ item.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
            {% endif %}
            "description": {{ item.description | default: item.title | strip_html | truncate: 300 | json }},
            "brand": {
              "@type": "Brand",
              "name": {{ item_brand | json }}
            },
            {% if item_count and item_count > 0 %}
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": {{ item_rating | round: 1 }},
              "reviewCount": {{ item_count | plus: 0 }},
              "bestRating": "5",
              "worstRating": "1"
            },
            {% endif %}
            "offers": {
              "@type": "Offer",
              "priceCurrency": "INR",
              "price": {{ item.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
              "availability": "https://schema.org/{% if item.available %}InStock{% else %}OutOfStock{% endif %}",
              "url": "{{ shop.url }}{{ item.url }}"
            }
          }
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
}
</script>
{% endif %}
{% if request.page_type == 'product' and product %}
{% liquid
  assign brand_name = product.vendor
  if brand_name == blank or brand_name == 'My Store'
    assign brand_name = 'Project Skin'
  endif
  assign jm_rating = product.metafields.judgeme.all_reviews_rating | default: product.metafields.reviews.rating.value
  assign jm_count = product.metafields.judgeme.all_reviews_count | default: product.metafields.reviews.rating_count.value
%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  "description": {{ product.description | strip_html | strip_newlines | truncate: 5000 | json }},
  "category": "Health & Beauty > Personal Care > Cosmetics > Skin Care",
  {% if product.images.size > 0 %}
  "image": [
    {% for img in product.images limit: 5 %}
      {{ img | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  {% elsif product.featured_image %}
  "image": [{{ product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }}],
  {% endif %}
  "brand": {"@type":"Brand","name":{{ brand_name | json }}},
  {% if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
  {% if product.selected_or_first_available_variant.barcode != blank %}"gtin": {{ product.selected_or_first_available_variant.barcode | json }},{% endif %}
  {% if jm_count and jm_count > 0 and jm_rating and jm_rating > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ jm_rating | json }},
    "reviewCount": {{ jm_count | json }}
  },
  {% endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | default: 'INR' | json }},
    "price": {{ product.selected_or_first_available_variant.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition",
    "areaServed": "IN",
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "IN"
      },
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0",
        "currency": "INR"
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "IN",
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": 30,
      "returnMethod": "https://schema.org/ReturnByMail",
      "returnFees": "https://schema.org/FreeReturn"
    }
  }
}
</script>
{% endif %}

{% if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {% if request.page_type == 'product' and product %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    {% elsif request.page_type == 'collection' and collection %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {% if collection.handle == 'all' or collection.title == 'Products' or collection.title == blank %}"All Formulations"{% else %}{{ collection.title | json }}{% endif %},
        "item": {{ canonical_url | json }}
      }
    {% elsif request.page_type == 'page' and page %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ page.title | json }},
        "item": {{ canonical_url | json }}
      }
    {% endif %}
  ]
}
</script>
{% endif %}
