    {
      "@type": "SiteNavigationElement",
      "position": 3,
      "name": "Protecting Sunscreen SPF 50",
      "description": "Broad-spectrum photoprotection engineered for Indian UV and humidity",
      "url": "{{ shop.url }}/products/protecting-sunscreen-acne-prone-skin"
    },
    {
      "@type": "SiteNavigationElement",
      "position": 4,
