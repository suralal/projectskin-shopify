<section class="pdp-section pdp-ingredient-trio" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="page-width-pdp"><header class="pdp-section-head"><p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="pdp-section-copy">{{ section.settings.copy }}</div></header><div class="pdp-ingredient-trio__grid">
    {% for block in section.blocks %}{% liquid
      assign fallback = 'pdp-candelilla.jpg'
      if forloop.index == 2
        assign fallback = 'pdp-vitamin-e.jpg'
      elsif forloop.index == 3
        assign fallback = 'pdp-botanical-oils.jpg'
      endif
    %}<article class="pdp-ingredient" {{ block.shopify_attributes }}><div class="pdp-ingredient__media">{% render 'purity-image', image: block.settings.image, fallback_asset: fallback, fallback_width: 600, fallback_height: 600, alt: block.settings.heading, sizes: '(min-width: 750px) 240px, 62vw' %}</div><h3>{{ block.settings.heading }}</h3><div>{{ block.settings.copy }}</div></article>{% endfor %}
  </div></div>
</section>
{% schema %}
{"name":"PDP ingredients","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Glow Ingredients"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Nourished from Within"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Powered by skin-loving ingredients that enhance color, comfort, and a naturally radiant makeup finish.</p>"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":68},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":76}],"blocks":[{"type":"ingredient","name":"Ingredient","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Candelilla Wax"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>A vegan plant wax that creates a smooth, flexible texture for a lightweight, comfortable makeup finish.</p>"}]}],"max_blocks":6,"presets":[{"name":"PDP ingredients","blocks":[{"type":"ingredient"},{"type":"ingredient"},{"type":"ingredient"}]}]}
{% endschema %}
