<section class="section routine-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}<div class="routine-grid" data-mobile-scroll>{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="routine-card"><div class="routine-card__step">Step {{ forloop.index }}</div>{% if block.settings.image %}<div class="routine-card__media">{{ block.settings.image | image_url: width:900 | image_tag:loading:'lazy' }}</div>{% endif %}<div class="routine-card__body"><h3>{{ block.settings.heading }}</h3><div class="muted">{{ block.settings.text }}</div></div></article>{% endfor %}{% else %}{% for product in collections['all'].products limit:4 %}<article class="routine-card"><div class="routine-card__step">Step {{ forloop.index }}</div>{% if product.featured_image %}<a class="routine-card__media" href="{{ product.url }}">{{ product.featured_image | image_url: width:900 | image_tag:loading:'lazy' }}</a>{% endif %}<div class="routine-card__body"><h3>{{ product.title }}</h3><a class="text-link" href="{{ product.url }}">Shop this step →</a></div></article>{% endfor %}{% endif %}</div></div></section>
{% schema %}{"name":"Shop by step","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading","default":"Skincare made simple"},{"type":"text","id":"heading","label":"Heading","default":"Build Your Routine"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":72,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":72,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Shop by step"}],"blocks":[{"type":"item","name":"Routine step","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Cleanse"},{"type":"richtext","id":"text","label":"Text"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":6}{% endschema %}