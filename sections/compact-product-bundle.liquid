<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}">
  <div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">
    {% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}
    <div class="grid grid-4 product-grid-home">
      {% if section.blocks.size > 0 %}{% for block in section.blocks %}{% if block.settings.product %}{% render 'product-card', product:block.settings.product %}{% endif %}{% endfor %}
      {% else %}{% for product in collections['all'].products limit:4 %}{% render 'product-card', product:product %}{% endfor %}{% endif %}
    </div>
    {% if section.settings.show_cta %}
      <p class="compact-bundle__cta"><a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | default: 'Build your bundle' }}</a></p>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Compact product bundle","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"checkbox","id":"show_cta","label":"Show bottom CTA","default":true},{"type":"text","id":"cta_label","label":"CTA label","default":"Build your bundle"},{"type":"url","id":"cta_link","label":"CTA link"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Compact product bundle"}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"max_blocks":20}{% endschema %}
