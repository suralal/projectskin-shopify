{% liquid
  assign show_section = true
  assign handle_list = section.settings.product_handles | strip | downcase
  if handle_list != blank
    assign show_section = false
    if handle_list contains product.handle
      assign show_section = true
    endif
  endif

  assign ps_steps_eyebrow = section.settings.eyebrow
  assign ps_steps_heading = section.settings.heading
  assign ps_steps_intro = section.settings.intro
  assign catalog_steps = ''
  assign use_catalog = false

  if section.settings.use_formula_catalog
    capture catalog_steps
      include 'product-steps-catalog'
    endcapture
    assign catalog_steps = catalog_steps | strip
    if catalog_steps != blank
      assign use_catalog = true
    endif
  endif

  if catalog_steps == blank and section.blocks.size == 0
    assign show_section = false
  endif

  assign cleanser_product = all_products['refreshing-cleanser-acne-prone-skin']
  assign serum_product = all_products['5-niacinamide-serum-acne-prone-skin']
  assign moisturiser_product = all_products['calming-moisturiser-acne-prone-skin']
  assign sunscreen_product = all_products['protecting-sunscreen-acne-prone-skin']

  if use_catalog
    assign steps_count = 3
  else
    assign steps_count = section.blocks.size
  endif
%}
{% if show_section %}
<section class="pdp-section pdp-steps{% if steps_count > 3 %} pdp-steps--four{% endif %}" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="page-width-pdp">
    <header class="pdp-section-head">
      <p class="pdp-eyebrow">{% if use_catalog and ps_steps_eyebrow != blank %}{{ ps_steps_eyebrow }}{% else %}{{ section.settings.eyebrow }}{% endif %}</p>
      <h2>{% if use_catalog and ps_steps_heading != blank %}{{ ps_steps_heading }}{% else %}{{ section.settings.heading }}{% endif %}</h2>
      {% if use_catalog and ps_steps_intro != blank %}
        <p class="pdp-steps__intro">{{ ps_steps_intro }}</p>
      {% elsif section.settings.intro != blank %}
        <p class="pdp-steps__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </header>
    <div class="pdp-steps__grid">
      {% if use_catalog %}
        {{ catalog_steps }}
      {% else %}
        {% for block in section.blocks %}
          {% liquid
            assign step_image = block.settings.image
            assign fallback = blank
            assign fallback_w = 819
            assign fallback_h = 1024

            if step_image == blank
              assign use_curated_assets = false
              if product.handle == 'project-skin-complete-4-step-skincare-routine-kit'
                assign use_curated_assets = true
              endif

              case forloop.index
                when 1
                  if use_curated_assets
                    assign fallback = 'product-cleanser-1.png'
                  elsif cleanser_product != blank and cleanser_product.featured_image != blank
                    assign step_image = cleanser_product.featured_image
                  else
                    assign fallback = 'product-cleanser-1.png'
                  endif
                when 2
                  if use_curated_assets
                    assign fallback = 'product-serum-1.png'
                  elsif serum_product != blank and serum_product.featured_image != blank
                    assign step_image = serum_product.featured_image
                  else
                    assign fallback = 'product-serum-1.png'
                  endif
                when 3
                  if use_curated_assets
                    assign fallback = 'product-moisturiser-1.png'
                  elsif moisturiser_product != blank and moisturiser_product.featured_image != blank
                    assign step_image = moisturiser_product.featured_image
                  else
                    assign fallback = 'product-moisturiser-1.png'
                  endif
                when 4
                  if use_curated_assets
                    assign fallback = 'product-sunscreen-1.png'
                  elsif sunscreen_product != blank and sunscreen_product.featured_image != blank
                    assign step_image = sunscreen_product.featured_image
                  else
                    assign fallback = 'product-sunscreen-1.png'
                  endif
                else
                  assign fallback = 'product-serum-1.png'
              endcase
            endif
          %}
          <article class="pdp-step" style="--step-tint: #efeae2" {{ block.shopify_attributes }}>
            <div class="pdp-step__media">
              <span class="pdp-step__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {% render 'purity-image', image: step_image, fallback_asset: fallback, fallback_width: fallback_w, fallback_height: fallback_h, alt: block.settings.heading, sizes: '(min-width: 990px) 22vw, (min-width: 750px) 31vw, 92vw' %}
            </div>
            <h3>{{ block.settings.heading }}</h3>
            <div>{{ block.settings.copy }}</div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "PDP use steps",
  "settings": [
    { "type": "text", "id": "product_handles", "label": "Only show for product handles", "info": "Comma-separated handles. Leave blank to show on all products." },
    { "type": "checkbox", "id": "use_formula_catalog", "label": "Use built-in how-to catalog", "default": true, "info": "Pulls product-specific steps from the formula catalog. Turn off to use theme editor blocks (e.g. kit)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How to Use" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Three steps to a clearer routine" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Amount, order, and timing — so the formula can do what it is built for." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 76 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "01. Cleanse" },
        { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Start with a gentle cleanser so the serum can absorb evenly.</p>" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "PDP use steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
