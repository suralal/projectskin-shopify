<section class="ps-section ps-review-band" style="--ps-pad-top: {{ section.settings.padding_top }}px; --ps-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="ps-wrap">
    {% render 'purity-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, copy: section.settings.description, alignment: 'center' %}
    <div class="ps-review-rail">
      {% for block in section.blocks %}
        {% liquid
          assign fallback_asset = 'review-1.jpg'
          case forloop.index
            when 2
              assign fallback_asset = 'review-2.jpg'
            when 3
              assign fallback_asset = 'review-3.jpg'
            when 4
              assign fallback_asset = 'review-4.jpg'
          endcase
        %}
        <article class="ps-review-card" {{ block.shopify_attributes }}>
          <div class="ps-review-card__image">{% render 'purity-image', image: block.settings.image, fallback_asset: fallback_asset, fallback_width: 900, fallback_height: 670, alt: block.settings.heading, sizes: '320px' %}</div>
          <div class="ps-review-card__copy">
            <div class="ps-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">★★★★★</div>
            <h3>{{ block.settings.heading }}</h3>
            <div class="rte">{{ block.settings.quote }}</div>
            {% if block.settings.author != blank %}<small>{{ block.settings.author }} · Verified buyer</small>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer results",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What customers see" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Results You Can See" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }, { "type": "text", "id": "heading", "label": "Heading", "default": "Softer, calmer skin" }, { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>My skin feels balanced and looks visibly brighter.</p>" }, { "type": "text", "id": "author", "label": "Author", "default": "Maya R." }] }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Customer results", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
