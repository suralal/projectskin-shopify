<section class="section"><div class="container">{% render 'section-head', heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}<div class="grid grid-3">{% for block in section.blocks %}{% if block.settings.product %}{% render 'product-card', product:block.settings.product %}{% endif %}{% endfor %}</div></div></section>{% schema %}{"name":"Compare related product","settings":[{"type":"text","id":"heading","label":"Heading","default":"Compare products"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Compare related product"}]}{% endschema %}