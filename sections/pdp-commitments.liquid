<section class="pdp-section pdp-commitments" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"><div class="page-width-pdp"><header class="pdp-section-head"><p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="pdp-section-copy">{{ section.settings.copy }}</div></header><div class="pdp-commitments__grid">{% for block in section.blocks %}{% assign fallback = 'pdp-leaf.svg' %}{% if forloop.index == 2 %}{% assign fallback = 'pdp-package.svg' %}{% elsif forloop.index == 3 %}{% assign fallback = 'pdp-transparency.svg' %}{% endif %}<article {{ block.shopify_attributes }}><div class="pdp-commitment__icon">{% render 'purity-image', image: block.settings.icon, fallback_asset: fallback, fallback_width: 80, fallback_height: 80, alt: block.settings.heading, sizes: '72px' %}</div><h3>{{ block.settings.heading }}</h3><div>{{ block.settings.copy }}</div></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"PDP commitments","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Commitments"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Beauty that Lasts"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Better ingredients, refillable design, and full transparency for beauty that lasts.</p>"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":88}],"blocks":[{"type":"commitment","name":"Commitment","settings":[{"type":"image_picker","id":"icon","label":"Icon"},{"type":"text","id":"heading","label":"Heading","default":"Ingredients"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Mineral pigments and cold-pressed botanical oils, ethically sourced and traceable.</p>"}]}],"max_blocks":6,"presets":[{"name":"PDP commitments","blocks":[{"type":"commitment"},{"type":"commitment"},{"type":"commitment"}]}]}
{% endschema %}
