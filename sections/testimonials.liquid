<section class="section testimonials-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}<div class="review-carousel" data-mobile-scroll>{% for block in section.blocks %}<blockquote class="review-card" {{ block.shopify_attributes }}>{% if block.settings.image %}<div class="review-card__media">{{ block.settings.image | image_url: width:700 | image_tag:loading:'lazy', widths:'320,480,700' }}</div>{% endif %}<div class="review-card__body"><div class="review-card__stars" aria-label="5 out of 5">★★★★★</div><div class="review-card__quote">{{ block.settings.quote }}</div><footer><strong>{{ block.settings.author }}</strong>{% if block.settings.verified %}<span>Verified Customer</span>{% endif %}</footer></div></blockquote>{% endfor %}</div></div></section>
{% schema %}{"name":"Testimonials","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading","default":"Loved by customers"},{"type":"text","id":"heading","label":"Heading","default":"Results You Can See"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":72,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":72,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Testimonials"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"richtext","id":"quote","label":"Quote","default":"<p>My skin feels smoother, calmer and more balanced.</p>"},{"type":"text","id":"author","label":"Author","default":"Customer"},{"type":"checkbox","id":"verified","label":"Show verified customer","default":true}]}],"max_blocks":12}{% endschema %}