<section class="ps-template ps-collection-list">
  <div class="container">
    <div class="ps-template__head">
      {% if section.settings.subheading != blank %}<span class="ps-eyebrow">{{ section.settings.subheading }}</span>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
    </div>

    <div class="ps-collection-list__grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign selected_collection = block.settings.collection %}
          {% if selected_collection != blank %}
            <a class="ps-collection-list__card" href="{{ selected_collection.url }}" {{ block.shopify_attributes }}>
              <div>
                {% assign image = block.settings.image | default: selected_collection.featured_image %}
                {% if image %}{{ image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360,700,1100', sizes: '(max-width: 749px) 100vw, 33vw' }}{% endif %}
              </div>
              <span><strong>{{ selected_collection.title }}</strong><small>{{ selected_collection.products_count }} products</small></span>
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for selected_collection in collections %}
          <a class="ps-collection-list__card" href="{{ selected_collection.url }}">
            <div>
              {% if selected_collection.featured_image %}{{ selected_collection.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360,700,1100', sizes: '(max-width: 749px) 100vw, 33vw' }}{% endif %}
            </div>
            <span><strong>{{ selected_collection.title }}</strong><small>{{ selected_collection.products_count }} products</small></span>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list page",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Explore Purity" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Browse thoughtful edits for every step of your ritual.</p>" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" }
      ]
    }
  ],
  "max_blocks": 20
}
{% endschema %}
