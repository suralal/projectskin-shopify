<section id="science-system" class="psr-route-fallback psr-route-fallback--science psr-page psr-sci-system">
  <div class="container">
    <header class="psr-phil-head">
      <p class="psr-phil-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="psr-phil-head__copy">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="psr-sci-system__track" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign fallback = 'psr-science-step-observe.jpg'
          if forloop.index == 2
            assign fallback = 'psr-science-mission-scan.jpg'
          elsif forloop.index == 3
            assign fallback = 'psr-science-step-match.jpg'
          elsif forloop.index == 4
            assign fallback = 'psr-science-step-progress.jpg'
          endif
        %}
        <article class="psr-sci-system__card" role="listitem" {{ block.shopify_attributes }}>
          <div class="psr-sci-system__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 22vw, 70vw', alt: block.settings.heading }}
            {% else %}
              <img src="{{ fallback | asset_url }}" width="720" height="960" loading="lazy" alt="{{ block.settings.heading | escape }}">
            {% endif %}
          </div>
          <p class="psr-sci-system__step">0{{ forloop.index }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science system flow",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How the system thinks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four connected decisions" },
    { "type": "textarea", "id": "text", "label": "Introduction", "default": "Each layer adds context. Together they turn a one-time recommendation into a more useful skincare system." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "System step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Observe" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A guided image and concern check-in organize visible skin signals into a useful starting point." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science system flow",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
