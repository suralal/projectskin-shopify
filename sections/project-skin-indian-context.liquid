<section class="psr-route-fallback psr-route-fallback--philosophy psr-page psr-section psr-section--linen psr-indian-context">
  <div class="container psr-indian-context__grid">
    <div class="psr-indian-context__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 46vw, 100vw', alt: section.settings.image_alt }}
      {% else %}
        <img src="{{ 'project-skin-philosophy-people.jpg' | asset_url }}" width="1128" height="1410" loading="lazy" alt="Real Indian skin across different ages and genders">
      {% endif %}
    </div>
    <div class="psr-indian-context__content">
      <span class="psr-kicker">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      <div class="psr-context-signals">
        {% for block in section.blocks %}
          <div class="psr-context-signal" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.heading }}</strong>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Indian skin context",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Built around Indian skin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One country. Many skin environments." },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Indian skin moves through intense UV, humidity, pollution, hard water and dry winters, often within the same year. We design for that changing context instead of treating it as an afterthought.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alternative text", "default": "Indian skin in its natural texture" }
  ],
  "blocks": [
    {
      "type": "signal",
      "name": "Context signal",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Climate" },
        { "type": "text", "id": "text", "label": "Description", "default": "Heat, humidity and seasonal dryness" }
      ]
    }
  ],
  "presets": [{ "name": "Indian skin context", "blocks": [{ "type": "signal" }, { "type": "signal" }, { "type": "signal" }, { "type": "signal" }] }]
}
{% endschema %}
