<section class="psr-route-fallback psr-route-fallback--science psr-page psr-section psr-section--linen psr-concern-index">
  <div class="container">
    <div class="psr-section__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="psr-kicker">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="psr-concern-index__grid">
      {% for block in section.blocks %}
        <a class="psr-concern-index__card" href="{{ block.settings.link | default: '/pages/acne' }}" {{ block.shopify_attributes }}>
          <span class="psr-kicker">{{ block.settings.eyebrow }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
          <span class="psr-concern-index__go">{{ block.settings.link_label | default: 'Read the concern' }} <span aria-hidden="true">↗</span></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Concern index",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by concern — literacy first" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Understand the biology. Then choose the formula." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Each concern page diagnoses first, explains the mechanism, names the actives, then shows the products." }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Concern" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Acne" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Congestion, oil, and barrier stress — not a cleanliness problem." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the concern" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Concern index",
      "blocks": [
        { "type": "concern", "settings": { "eyebrow": "Concern", "heading": "Acne", "text": "Congestion, oil, and barrier stress — not a cleanliness problem.", "link": "/pages/acne" } },
        { "type": "concern", "settings": { "eyebrow": "Concern", "heading": "Pigmentation", "text": "Melanin memory after inflammation and UV — not a scrub problem.", "link": "/pages/pigmentation" } },
        { "type": "concern", "settings": { "eyebrow": "Concern", "heading": "Barrier", "text": "When cream fails, the lipid layer is usually the real issue.", "link": "/pages/barrier" } },
        { "type": "concern", "settings": { "eyebrow": "Concern", "heading": "Daily SPF", "text": "In India, photoprotection is structural — not seasonal.", "link": "/pages/daily-spf" } }
      ]
    }
  ]
}
{% endschema %}
