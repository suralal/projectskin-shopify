<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}"><div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">{% assign p=section.settings.product %}{% if p %}<div class="grid grid-2 mobile-1"><div>{% if p.featured_image %}{{ p.featured_image | image_url:width:1200 | image_tag }}{% endif %}</div><div><div class="eyebrow">{{ p.vendor }}</div><h2>{{ p.title }}</h2><div class="price">{{ p.price | money }}</div><div>{{ p.description | truncatewords:40 }}</div>{% form 'product', p %}<input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><button class="btn" type="submit">Add to cart</button>{% endform %}</div></div>{% endif %}</div></section>
{% schema %}{"name":"Featured product","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false},{"type":"product","id":"product","label":"Product"}],"presets":[{"name":"Featured product"}]}{% endschema %}