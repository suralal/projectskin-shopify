<section class="section real-life-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}<div class="grid grid-3 real-life-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="real-life-card">{% if block.settings.image %}{{ block.settings.image | image_url: width:900 | image_tag:loading:'lazy' }}{% endif %}<h3>{{ block.settings.heading }}</h3></article>{% endfor %}{% else %}{% for product in collections['all'].products offset:1 limit:3 %}<a class="real-life-card" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width:900 | image_tag:loading:'lazy' }}{% endif %}<h3>{{ product.title }}</h3></a>{% endfor %}{% endif %}</div></div></section>
{% schema %}{"name":"Gallery image","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Gallery image"}],"blocks":[{"type":"item","name":"Item","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":20}{% endschema %}