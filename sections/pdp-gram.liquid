<section class="pdp-section pdp-gram" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px">
  <header class="pdp-section-head"><p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="pdp-section-copy">{{ section.settings.copy }}</div></header>
  <div class="pdp-gram__rail">
    {% for block in section.blocks %}
      {% assign fallback = 'gallery-' | append: forloop.index | append: '.jpg' %}
      {% if forloop.index > 4 %}{% assign fallback = 'pdp-gram-' | append: forloop.index | append: '.jpg' %}{% endif %}
      <a href="{{ block.settings.link | default: section.settings.instagram_link | default: '#' }}" {{ block.shopify_attributes }}>{% render 'purity-image', image: block.settings.image, fallback_asset: fallback, fallback_width: 650, fallback_height: 650, alt: block.settings.alt, sizes: '(min-width: 900px) 16.7vw, 72vw' %}<span aria-hidden="true">◎</span></a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"PDP social gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"@purity_store"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Purity On Gram"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Explore our gentle beauty highlights - trusted by over 15k fans.</p>"},{"type":"url","id":"instagram_link","label":"Instagram link"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":72}],"blocks":[{"type":"image","name":"Gallery image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Alt text","default":"Purity beauty highlight"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":10,"presets":[{"name":"PDP social gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}
