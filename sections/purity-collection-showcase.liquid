<section class="ps-section ps-collections" style="--ps-pad-top: {{ section.settings.padding_top }}px; --ps-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="ps-wrap ps-collections__layout">
    <a class="ps-collection-card" href="{{ section.settings.card_1_link | default: routes.all_products_collection_url }}">
      {% render 'purity-image', image: section.settings.card_1_image, fallback_asset: 'highlight-model.jpg', fallback_width: 900, fallback_height: 1400, alt: section.settings.card_1_title, sizes: '(min-width: 990px) 360px, 50vw' %}
      <span>{{ section.settings.card_1_title }} <sup>{{ section.settings.card_1_count }}</sup></span>
    </a>
    <a class="ps-collection-card" href="{{ section.settings.card_2_link | default: routes.all_products_collection_url }}">
      {% render 'purity-image', image: section.settings.card_2_image, fallback_asset: 'highlight-texture.jpg', fallback_width: 900, fallback_height: 1400, alt: section.settings.card_2_title, sizes: '(min-width: 990px) 360px, 50vw' %}
      <span>{{ section.settings.card_2_title }} <sup>{{ section.settings.card_2_count }}</sup></span>
    </a>
    <div class="ps-collections__copy">
      {% render 'purity-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, copy: section.settings.description, alignment: 'left', underline: section.settings.underline, underline_style: section.settings.underline_style %}
      <nav aria-label="Explore collections">
        {% for block in section.blocks %}
          <a class="ps-collection-link" href="{{ block.settings.collection.url | default: block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><span>{{ block.settings.title | default: block.settings.collection.title }} <sup>{{ block.settings.count }}</sup></span><i aria-hidden="true">›</i></a>
        {% endfor %}
      </nav>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection showcase",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "card_1_image", "label": "First card image" },
    { "type": "text", "id": "card_1_title", "label": "First card title", "default": "Skin Care" },
    { "type": "text", "id": "card_1_count", "label": "First card count", "default": "31" },
    { "type": "url", "id": "card_1_link", "label": "First card link" },
    { "type": "image_picker", "id": "card_2_image", "label": "Second card image" },
    { "type": "text", "id": "card_2_title", "label": "Second card title", "default": "Make Up" },
    { "type": "text", "id": "card_2_count", "label": "Second card count", "default": "33" },
    { "type": "url", "id": "card_2_link", "label": "Second card link" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore collections" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Made for Your Glow" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "checkbox", "id": "underline", "label": "Show animated underline", "default": true },
    { "type": "select", "id": "underline_style", "label": "Underline style", "default": "curve", "options": [{ "value": "simple", "label": "Simple" }, { "value": "curve", "label": "Curve" }, { "value": "squiggle", "label": "Squiggle" }] },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 52 }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "title", "label": "Title", "default": "Glow Sets" }, { "type": "text", "id": "count", "label": "Count", "default": "20" }, { "type": "url", "id": "link", "label": "Fallback link" }] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Collection showcase", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
