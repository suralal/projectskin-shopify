<section class="pdp-section pdp-philosophy" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"><div class="page-width-pdp pdp-philosophy__grid"><div class="pdp-philosophy__copy"><p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.copy }}</div><a class="pdp-pill-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a></div><div class="pdp-philosophy__media">{% render 'purity-image', image: section.settings.image, fallback_asset: 'pdp-philosophy.jpg', fallback_width: 1044, fallback_height: 825, alt: section.settings.heading, sizes: '(min-width: 750px) 56vw, 94vw' %}</div></div></section>
{% schema %}
{"name":"PDP philosophy","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Philosophy"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Beautiful Color, Gentle Care"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Ava Collins began with a simple question: why should lasting color compromise comfort? We craft each formula with mineral pigments and botanical oils, sharing every ingredient and its origin.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Discover Our Story"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":72}],"presets":[{"name":"PDP philosophy"}]}
{% endschema %}
