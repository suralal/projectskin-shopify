  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Modal Open/Close Logic
      const quickViewBtns = document.querySelectorAll('.quick-view-btn');
      const modals = document.querySelectorAll('[id^="QuickViewModal-"]');
      
      quickViewBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-target');
          const modal = document.getElementById(targetId);
          if(modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
              const overlay = modal.querySelector('.modal-overlay');
              const content = modal.querySelector('.modal-content');
              if(overlay) overlay.classList.add('opacity-100');
              if(content) {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
              }
            }, 10);
            document.body.style.overflow = 'hidden';
          }
        });
      });

      const closeModals = () => {
        modals.forEach(modal => {
          const overlay = modal.querySelector('.modal-overlay');
          const content = modal.querySelector('.modal-content');
          if(overlay) overlay.classList.remove('opacity-100');
          if(content) {
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
          }
          setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        });
      };

      modals.forEach(modal => {
        const closeBtn = modal.querySelector('.close-modal');
        const overlay = modal.querySelector('.modal-overlay');
        if(closeBtn) closeBtn.addEventListener('click', closeModals);
        if(overlay) overlay.addEventListener('click', closeModals);
      });

      // Variant Selection Logic
      const variantBtns = document.querySelectorAll('.variant-btn');
      const primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--color-primary').trim() || '#E83A7E';

      variantBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const container = this.closest('.modal-content');
          const siblingBtns = this.parentElement.querySelectorAll('.variant-btn');
          
          // Reset styling
          siblingBtns.forEach(b => {
            b.classList.remove('ring-1');
            b.classList.add('border-gray-200');
            b.style.borderColor = '';
            b.style.removeProperty('--tw-ring-color');
            const t = b.querySelector('.option-title');
            if(t) { t.style.color = '#181818'; }
          });
          
          // Apply active styling
          this.classList.remove('border-gray-200');
          this.classList.add('ring-1');
          this.style.borderColor = primaryColor;
          this.style.setProperty('--tw-ring-color', primaryColor);
          const activeT = this.querySelector('.option-title');
          if(activeT) { activeT.style.color = primaryColor; }
          
          // Update Hidden Input
          const variantId = this.getAttribute('data-variant-id');
          const idInput = container.querySelector('.variant-id-input');
          if(idInput) idInput.value = variantId;
          
          // Update Prices
          const price = this.getAttribute('data-price');
          const compare = this.getAttribute('data-compare');
          const currentPriceEl = container.querySelector('.current-price');
          const comparePriceEl = container.querySelector('.compare-price');
          const discountBadgeEl = container.querySelector('.discount-badge');
          
          if(currentPriceEl) currentPriceEl.innerHTML = price;
          
          if(compare && compare !== '' && parseFloat(compare.replace(/[^0-9.-]+/g,"")) > parseFloat(price.replace(/[^0-9.-]+/g,""))) {
            if(comparePriceEl) {
              comparePriceEl.innerHTML = compare;
              comparePriceEl.style.display = 'inline';
            }
            if(discountBadgeEl) {
               const pVal = parseFloat(price.replace(/[^0-9.]/g,""));
               const cVal = parseFloat(compare.replace(/[^0-9.]/g,""));
               const disc = Math.round(((cVal - pVal) / cVal) * 100);
               discountBadgeEl.innerHTML = disc + '% OFF';
               discountBadgeEl.style.display = 'inline';
            }
          } else {
            if(comparePriceEl) comparePriceEl.style.display = 'none';
            if(discountBadgeEl) discountBadgeEl.style.display = 'none';
          }
          
          // Update Inventory
          const invQty = parseInt(this.getAttribute('data-inventory'));
          const invPolicy = this.getAttribute('data-inventory-policy');
          const invCountEl = container.querySelector('.inventory-count');
          const addToCartBtn = container.querySelector('.add-to-cart-btn');
          const qtyInput = container.querySelector('.qty-input');
          const qtyPlusBtn = container.querySelector('.qty-plus');
          
          const qtyMinusBtn = container.querySelector('.qty-minus');
          
          if(qtyInput) {
            qtyInput.value = 1;
            if (qtyMinusBtn) {
              qtyMinusBtn.disabled = true;
              qtyMinusBtn.style.opacity = '0.5';
              qtyMinusBtn.style.cursor = 'not-allowed';
            }
            if (invPolicy === 'deny' && invQty > 0) {
              qtyInput.setAttribute('max', invQty);
              if (invQty <= 1 && qtyPlusBtn) {
                qtyPlusBtn.disabled = true;
                qtyPlusBtn.style.opacity = '0.5';
                qtyPlusBtn.style.cursor = 'not-allowed';
              } else if (qtyPlusBtn) {
                qtyPlusBtn.disabled = false;
                qtyPlusBtn.style.opacity = '1';
                qtyPlusBtn.style.cursor = 'pointer';
              }
            } else {
              qtyInput.removeAttribute('max');
              if (qtyPlusBtn) {
                qtyPlusBtn.disabled = false;
                qtyPlusBtn.style.opacity = '1';
                qtyPlusBtn.style.cursor = 'pointer';
              }
            }
          }
          
          if(invQty > 0) {
            if(invCountEl) invCountEl.innerHTML = invQty;
            if(addToCartBtn) {
              addToCartBtn.disabled = false;
              const span = addToCartBtn.querySelector('span');
              if(span) {
                span.innerHTML = `
                  Add to cart 
                  <img src="{{ 'product_card_cart_Icon.svg' | asset_url }}" alt="Cart" class="ml-2 w-5 h-5 object-contain">
                `;
              }
            }
          } else if (invPolicy === 'continue') {
            if(invCountEl) invCountEl.innerHTML = '';
            if(addToCartBtn) {
               addToCartBtn.disabled = false;
               const span = addToCartBtn.querySelector('span');
               if(span) {
                 span.innerHTML = `
                  Add to cart 
                  <img src="{{ 'product_card_cart_Icon.svg' | asset_url }}" alt="Cart" class="ml-2 w-5 h-5 object-contain">
                 `;
               }
            }
          } else {
            if(invCountEl) invCountEl.innerHTML = '0';
            if(addToCartBtn) {
              addToCartBtn.disabled = true;
              const span = addToCartBtn.querySelector('span');
              if(span) span.innerHTML = 'Sold out';
            }
          }
        });
      });
      
      // Quantity Logic
      const minusBtns = document.querySelectorAll('.qty-minus');
      const plusBtns = document.querySelectorAll('.qty-plus');
      
      minusBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const input = this.nextElementSibling;
          let val = parseInt(input.value);
          if(val > 1) {
            input.value = val - 1;
          }
          if (parseInt(input.value) <= 1) {
            this.disabled = true;
            this.style.opacity = '0.5';
            this.style.cursor = 'not-allowed';
          }
          const plusBtn = this.parentElement.querySelector('.qty-plus');
          const max = parseInt(input.getAttribute('max'));
          if (!isNaN(max) && parseInt(input.value) < max) {
            plusBtn.disabled = false;
            plusBtn.style.opacity = '1';
            plusBtn.style.cursor = 'pointer';
          }
        });
      });
      
      plusBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const input = this.previousElementSibling;
          let val = parseInt(input.value);
          const max = parseInt(input.getAttribute('max'));
          if (!isNaN(max) && val >= max) return;
          
          input.value = val + 1;
          
          const minusBtn = this.parentElement.querySelector('.qty-minus');
          if (parseInt(input.value) > 1) {
            minusBtn.disabled = false;
            minusBtn.style.opacity = '1';
            minusBtn.style.cursor = 'pointer';
          }
          
          if (!isNaN(max) && parseInt(input.value) >= max) {
            this.disabled = true;
            this.style.opacity = '0.5';
            this.style.cursor = 'not-allowed';
          }
        });
      });
      
      // Buy Now Logic
      const buyNowBtns = document.querySelectorAll('.buy-now-btn');
      buyNowBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const form = this.closest('form');
          const formData = new FormData(form);
          
          const spinner = this.querySelector('.loading__spinner');
          
          this.classList.add('loading');
          if(spinner) spinner.classList.remove('hidden');
          this.disabled = true;
          
          fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          })
          .then(response => response.json())
          .then(data => {
            setTimeout(() => {
              

              handleFloCheckoutBtn();
              this.classList.remove('loading');
              if(spinner) spinner.classList.add('hidden');
              this.disabled = false;
            }, 500);
          })
          .catch(error => {
            console.error('Error adding to cart:', error);
            this.classList.remove('loading');
            if(spinner) spinner.classList.add('hidden');
            this.disabled = false;
          });
        });
      });
    });
  </script>

