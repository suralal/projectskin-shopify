<section class="ps-template ps-blog-page">
  <div class="container">
    <div class="ps-template__head">
      <span class="ps-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ blog.title }}</h1>
      {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
    </div>

    {% paginate blog.articles by section.settings.articles_per_page %}
      <div class="ps-blog-grid">
        {% for article in blog.articles %}
          <article class="ps-blog-card{% if forloop.first and section.settings.feature_first %} ps-blog-card--featured{% endif %}">
            <a class="ps-blog-card__media" href="{{ article.url }}">
              {% if article.image %}
                {{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', sizes: '(max-width: 749px) 100vw, 50vw' }}
              {% endif %}
            </a>
            <div class="ps-blog-card__copy">
              {% if section.settings.show_date %}<span class="ps-eyebrow">{{ article.published_at | date: format: 'date' }}</span>{% endif %}
              <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
              <a class="ps-text-button" href="{{ article.url }}">Read story</a>
            </div>
          </article>
        {% else %}
          <div class="ps-search-empty ps-blog-empty">
            <h2>Stories are brewing</h2>
            <p>While new journal posts publish, start with seasonal education modules and literacy threads.</p>
            <div class="psr-journal-hub__actions" style="justify-content:flex-start;margin-top:20px">
              <a class="psr-button" href="/pages/journal">Open journal hub</a>
              <a class="psr-button psr-button--secondary" href="/pages/monsoon">Monsoon module</a>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Project Skin Journal" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Skin science, ingredient literacy, Indian climate, and seasonal care — written to inform before you buy.</p>" },
    { "type": "range", "id": "articles_per_page", "label": "Articles per page", "min": 4, "max": 20, "step": 2, "default": 10 },
    { "type": "checkbox", "id": "feature_first", "label": "Feature first article", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true }
  ]
}
{% endschema %}
