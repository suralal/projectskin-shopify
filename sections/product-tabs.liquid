<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}">
  <div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">
    {% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}
    {% if section.blocks.size > 0 %}
      <div data-tabs-root>
        <div class="tabs">{% for block in section.blocks %}<button class="tab-button {% if forloop.first %}active{% endif %}" data-tab="{{ block.id }}">{{ block.settings.title | default: block.settings.collection.title }}</button>{% endfor %}</div>
        {% for block in section.blocks %}<div data-panel="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}><div>{{ block.settings.description }}</div><div class="grid grid-4 product-grid-home">{% for product in block.settings.collection.products limit: 8 %}{% render 'product-card', product: product %}{% endfor %}</div></div>{% endfor %}
      </div>
    {% else %}
      <div class="tabs"><span class="tab-button active">Best sellers</span></div>
      <div class="grid grid-4 product-grid-home">{% for product in collections['all'].products limit: 8 %}{% render 'product-card', product: product %}{% else %}<p class="muted">Add products to your Shopify catalog to populate this section.</p>{% endfor %}</div>
    {% endif %}
  </div>
</section>
{% schema %}{"name":"Product tabs","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Product tabs"}],"blocks":[{"type":"tab","name":"Collection tab","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"title","label":"Title"},{"type":"richtext","id":"description","label":"Description"}]}],"max_blocks":20}{% endschema %}