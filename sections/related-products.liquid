<section
  class="pdp-section pdp-related page-width-pdp"
  style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"
>
  <header class="pdp-section-head{% if section.settings.alignment == 'center' %} pdp-section-head--center{% endif %}">
    {% if section.settings.subheading != blank %}
      <p class="pdp-eyebrow">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="rte">{{ section.settings.description }}</div>
    {% endif %}
  </header>

  {% liquid
    assign related_limit = section.settings.products_to_show | default: 4
    assign shown = 0
    assign used_collection = false
    assign related_collection = section.settings.collection
    if related_collection == blank and product != blank
      assign related_collection = product.collections.first
    endif
  %}

  <div class="psr-edu-products pdp-related__grid" style="--psr-columns: {{ section.settings.columns | default: 4 }};">
    {% if related_collection != blank and related_collection.products_count > 1 %}
      {% assign used_collection = true %}
      {% for related_product in related_collection.products %}
        {% if related_product.id != product.id %}
          {% render 'product-card', product: related_product %}
          {% assign shown = shown | plus: 1 %}
          {% if shown >= related_limit %}{% break %}{% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if shown == 0 %}
      {% capture handle_blob %}{% render 'product-related-handles', product: product %}{% endcapture %}
      {% assign handle_list = handle_blob | strip | split: ',' %}
      {% for handle in handle_list %}
        {% assign handle_clean = handle | strip %}
        {% if handle_clean != blank %}
          {% assign related_product = all_products[handle_clean] %}
          {% if related_product != blank and related_product.id != product.id %}
            {% render 'product-card', product: related_product %}
            {% assign shown = shown | plus: 1 %}
            {% if shown >= related_limit %}{% break %}{% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>

  {% if shown == 0 %}
    <p class="pdp-related__empty">Explore the full Project Skin sequence to build cleanse → treat → moisturise → protect.</p>
    <a class="psr-button" href="{{ routes.all_products_collection_url }}">Shop all formulas</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Build your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the routine" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Cleanse, treat, moisturise, protect — pair this product with the rest of your Project Skin steps.</p>" },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Optional. If blank, uses a Project Skin routine catalog for this product." },
    { "type": "range", "id": "products_to_show", "label": "Maximum items", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "default": 64, "unit": "px" }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
