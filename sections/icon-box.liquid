<section class="section trust-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}<div class="grid grid-3 trust-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="trust-card">{% if block.settings.image %}<div class="trust-card__media">{{ block.settings.image | image_url: width: 500 | image_tag: loading:'lazy' }}</div>{% endif %}<h3>{{ block.settings.heading }}</h3><div class="muted">{{ block.settings.text }}</div></article>{% endfor %}{% else %}<article class="trust-card"><span class="trust-icon">01</span><h3>Dermatologist guided</h3><p class="muted">Routine-first skincare built around thoughtful product selection.</p></article><article class="trust-card"><span class="trust-icon">02</span><h3>Skin-first formulas</h3><p class="muted">Focused care designed to support everyday skin needs.</p></article><article class="trust-card"><span class="trust-icon">03</span><h3>Simple routines</h3><p class="muted">Clear steps that make consistent skincare easier to follow.</p></article>{% endif %}</div></div></section>
{% schema %}{"name":"Icon box","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Icon box"}],"blocks":[{"type":"item","name":"Item","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":20}{% endschema %}