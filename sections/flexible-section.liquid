<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}"><div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}"><div class="grid grid-2 mobile-1">{% for block in section.blocks %}<div>{% case block.type %}{% when 'heading' %}<h2>{{ block.settings.text }}</h2>{% when 'text' %}{{ block.settings.text }}{% when 'image' %}{% if block.settings.image %}{{ block.settings.image | image_url:width:1000 | image_tag }}{% endif %}{% when 'button' %}<a class="btn" href="{{ block.settings.link }}">{{ block.settings.label }}</a>{% when 'accordion' %}<details><summary>{{ block.settings.heading }}</summary>{{ block.settings.text }}</details>{% endcase %}</div>{% endfor %}</div></div></section>
{% schema %}{"name":"Flexible section","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Flexible section"}],"blocks":[{"type":"heading","name":"Heading","settings":[{"type":"text","id":"text","label":"Heading"}]},{"type":"text","name":"Text","settings":[{"type":"richtext","id":"text","label":"Text"}]},{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"}]},{"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Label"},{"type":"url","id":"link","label":"Link"}]},{"type":"accordion","name":"Accordion","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"}]}],"max_blocks":20}{% endschema %}