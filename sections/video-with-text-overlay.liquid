<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}"><div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}"><div class="hero overlay">{% if section.settings.video %}<div class="hero-media">{{ section.settings.video | video_tag:autoplay:true,loop:true,muted:true }}</div>{% endif %}<div class="hero-content">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}</div></div></div></section>
{% schema %}{"name":"Video with text overlay","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false},{"type":"video","id":"video","label":"Video"}],"presets":[{"name":"Video with text overlay"}]}{% endschema %}