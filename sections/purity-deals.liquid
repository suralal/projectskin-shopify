<section class="ps-section ps-deals" style="--ps-pad-top: {{ section.settings.padding_top }}px; --ps-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="ps-wrap">
    {% render 'purity-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, copy: section.settings.description, alignment: 'center' %}
    <div class="ps-deals__grid">
      {% for block in section.blocks %}
        {% assign fallback_asset = 'deal-1.jpg' %}{% if forloop.index == 2 %}{% assign fallback_asset = 'deal-2.jpg' %}{% endif %}
        <a class="ps-deal" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {% render 'purity-image', image: block.settings.image, fallback_asset: fallback_asset, fallback_width: 1200, fallback_height: 700, alt: block.settings.heading, sizes: '(min-width: 800px) 50vw, 100vw' %}
          <div class="ps-deal__copy"><span class="ps-eyebrow" style="color:#fff">{{ block.settings.eyebrow }}</span><h3>{{ block.settings.heading }}</h3><span class="ps-button ps-button--light">{{ block.settings.button_label }}</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Today's best deals",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited-time care" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Today's Best Deals" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "deal", "name": "Deal", "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Daily ritual" }, { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Routine" }, { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Edit" }, { "type": "url", "id": "link", "label": "Link" }] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Today's best deals", "blocks": [{ "type": "deal" }, { "type": "deal" }] }]
}
{% endschema %}
