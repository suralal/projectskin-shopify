<section class="ps-customer" data-customer-account>
  <div class="ps-customer__shell">
    <div class="ps-auth__form-inner">
      <span class="ps-customer__eyebrow">Secure your account</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ps-customer__lede">{{ section.settings.text }}</p>
      {% form 'activate_customer_password', class: 'ps-account-form' %}
        {% if form.errors %}<div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="ps-field">
          <label for="CustomerPassword">Create password</label>
          <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="ps-field">
          <label for="CustomerPasswordConfirmation">Confirm password</label>
          <input id="CustomerPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button class="ps-button-account" type="submit">Activate account</button>
        <button class="ps-button-account--secondary" type="submit" name="decline">Decline invitation</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Activate customer account",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Activate your account" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Create a password to securely access your Project Skin orders and details." }
  ]
}
{% endschema %}
