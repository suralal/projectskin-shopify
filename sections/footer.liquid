{% liquid
  assign facebook_url = settings.social_facebook | default: 'https://www.facebook.com/share/1BS6aAnFib/?mibextid=wwXIfr'
  assign linkedin_url = settings.social_linkedin | default: 'https://www.linkedin.com/company/nureya-beauty-and-wellness-pvt-ltd-skin/'
  assign instagram_url = settings.social_instagram | default: 'https://www.instagram.com/projectskin.co?igsh=MTdyMnJvb2FleXAwdw=='
  assign youtube_url = settings.social_youtube | default: 'https://youtube.com/@projectskin-co?si=-XU6Nrk8cOZx7eyg'
  assign whatsapp_url = section.settings.whatsapp_url
  if whatsapp_url == blank
    assign whatsapp_url = 'https://wa.me/918446544458?text=Hi,%20I%20need%20to%20know%20more%20about%20your%20acne%20range%20products%20https://theprojectskin.com/'
  endif
%}

<footer class="ps-footer-wrapper w-full bg-[#1A1A1A] text-white" style="margin-top: 0 !important;">
  <div class="container mx-auto pt-16 pb-32 px-6 lg:px-16 xl:px-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 w-full">
      
      <!-- Brand & Social Icons -->
      <div class="flex flex-col lg:col-span-4">
        <div class="mb-8 max-w-[90px]">
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            <img src="{{ 'LOGO_PNG.jpg' | asset_url }}" alt="Project Skin" width="320" height="161" class="w-full h-auto object-contain">
          </a>
        </div>
        
        <div class="flex gap-x-6">
          <a href="{{ facebook_url }}" target="_blank" rel="noopener" class="w-[35px] h-[35px] rounded-full bg-[#333333] hover:bg-[#4D4D4D] flex items-center justify-center transition-colors text-white" aria-label="Facebook">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
          </a>
          <a href="{{ linkedin_url }}" target="_blank" rel="noopener" class="w-[35px] h-[35px] rounded-full bg-[#333333] hover:bg-[#4D4D4D] flex items-center justify-center transition-colors text-white" aria-label="LinkedIn">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z"/></svg>
          </a>
          <a href="{{ instagram_url }}" target="_blank" rel="noopener" class="w-[35px] h-[35px] rounded-full bg-[#333333] hover:bg-[#4D4D4D] flex items-center justify-center transition-colors text-white" aria-label="Instagram">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="{{ youtube_url }}" target="_blank" rel="noopener" class="w-[35px] h-[35px] rounded-full bg-[#333333] hover:bg-[#4D4D4D] flex items-center justify-center transition-colors text-white" aria-label="YouTube">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Company Overview -->
      <div class="flex flex-col lg:col-span-2 lg:col-start-5">
        <h2 class="text-[#D9D8D7] text-[15px] font-bold mb-6">{{ section.settings.company_heading | default: 'Company Overview' }}</h2>
        <div class="flex flex-col gap-y-3">
          <a href="{{ section.settings.link_about_url | default: '/pages/about' }}" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">{{ section.settings.link_about_label | default: 'About Us' }}</a>
          <a href="{{ section.settings.link_account_url | default: '/account' }}" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">{{ section.settings.link_account_label | default: 'My Account' }}</a>
          <a href="{{ section.settings.link_contact_url | default: '/pages/contact-us' }}" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">{{ section.settings.link_contact_label | default: 'Contact Us' }}</a>
          <a href="{{ section.settings.link_faq_url | default: '/pages/faq' }}" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">{{ section.settings.link_faq_label | default: "FAQ's" }}</a>
          <a href="{{ section.settings.link_guarantee_url | default: '/pages/money-back-guarantee' }}" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">{{ section.settings.link_guarantee_label | default: 'Money Back Guarantee' }}</a>
        </div>
      </div>

      <!-- Policies -->
      <div class="flex flex-col lg:col-span-2 lg:col-start-8">
        <h2 class="text-[#D9D8D7] text-[15px] font-bold mb-6">Policies</h2>
        <div class="flex flex-col gap-y-3">
          <a href="/policies/terms-of-service" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">Terms & Conditions</a>
          <a href="/policies/shipping-policy" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">Shipping Policy</a>
          <a href="/policies/refund-policy" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">Return & Refund Policy</a>
          <a href="/pages/payment-policy" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">Payment Policy</a>
          <a href="/pages/corporate-policy" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors">Corporate Policy</a>
        </div>
      </div>

      <!-- Contact us -->
      <div class="flex flex-col lg:col-span-2 lg:col-start-11">
        <h2 class="text-[#D9D8D7] text-[15px] font-bold mb-6">{{ section.settings.contact_heading | default: 'Contact us' }}</h2>
        <div class="flex flex-col gap-y-2">
          <p class="text-[#D9D8D7] text-[14px]">{{ section.settings.contact_intro | default: 'Need help fast?' }}</p>
          <a href="mailto:{{ section.settings.email | default: 'support@theprojectskin.com' }}" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors underline underline-offset-4 decoration-[#555] hover:decoration-white inline-block w-fit whitespace-nowrap">Email - {{ section.settings.email | default: 'support@theprojectskin.com' }}</a>
          <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="text-[#D9D8D7] hover:text-white text-[14px] transition-colors underline underline-offset-4 decoration-[#555] hover:decoration-white inline-block w-fit whitespace-nowrap">{{ section.settings.whatsapp_label | default: 'WhatsApp' }}</a>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="w-full border-t border-[#333333]">
    <div class="container mx-auto py-8 px-6 lg:px-16 xl:px-24 flex flex-col md:flex-row justify-between items-center text-[#A3A3A3] text-[14px]">
      <div class="w-full text-left">
        {{ section.settings.copyright_text | default: 'Copyright © 2026 Nureya Beauty and Wellness Pvt Limited' }}
      </div>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp Widget -->
<div class="pz3-floating-icon">
  <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <div class="pz3-icon-container">
      <img src="{{ 'whatsapp.png' | asset_url }}" width="34" height="34" alt="WhatsApp icon">
    </div>
  </a>
</div>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Company overview" },
    { "type": "text", "id": "company_heading", "label": "Company Heading", "default": "Company Overview" },
    { "type": "text", "id": "link_about_label", "label": "About label", "default": "About Us" },
    { "type": "url", "id": "link_about_url", "label": "About link" },
    { "type": "text", "id": "link_account_label", "label": "Account label", "default": "My Account" },
    { "type": "url", "id": "link_account_url", "label": "Account link" },
    { "type": "text", "id": "link_contact_label", "label": "Contact label", "default": "Contact Us" },
    { "type": "url", "id": "link_contact_url", "label": "Contact link" },
    { "type": "text", "id": "link_faq_label", "label": "FAQ label", "default": "FAQ's" },
    { "type": "url", "id": "link_faq_url", "label": "FAQ link" },
    { "type": "text", "id": "link_guarantee_label", "label": "Guarantee label", "default": "Money Back Guarantee" },
    { "type": "url", "id": "link_guarantee_url", "label": "Guarantee link" },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_heading", "label": "Contact Heading", "default": "Contact us" },
    { "type": "text", "id": "contact_intro", "label": "Contact Intro", "default": "Need help fast?" },
    { "type": "text", "id": "email", "label": "Email", "default": "support@theprojectskin.com" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "WhatsApp" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright_text", "label": "Copyright text", "default": "Copyright © 2026 Nureya Beauty and Wellness Pvt Limited" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
