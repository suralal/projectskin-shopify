<section id="science-purpose" class="psr-route-fallback psr-route-fallback--science psr-page psr-sci-purpose">
  <div class="container">
    <header class="psr-phil-head psr-phil-head--center">
      <p class="psr-phil-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="psr-phil-head__copy">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="psr-sci-purpose__grid">
      {% for block in section.blocks %}
        <article class="psr-sci-purpose__card" {{ block.shopify_attributes }}>
          <span class="psr-sci-purpose__seal" aria-hidden="true">{{ block.settings.icon | default: '◎' }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science purpose",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why explore the technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clarity before another product." },
    { "type": "textarea", "id": "text", "label": "Introduction", "default": "We built this layer so you can understand the concern, the mechanism, and the next step — without miracle timelines or ingredient theatre." }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon or symbol", "default": "◎" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Signal over guesswork" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Visible skin cues and your context are organized into a clearer starting point for cosmetic care." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science purpose",
      "blocks": [{ "type": "pillar" }, { "type": "pillar" }, { "type": "pillar" }]
    }
  ]
}
{% endschema %}
