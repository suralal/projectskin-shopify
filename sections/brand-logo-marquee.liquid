<section class="section logo-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment:'center' %}</div><div class="logo-marquee"><div class="logo-marquee__track" style="--logo-speed:{{ section.settings.speed }}s">{% for copy in (1..3) %}{% for block in section.blocks %}<div class="logo-marquee__item" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width:320 | image_tag:loading:'lazy' }}{% else %}<span>{{ block.settings.text }}</span>{% endif %}</div>{% endfor %}{% endfor %}</div></div></section>
{% schema %}{"name":"Brand logo marquee","settings":[{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading","default":"Featured Brands"},{"type":"richtext","id":"description","label":"Description"},{"type":"range","id":"speed","label":"Speed","min":12,"max":60,"step":2,"default":28,"unit":"s"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":56,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":56,"unit":"px"}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"text","id":"text","label":"Fallback text","default":"BRAND"}]}],"max_blocks":12,"presets":[{"name":"Brand logo marquee","blocks":[{"type":"logo"},{"type":"logo"},{"type":"logo"},{"type":"logo"}]}]}{% endschema %}