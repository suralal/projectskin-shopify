<section class="section"><div class="container"><h2>{{ section.settings.heading }}</h2><div class="grid grid-4">{% for block in section.blocks %}{% if block.settings.product %}{% render 'product-card', product:block.settings.product %}{% endif %}{% endfor %}</div></div></section>{% schema %}{"name":"Bought together products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Frequently bought together"}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Bought together products"}]}{% endschema %}