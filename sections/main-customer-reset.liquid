<section class="ps-customer" data-customer-account>
  <div class="ps-customer__shell">
    <div class="ps-auth__form-inner">
      <span class="ps-customer__eyebrow">Account security</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ps-customer__lede">{{ section.settings.text }}</p>
      {% form 'reset_customer_password', class: 'ps-account-form' %}
        {% if form.errors %}<div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="ps-field">
          <label for="ResetPassword">New password</label>
          <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="ps-field">
          <label for="ResetPasswordConfirmation">Confirm new password</label>
          <input id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button class="ps-button-account" type="submit">Reset password</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset customer password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose a new password" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Enter a new password for your Project Skin account." }
  ]
}
{% endschema %}
