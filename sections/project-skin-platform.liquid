<section id="science-platform" class="psr-route-fallback psr-route-fallback--science psr-page psr-sci-platform">
  <div class="container">
    <header class="psr-phil-head">
      <p class="psr-phil-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="psr-phil-head__copy">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="psr-platform" data-psr-platform>
      <div class="psr-platform__tabs" role="tablist" aria-label="Project Skin platform">
        {% for block in section.blocks %}
          <button
            class="psr-platform__tab"
            type="button"
            role="tab"
            id="PlatformTab-{{ section.id }}-{{ block.id }}"
            aria-controls="PlatformPanel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-step="0{{ forloop.index }}"
            data-psr-platform-tab
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.tab_label }}</span>
            <small>{{ block.settings.tab_hint }}</small>
          </button>
        {% endfor %}
      </div>

      <div>
        {% for block in section.blocks %}
          <div
            class="psr-platform__panel"
            id="PlatformPanel-{{ section.id }}-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="PlatformTab-{{ section.id }}-{{ block.id }}"
            data-psr-platform-panel
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="psr-platform__panel-inner">
              <div class="psr-platform__copy">
                <span class="psr-phil-kicker">{{ block.settings.eyebrow }}</span>
                <h3>{{ block.settings.heading }}</h3>
                <p>{{ block.settings.text }}</p>
                <ul class="psr-feature-list">
                  {% if block.settings.feature_1 != blank %}<li>{{ block.settings.feature_1 }}</li>{% endif %}
                  {% if block.settings.feature_2 != blank %}<li>{{ block.settings.feature_2 }}</li>{% endif %}
                  {% if block.settings.feature_3 != blank %}<li>{{ block.settings.feature_3 }}</li>{% endif %}
                </ul>
                {% if block.settings.button_label != blank %}<a class="psr-phil-btn" href="{{ block.settings.button_link | default: '/pages/consultation' }}">{{ block.settings.button_label }}</a>{% endif %}
              </div>
              <div class="psr-platform__visual">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 44vw, 100vw', alt: block.settings.heading }}
                {% else %}
                  {% case block.settings.mode %}
                    {% when 'recommendations' %}<img src="{{ 'psr-science-step-match.jpg' | asset_url }}" width="1400" height="780" loading="lazy" alt="{{ block.settings.heading | escape }}">
                    {% when 'routine' %}<img src="{{ 'psr-science-step-routine.jpg' | asset_url }}" width="1400" height="780" loading="lazy" alt="{{ block.settings.heading | escape }}">
                    {% when 'progress' %}<img src="{{ 'psr-science-step-progress.jpg' | asset_url }}" width="1400" height="780" loading="lazy" alt="{{ block.settings.heading | escape }}">
                    {% else %}<img src="{{ 'psr-science-mission-scan.jpg' | asset_url }}" width="1400" height="780" loading="lazy" alt="{{ block.settings.heading | escape }}">
                  {% endcase %}
                {% endif %}
                <div class="psr-platform__status">
                  {% case block.settings.mode %}
                    {% when 'recommendations' %}
                      <strong>Matched by concern, mechanism and routine role</strong><div class="psr-status-bar"><span></span></div>
                    {% when 'routine' %}
                      <strong>Today’s routine</strong>
                      <div class="psr-routine-demo" data-routine-demo>
                        <button class="psr-routine-step" type="button" aria-pressed="false" data-routine-step>Cleanse</button>
                        <button class="psr-routine-step" type="button" aria-pressed="false" data-routine-step>Treat</button>
                        <button class="psr-routine-step" type="button" aria-pressed="false" data-routine-step>Moisturise</button>
                        <button class="psr-routine-step" type="button" aria-pressed="false" data-routine-step>Protect</button>
                        <span class="psr-routine-progress" data-routine-progress></span>
                      </div>
                    {% when 'progress' %}
                      <strong>Baseline ready for the next check-in</strong><div class="psr-status-bar"><span></span></div>
                    {% else %}
                      <strong>Visible signal map ready for review</strong><div class="psr-status-bar"><span></span></div>
                  {% endcase %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science platform",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One connected skin ecosystem" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From signal to smarter routine" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Project Skin connects analysis, product matching and daily adherence so recommendations can become more relevant over time." }
  ],
  "blocks": [
    {
      "type": "capability",
      "name": "Platform capability",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "mode", "label": "Capability type", "default": "digital_twin", "options": [
          { "value": "digital_twin", "label": "Digital Twin" },
          { "value": "recommendations", "label": "Recommendations" },
          { "value": "routine", "label": "Routine Tracker" },
          { "value": "progress", "label": "Progress" }
        ] },
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Digital Twin" },
        { "type": "text", "id": "tab_hint", "label": "Tab description", "default": "Map visible skin signals" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Understand before you treat" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your skin, translated into evidence" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A guided scan creates a living profile of visible concerns and contextual signals. It is designed to support better decisions, not replace medical diagnosis." },
        { "type": "text", "id": "feature_1", "label": "Feature 1", "default": "Maps acne, pigmentation, texture and barrier signals" },
        { "type": "text", "id": "feature_2", "label": "Feature 2", "default": "Considers climate, routine and lifestyle context" },
        { "type": "text", "id": "feature_3", "label": "Feature 3", "default": "Creates a reusable baseline for future check-ins" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Start with a consultation" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Science platform", "blocks": [{ "type": "capability" }, { "type": "capability" }, { "type": "capability" }, { "type": "capability" }] }]
}
{% endschema %}
