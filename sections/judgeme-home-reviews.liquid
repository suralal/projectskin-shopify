{% liquid
  assign jm = shop.metafields.judgeme
  assign review_count = jm.all_reviews_count | default: 0 | plus: 0
  assign review_rating = jm.all_reviews_rating | default: 0
  assign has_carousel = false
  if jm.featured_carousel != blank and jm.featured_carousel.size > 20
    assign has_carousel = true
  endif
  assign show_fallback = false
  if section.settings.show_fallback_when_empty and has_carousel == false
    assign show_fallback = true
  endif
%}

<section
  class="ps-section ps-review-band ps-judgeme-home{% if show_fallback %} ps-judgeme-home--fallback{% endif %}"
  style="--ps-pad-top: {{ section.settings.padding_top }}px; --ps-pad-bottom: {{ section.settings.padding_bottom }}px"
  id="HomeReviews"
>
  <div class="ps-wrap">
    {% render 'purity-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, copy: section.settings.description, alignment: 'center' %}

    {% if review_count > 0 %}
      <p class="ps-judgeme-home__aggregate">
        <span
          class="jdgm-all-reviews-rating"
          data-score="{{ review_rating }}"
          aria-label="{{ review_rating }} out of 5 stars"
          role="img"
        ></span>
        <span>{{ review_count }} verified review{% if review_count != 1 %}s{% endif %}</span>
      </p>
    {% endif %}

    {% if show_fallback %}
      <div class="ps-review-rail">
        {% for block in section.blocks %}
          {% liquid
            assign fallback_asset = 'review-1.jpg'
            case forloop.index
              when 2
                assign fallback_asset = 'review-2.jpg'
              when 3
                assign fallback_asset = 'review-3.jpg'
              when 4
                assign fallback_asset = 'review-4.jpg'
            endcase
          %}
          <article class="ps-review-card" {{ block.shopify_attributes }}>
            <div class="ps-review-card__image">{% render 'purity-image', image: block.settings.image, fallback_asset: fallback_asset, fallback_width: 900, fallback_height: 670, alt: block.settings.heading, sizes: '320px' %}</div>
            <div class="ps-review-card__copy">
              <div class="ps-review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">★★★★★</div>
              <h3>{{ block.settings.heading }}</h3>
              <div class="rte">{{ block.settings.quote }}</div>
              {% if block.settings.author != blank %}<small>{{ block.settings.author }} · Early feedback</small>{% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      <p class="ps-judgeme-home__note">Verified Judge.me reviews replace these cards automatically once published.</p>
    {% endif %}

    <!-- Start of Judge.me code -->
    <div class="jdgm-carousel-wrapper ps-judgeme-home__carousel" data-auto-install="false"{% if show_fallback %} hidden{% endif %}>
      {{ jm.featured_carousel }}
    </div>
    <!-- End of Judge.me code -->
  </div>
</section>

{% schema %}
{
  "name": "Judge.me home reviews",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What customers see" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Results You Can See" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Texture, climate, and consistency — from people building the same routine.</p>" },
    { "type": "checkbox", "id": "show_fallback_when_empty", "label": "Show curated cards when Judge.me carousel is empty", "default": true },
    { "type": "paragraph", "content": "Requires the Judge.me app embed. Carousel content is managed in Judge.me → Settings → Widgets → Reviews Carousel." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Fallback review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Softer, calmer skin" },
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>My skin feels balanced and looks visibly brighter.</p>" },
        { "type": "text", "id": "author", "label": "Author", "default": "Maya R." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Judge.me home reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
