<section class="section editorial-split {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}">
  <div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">
    {% assign fallback_product = collections['all'].products[0] | default: collections['all'].products.first %}
    <div class="grid grid-2 mobile-1 editorial-split__grid">
      <div class="editorial-split__media">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading:'lazy', widths:'600,900,1200,1400' }}{% elsif fallback_product.featured_image %}{{ fallback_product.featured_image | image_url: width: 1200 | image_tag: loading:'lazy', widths:'500,800,1000,1200', alt:fallback_product.title }}{% else %}<div class="media-placeholder"></div>{% endif %}</div>
      <div class="editorial-split__content">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}{% if section.settings.button_link %}<a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% elsif fallback_product %}<a class="btn" href="{{ fallback_product.url }}">Shop now</a>{% endif %}</div>
    </div>
  </div>
</section>
{% schema %}{"name":"Recommended collection","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false},{"type":"image_picker","id":"image","label":"Image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Recommended collection"}]}{% endschema %}