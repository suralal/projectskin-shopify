<section class="ps-customer" data-customer-account>
  <div class="ps-customer__shell">
    <header class="ps-account-header">
      <div>
        <span class="ps-customer__eyebrow">Account details</span>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.text }}</p>
      </div>
      <div class="ps-account-actions">
        <button class="ps-button-account" type="button" data-address-toggle="AddressNewForm" aria-expanded="false">Add address</button>
        <a class="ps-button-account--secondary" href="{{ routes.account_url }}">Back to account</a>
      </div>
    </header>

    <div class="ps-address-editor ps-address-form" id="AddressNewForm" data-address-form hidden>
      <div class="ps-address-editor__head">
        <h2>Add a new address</h2>
        <button class="ps-account-link" type="button" data-address-close>Close</button>
      </div>
      {% form 'customer_address', customer.new_address, class: 'ps-account-form' %}
        {% if form.errors %}<div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        {% render 'customer-address-form-fields', address_form: form, form_key: 'New', is_default: false %}
        <button class="ps-button-account" type="submit">Save address</button>
      {% endform %}
    </div>

    {% paginate customer.addresses by 6 %}
      {% if customer.addresses.size > 0 %}
        <div class="ps-address-grid">
          {% for address in customer.addresses %}
            <article class="ps-address-card{% if address == customer.default_address %} ps-address-card--default{% endif %}">
              {% if address == customer.default_address %}<span class="ps-address-card__label">Default address</span>{% else %}<span class="ps-address-card__label">Saved address {{ forloop.index }}</span>{% endif %}
              <address>{{ address | format_address }}</address>
              <div class="ps-address-card__actions">
                <button class="ps-account-link" type="button" data-address-toggle="AddressEditForm-{{ address.id }}" aria-expanded="false">Edit</button>
                <button
                  class="ps-account-link"
                  type="button"
                  data-address-delete="{{ routes.account_addresses_url }}/{{ address.id }}"
                  data-confirm="Delete this saved address?"
                >Delete</button>
              </div>
            </article>

            <div class="ps-address-editor ps-address-form" id="AddressEditForm-{{ address.id }}" data-address-form hidden>
              <div class="ps-address-editor__head">
                <h2>Edit address</h2>
                <button class="ps-account-link" type="button" data-address-close>Close</button>
              </div>
              {% form 'customer_address', address, class: 'ps-account-form' %}
                {% if form.errors %}<div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
                {% assign address_is_default = false %}
                {% if address == customer.default_address %}{% assign address_is_default = true %}{% endif %}
                {% render 'customer-address-form-fields', address_form: form, form_key: address.id, is_default: address_is_default %}
                <button class="ps-button-account" type="submit">Update address</button>
              {% endform %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="ps-account-empty">
          <h2>No saved addresses yet</h2>
          <p>Add a delivery address now, or save one when you place your next order.</p>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="ps-pagination" aria-label="Address pages">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Customer addresses",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Saved addresses" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Keep delivery details accurate for a smoother checkout." }
  ]
}
{% endschema %}
