<section class="psr-route-fallback psr-route-fallback--philosophy psr-page psr-phil-hero">
  <div class="container psr-phil-hero__frame">
    <div class="psr-phil-hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '900,1400,2000,2600', sizes: '100vw', alt: section.settings.image_alt }}
      {% else %}
        <img
          src="{{ 'psr-philosophy-hero-overlay.jpg' | asset_url }}"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          alt="{{ section.settings.image_alt | escape }}"
        >
      {% endif %}
      <div class="psr-phil-hero__veil" aria-hidden="true"></div>
      <div class="psr-phil-hero__copy">
        <p class="psr-phil-kicker psr-phil-kicker--light">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading | newline_to_br }}</h1>
        {% if section.settings.text != blank %}
          <div class="psr-phil-hero__text rte">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
          <div class="psr-phil-actions">
            {% if section.settings.primary_label != blank %}
              <a class="psr-phil-btn" href="{{ section.settings.primary_link | default: '#project-skin-principles' }}">{{ section.settings.primary_label }}</a>
            {% endif %}
            {% if section.settings.secondary_label != blank %}
              <a class="psr-phil-btn psr-phil-btn--ghost" href="{{ section.settings.secondary_link | default: '/pages/the-science' }}">{{ section.settings.secondary_label }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Skin is biology.\nCare should respect it." },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Project Skin exists to move skincare beyond trends and toward better-informed, evidence-led decisions for Indian skin.</p>" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "image_alt", "label": "Image alternative text", "default": "Calm, glowing skin in soft natural light" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore our principles" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Meet the science" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Philosophy hero" }]
}
{% endschema %}
