<section class="section slideshow-section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}">
  <div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">
    <div class="purity-slider" data-slider data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
      <div class="purity-slider__viewport" data-slider-viewport>
        <div class="purity-slider__track" data-slider-track>
          {% for block in section.blocks %}
            <article class="purity-slide hero overlay" data-slider-slide {{ block.shopify_attributes }}>
              {% assign hero_fallback = collections['all'].products.first.featured_image %}
              {% if block.settings.image %}
                <picture class="hero-media">
                  {% if block.settings.mobile_image %}<source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">{% endif %}
                  {% if forloop.first %}{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1600,2000,2400', sizes: '100vw', alt: block.settings.heading }}{% else %}{{ block.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750,1100,1600,2000,2400', sizes: '100vw', alt: block.settings.heading }}{% endif %}
                </picture>
              {% elsif hero_fallback %}
                <div class="hero-media hero-media--fallback">{{ hero_fallback | image_url: width: 1400 | image_tag: loading:'eager', fetchpriority:'high', widths:'600,900,1200,1400', sizes:'100vw', alt:block.settings.heading }}</div>
              {% else %}<div class="hero-media hero-media--placeholder"></div>
              {% endif %}
              <div class="hero-content hero-content--{{ block.settings.content_position }}">
                {% if block.settings.subheading != blank %}<div class="eyebrow">{{ block.settings.subheading }}</div>{% endif %}
                {% if block.settings.heading != blank %}{% if forloop.first %}<h1>{{ block.settings.heading }}</h1>{% else %}<h2>{{ block.settings.heading }}</h2>{% endif %}{% endif %}
                {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
                <div class="hero-actions">
                  {% if block.settings.link != blank and block.settings.button_label != blank %}<a class="btn" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>{% endif %}
                  {% if block.settings.link_2 != blank and block.settings.button_label_2 != blank %}<a class="btn outline" href="{{ block.settings.link_2 }}">{{ block.settings.button_label_2 }}</a>{% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
      {% if section.blocks.size > 1 and section.settings.show_navigation %}
        <button class="slider-arrow slider-arrow--prev" type="button" data-slider-prev aria-label="Previous slide">‹</button>
        <button class="slider-arrow slider-arrow--next" type="button" data-slider-next aria-label="Next slide">›</button>
      {% endif %}
      {% if section.blocks.size > 1 and section.settings.show_pagination %}<div class="slider-dots" data-slider-dots></div>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Slideshow","tag":"section","class":"section-wrapper","settings":[
{"type":"select","id":"section_width","label":"Section width","default":"full","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},
{"type":"checkbox","id":"autoplay","label":"Auto-change slide","default":true},{"type":"range","id":"interval","label":"Change slides every","min":3,"max":10,"step":1,"default":5,"unit":"s"},{"type":"checkbox","id":"show_navigation","label":"Show navigation","default":true},{"type":"checkbox","id":"show_pagination","label":"Show pagination","default":true},
{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":0,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":0,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],
"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"},{"type":"select","id":"content_position","label":"Content position","default":"bottom-left","options":[{"value":"top-left","label":"Top left"},{"value":"center-left","label":"Center left"},{"value":"bottom-left","label":"Bottom left"},{"value":"center","label":"Center"}]},{"type":"text","id":"button_label","label":"Primary button label","default":"Shop now"},{"type":"url","id":"link","label":"Primary link"},{"type":"text","id":"button_label_2","label":"Secondary button label"},{"type":"url","id":"link_2","label":"Secondary link"}]}],"max_blocks":8,"presets":[{"name":"Slideshow"}]}
{% endschema %}
