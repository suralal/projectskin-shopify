<section class="psr-route-fallback psr-route-fallback--philosophy psr-page psr-standards">
  <div class="container">
    <div class="psr-standards__head">
      <span class="psr-kicker">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
    <div class="psr-standards__list">
      {% for block in section.blocks %}
        <article class="psr-standard" {{ block.shopify_attributes }}>
          <span>0{{ forloop.index }}</span>
          <div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div>
        </article>
      {% endfor %}
    </div>
    <div class="psr-standards__cta">
      <p>{{ section.settings.cta_text }}</p>
      <div class="psr-hero-actions">
        {% if section.settings.primary_label != blank %}<a class="psr-button psr-button--light" href="{{ section.settings.primary_link | default: '/pages/the-science' }}">{{ section.settings.primary_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="psr-text-link psr-text-link--light" href="{{ section.settings.secondary_link | default: '/pages/consultation' }}">{{ section.settings.secondary_label }} <span aria-hidden="true">↗</span></a>{% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Project Skin standards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The standard we hold" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Evidence should be visible in the experience." },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Credibility is not a badge. It is the way a formula is explained, a recommendation is reasoned, and progress is reviewed without unrealistic promises.</p>" },
    { "type": "text", "id": "cta_text", "label": "Call to action text", "default": "Understand your skin before adding another product." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Explore the science" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Speak to a dermatologist" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "standard",
      "name": "Standard",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Mechanism, not marketing" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "We explain what an ingredient is there to do and how it fits the routine." }
      ]
    }
  ],
  "presets": [{ "name": "Project Skin standards", "blocks": [{ "type": "standard" }, { "type": "standard" }, { "type": "standard" }, { "type": "standard" }] }]
}
{% endschema %}
