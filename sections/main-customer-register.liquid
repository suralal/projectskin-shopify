<section class="ps-customer ps-auth" data-customer-account>
  <div class="ps-auth__form">
    <div class="ps-auth__form-inner">
      <span class="ps-customer__eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ps-customer__lede">{{ section.settings.text }}</p>

      {% form 'create_customer', class: 'ps-account-form', novalidate: 'novalidate' %}
        {% if form.errors %}
          <div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="ps-account-form__row">
          <div class="ps-field">
            <label for="RegisterFirstName">First name</label>
            <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name" value="{% if form.first_name %}{{ form.first_name | escape }}{% endif %}">
          </div>
          <div class="ps-field">
            <label for="RegisterLastName">Last name</label>
            <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name" value="{% if form.last_name %}{{ form.last_name | escape }}{% endif %}">
          </div>
        </div>

        <div class="ps-field">
          <label for="RegisterEmail">Email address</label>
          <input
            id="RegisterEmail"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            value="{% if form.email %}{{ form.email | escape }}{% endif %}"
            required
          >
        </div>

        <div class="ps-field">
          <label for="RegisterPassword">Create password</label>
          <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" minlength="5" required>
          <span class="ps-field__hint">Use at least 5 characters. A longer, unique password is recommended.</span>
        </div>

        <button class="ps-button-account" type="submit">{{ section.settings.button_label }}</button>
        <div class="ps-account-form__meta">
          <span>Already have an account?</span>
          <a class="ps-account-link" href="{{ routes.account_login_url }}">Sign in</a>
        </div>
      {% endform %}
    </div>
  </div>

  <aside class="ps-auth__aside">
    <span class="ps-customer__eyebrow">{{ section.settings.aside_eyebrow }}</span>
    <h2>{{ section.settings.aside_heading }}</h2>
    <p>{{ section.settings.aside_text }}</p>
    <ul class="ps-auth__benefits" role="list">
      <li>Review every Project Skin order</li>
      <li>Move through checkout more quickly</li>
      <li>Manage delivery details securely</li>
    </ul>
  </aside>
</section>

{% schema %}
{
  "name": "Customer registration",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join Project Skin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create your account" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A simple account for your orders, addresses, and evolving skincare routine." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create account" },
    { "type": "header", "content": "Editorial panel" },
    { "type": "text", "id": "aside_eyebrow", "label": "Eyebrow", "default": "Made to stay useful" },
    { "type": "text", "id": "aside_heading", "label": "Heading", "default": "A routine that stays with you." },
    { "type": "textarea", "id": "aside_text", "label": "Text", "default": "Your account keeps the practical details organised, so caring for your skin feels easier every time you return." }
  ]
}
{% endschema %}
