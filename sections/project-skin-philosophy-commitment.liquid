<section class="psr-route-fallback psr-route-fallback--philosophy psr-page psr-phil-commit">
  <div class="container">
    <header class="psr-phil-head psr-phil-head--center">
      <p class="psr-phil-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="psr-phil-head__copy rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="psr-phil-commit__grid">
      {% for block in section.blocks %}
        {% liquid
          assign fallback = 'psr-philosophy-trust-1.jpg'
          if forloop.index == 2
            assign fallback = 'psr-philosophy-trust-2.jpg'
          elsif forloop.index == 3
            assign fallback = 'psr-philosophy-commit-skin.jpg'
          endif
        %}
        <article class="psr-phil-commit__card" {{ block.shopify_attributes }}>
          <div class="psr-phil-commit__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1000,1200', sizes: '(min-width: 900px) 30vw, 100vw', alt: block.settings.heading }}
            {% else %}
              <img src="{{ fallback | asset_url }}" width="1000" height="700" loading="lazy" alt="{{ block.settings.heading | escape }}">
            {% endif %}
          </div>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="psr-phil-commit__cta">
        <a class="psr-phil-btn" href="{{ section.settings.cta_link | default: '/pages/the-science' }}">{{ section.settings.cta_label }}</a>
        {% if section.settings.secondary_label != blank %}
          <a class="psr-phil-text-link" href="{{ section.settings.secondary_link | default: '/pages/consultation' }}">{{ section.settings.secondary_label }} <span aria-hidden="true">↗</span></a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Philosophy commitment",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Commitment" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to earn your trust" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>Credibility is not a badge. It is how a formula is explained, a recommendation is reasoned, and progress is reviewed without unrealistic promises.</p>" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Explore the science" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link label", "default": "Speak to a dermatologist" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "commitment",
      "name": "Commitment",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Mechanism, not marketing" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "We explain what an ingredient is there to do and how it fits the routine." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy commitment",
      "blocks": [
        { "type": "commitment" },
        { "type": "commitment" },
        { "type": "commitment" }
      ]
    }
  ]
}
{% endschema %}
