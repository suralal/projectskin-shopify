<section class="pdp-section pdp-results" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="page-width-pdp pdp-results__grid">
    <div class="pdp-results__copy"><p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="pdp-result-accordions">{% for block in section.blocks %}<details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}<span>+</span></summary><div>{{ block.settings.copy }}</div></details>{% endfor %}</div></div>
    <div class="pdp-results__compare before-after" data-before-after>
      <div class="before-after__after">{% render 'purity-image', image: section.settings.after, fallback_asset: 'pdp-after.jpg', fallback_width: 1200, fallback_height: 1022, alt: section.settings.after_label, sizes: '(min-width: 750px) 48vw, 94vw' %}</div>
      <div class="before-after__before" data-before-layer>{% render 'purity-image', image: section.settings.before, fallback_asset: 'pdp-before.jpg', fallback_width: 1200, fallback_height: 1022, alt: section.settings.before_label, sizes: '(min-width: 750px) 48vw, 94vw' %}</div>
      <div class="before-after__labels"><span>{{ section.settings.before_label }}</span><span>{{ section.settings.after_label }}</span></div><div class="before-after__line" data-before-line><span>↔</span></div><input class="before-after__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" data-before-range>
    </div>
  </div>
</section>
{% schema %}
{"name":"PDP results","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"What You'll See"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Results on Your Lips"},{"type":"image_picker","id":"before","label":"Before image"},{"type":"image_picker","id":"after","label":"After image"},{"type":"text","id":"before_label","label":"Before label","default":"Before"},{"type":"text","id":"after_label","label":"After label","default":"After"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":72}],"blocks":[{"type":"result","name":"Result detail","settings":[{"type":"text","id":"heading","label":"Heading","default":"Soft, fuller-looking lips"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Botanical oils and shea butter lock in moisture the moment you swipe, leaving lips smoother and comfortably cushioned.</p>"}]}],"max_blocks":6,"presets":[{"name":"PDP results","blocks":[{"type":"result"},{"type":"result"},{"type":"result"},{"type":"result"}]}]}
{% endschema %}
