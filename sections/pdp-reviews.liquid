<section class="pdp-section pdp-reviews" id="PdpReviews" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"><div class="page-width-pdp"><div class="pdp-reviews__summary"><div><p>{{ section.settings.eyebrow }}</p><strong>{{ section.settings.rating }}</strong><span>★★★★★</span><small>{{ section.settings.count }} reviews</small></div><button type="button" data-pdp-review-open>{{ section.settings.button_label }}</button></div><div class="pdp-reviews__list">{% for block in section.blocks %}{% assign review_base = forloop.index0 | times: 3 %}<article class="pdp-review" {{ block.shopify_attributes }}><div class="pdp-review__stars">★★★★★</div><div class="pdp-review__meta"><span class="pdp-review__avatar">{{ block.settings.author | slice: 0 }}</span><div><strong>{{ block.settings.author }}</strong><span>{{ block.settings.date }}</span></div></div><h3>{{ block.settings.heading }}</h3><div class="pdp-review__copy">{{ block.settings.copy }}</div><div class="pdp-review__media">{% for i in (1..3) %}{% assign asset_index = review_base | plus: i %}{% assign fallback = 'pdp-review-' | append: asset_index | append: '.jpg' %}{% assign image_key = 'image_' | append: i %}{% render 'purity-image', image: block.settings[image_key], fallback_asset: fallback, fallback_width: 900, fallback_height: 900, alt: block.settings.heading, sizes: '110px' %}{% endfor %}</div></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"PDP reviews","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Customer Reviews"},{"type":"text","id":"rating","label":"Rating","default":"5.0"},{"type":"text","id":"count","label":"Review count","default":"2"},{"type":"text","id":"button_label","label":"Button label","default":"Write a review"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":68},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":72}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"text","id":"author","label":"Author","default":"Chloe P."},{"type":"text","id":"date","label":"Date","default":"05/07/2025"},{"type":"text","id":"heading","label":"Heading","default":"No flakes, no smudge!"},{"type":"richtext","id":"copy","label":"Review","default":"<p>I wore this for 12 hours straight and it did not move at all. It holds my curl beautifully and coats every lash evenly.</p>"},{"type":"image_picker","id":"image_1","label":"Image 1"},{"type":"image_picker","id":"image_2","label":"Image 2"},{"type":"image_picker","id":"image_3","label":"Image 3"}]}],"max_blocks":12,"presets":[{"name":"PDP reviews","blocks":[{"type":"review"},{"type":"review"}]}]}
{% endschema %}
