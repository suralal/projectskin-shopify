{% comment %}
  Get Skin Smart — three feature cards → dedicated landing pages.
{% endcomment %}
<section
  class="ps-smart"
  id="SkinSmart-{{ section.id }}"
  style="--ps-smart-top: {{ section.settings.padding_top }}px; --ps-smart-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ps-smart__intro">
    {% if section.settings.heading != blank %}
      <h2 class="ps-smart__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="ps-smart__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.explore_label != blank %}
      {% if section.settings.explore_link != blank %}
        <a class="ps-smart__explore" href="{{ section.settings.explore_link }}">{{ section.settings.explore_label }}</a>
      {% else %}
        <a class="ps-smart__explore" href="#SkinSmart-{{ section.id }}">{{ section.settings.explore_label }}</a>
      {% endif %}
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="ps-smart__rail" data-smart-rail>
      <div class="ps-smart__track">
        {% for block in section.blocks %}
          {% liquid
            assign card_image = block.settings.image
            assign fallback = 'ps-smart-consult.png'
            assign focus = 'center'
            case block.settings.fallback_image
              when 'scan'
                assign fallback = 'ps-smart-analysis-card.png'
                assign focus = 'center'
              when 'quiz'
                assign fallback = 'ps-smart-routine-card.png'
                assign focus = 'center'
              when 'routine'
                assign fallback = 'ps-smart-routine-card.png'
                assign focus = 'center'
              when 'philosophy'
                assign fallback = 'project-skin-philosophy-people.jpg'
              else
                assign fallback = 'ps-smart-consult-card.png'
                assign focus = 'center'
            endcase
            assign card_href = block.settings.link | default: '#'
          %}
          <article
            class="ps-smart__card"
            {{ block.shopify_attributes }}
            data-coming-soon="true"
            data-feature="{{ block.settings.fallback_image | default: 'consultation' }}"
            data-feature-title="{{ block.settings.title | escape }}"
            data-feature-desc="{{ block.settings.text | escape }}"
          >
            <a class="ps-smart__media ps-smart__media--{{ focus }}" href="{{ card_href }}" aria-label="{{ block.settings.title | escape }}" data-coming-soon="true">
              {% render 'purity-image',
                image: card_image,
                fallback_asset: fallback,
                fallback_width: 880,
                fallback_height: 1100,
                alt: block.settings.title,
                sizes: '(min-width: 990px) 32vw, 78vw',
                loading: 'lazy'
              %}
              <span class="ps-smart__shade" aria-hidden="true"></span>
            </a>

            <div class="ps-smart__body">
              {% if block.settings.title != blank %}
                <h3 class="ps-smart__title">
                  <a href="{{ card_href }}" data-coming-soon="true">{{ block.settings.title }}</a>
                </h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="ps-smart__desc">{{ block.settings.text }}</p>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <a class="ps-smart__cta" href="{{ card_href }}" data-coming-soon="true">{{ block.settings.button_label }}</a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
      {% if section.blocks.size > 1 %}
        <div class="ps-smart__dots" role="tablist" aria-label="Feature cards">
          {% for block in section.blocks %}
            <button class="ps-smart__dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Go to card {{ forloop.index }}" data-smart-dot="{{ forloop.index0 }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Get Skin Smart",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get skin smart"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Expert guidance, a structured skin report, and a clearer routine — online, when you need it."
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "Explore link label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "explore_link",
      "label": "Explore link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_image",
          "label": "Fallback image",
          "options": [
            { "value": "consultation", "label": "Consultation" },
            { "value": "scan", "label": "Skin analysis" },
            { "value": "quiz", "label": "Routine finder" },
            { "value": "routine", "label": "Routine" },
            { "value": "philosophy", "label": "People / philosophy" }
          ],
          "default": "consultation"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Dermatologist consultation" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Book a guided conversation about recurring concerns and your current routine."
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Book now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Get Skin Smart",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "fallback_image": "consultation",
            "title": "Dermatologist consultation",
            "text": "Book a guided conversation about recurring concerns and your current routine.",
            "button_label": "Book now",
            "link": "/pages/consultation"
          }
        },
        {
          "type": "card",
          "settings": {
            "fallback_image": "scan",
            "title": "Skin analysis & report",
            "text": "Capture your face signals, habits, and lifestyle — then get a comprehensive report for recommendations or your dermatologist.",
            "button_label": "Get started",
            "link": "/pages/skin-profile"
          }
        },
        {
          "type": "card",
          "settings": {
            "fallback_image": "quiz",
            "title": "Routine finder",
            "text": "Answer a few questions and receive a clear four-step plan for your concerns.",
            "button_label": "Get started",
            "link": "/pages/routine-finder"
          }
        }
      ]
    }
  ]
}
{% endschema %}
