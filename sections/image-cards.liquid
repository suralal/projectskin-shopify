<section class="section concern-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}<div class="grid grid-3 concern-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="concern-card">{% if block.settings.image %}<div class="concern-card__media">{{ block.settings.image | image_url: width:900 | image_tag:loading:'lazy' }}</div>{% endif %}<h3>{{ block.settings.heading }}</h3><div class="muted">{{ block.settings.text }}</div></article>{% endfor %}{% else %}{% for product in collections['all'].products limit:3 %}<a class="concern-card" href="{{ product.url }}">{% if product.featured_image %}<div class="concern-card__media">{{ product.featured_image | image_url: width:900 | image_tag:loading:'lazy' }}</div>{% endif %}<h3>{{ product.title }}</h3><span class="text-link">Explore →</span></a>{% endfor %}{% endif %}</div></div></section>
{% schema %}{"name":"Image cards","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"presets":[{"name":"Image cards"}],"blocks":[{"type":"item","name":"Item","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":20}{% endschema %}