{% comment %}
  Genuine 404.

  This section previously ran a route-fallback system: a script mapped paths like
  /pages/philosophy to a route key, and templates/404.json carried ~24 sections of
  substitute content that CSS then showed or hid. Its own comment described it as a
  stopgap "until Admin publishes matching Shopify pages".

  Those pages now exist, so the stopgap is retired. It was costing us: the URL still
  returned HTTP 404 with a "404 Not Found" title while rendering 6,318 words of the
  same copy that lives on the real pages — duplicate content under a 404 status, on
  every 404 the site serves.

  Still unpublished at time of writing: /pages/routine-finder, /pages/skin-profile,
  /pages/smart-lab. Those now show this page, which is correct — they are 404s until
  the Shopify pages are published.
{% endcomment %}
<section class="section ps-404">
  <div class="container ps-404__inner">
    <p class="ps-404__code">404</p>
    <h1 class="ps-404__heading">{{ section.settings.heading | default: 'This page does not exist.' }}</h1>
    <p class="ps-404__copy">{{ section.settings.copy | default: 'The link may be out of date, or the address mistyped. Everything below is where the science actually lives.' }}</p>

    <form class="ps-404__search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="Search404">Search Project Skin</label>
      <input id="Search404" type="search" name="q" placeholder="Search products and ingredients" autocomplete="off">
      <button type="submit">Search</button>
    </form>

    <div class="ps-404__grid">
      <div class="ps-404__group">
        <h2>Shop the routine</h2>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          <li><a href="{{ routes.collections_url }}/cleanse">Cleanse</a></li>
          <li><a href="{{ routes.collections_url }}/treat">Treat</a></li>
          <li><a href="{{ routes.collections_url }}/moisturise">Moisturise</a></li>
          <li><a href="{{ routes.collections_url }}/protect">Protect</a></li>
        </ul>
      </div>

      <div class="ps-404__group">
        <h2>Understand your skin</h2>
        <ul>
          <li><a href="/pages/the-science">The Science</a></li>
          <li><a href="/pages/ingredients">Ingredients, with concentrations</a></li>
          <li><a href="/pages/philosophy">Philosophy</a></li>
          <li><a href="/pages/journal">Journal</a></li>
          <li><a href="/pages/climate">Climate</a></li>
        </ul>
      </div>

      <div class="ps-404__group">
        <h2>By concern</h2>
        <ul>
          <li><a href="/pages/acne">Acne</a></li>
          <li><a href="/pages/pigmentation">Pigmentation</a></li>
          <li><a href="/pages/barrier">Barrier support</a></li>
          <li><a href="/pages/daily-spf">Daily SPF</a></li>
          <li><a href="/pages/consultation">Book a consultation</a></li>
        </ul>
      </div>
    </div>

    <a class="ps-404__home" href="{{ routes.root_url }}">Back to the homepage</a>
  </div>
</section>

<style>
  .ps-404 { padding: clamp(48px, 8vw, 96px) 0; }
  .ps-404__inner { max-width: 940px; }
  .ps-404__code {
    margin: 0 0 8px;
    font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    color: var(--color-forest, #0f6e56);
  }
  .ps-404__heading {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 4.4vw, 42px); line-height: 1.1; letter-spacing: -.01em;
    text-wrap: balance;
  }
  .ps-404__copy {
    margin: 0 0 28px; max-width: 60ch;
    font-size: 16px; line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink, #2c2c2a) 72%, transparent);
  }
  .ps-404__search { display: flex; gap: 8px; max-width: 460px; margin: 0 0 44px; }
  .ps-404__search input {
    flex: 1 1 auto; min-width: 0;
    padding: 11px 14px; font: inherit; font-size: 15px;
    border: 1px solid color-mix(in srgb, var(--color-ink, #2c2c2a) 22%, transparent);
    border-radius: 6px; background: #fff; color: inherit;
  }
  .ps-404__search button {
    flex: 0 0 auto; padding: 11px 20px; font: inherit; font-size: 15px; font-weight: 600;
    border: 0; border-radius: 6px; cursor: pointer;
    background: var(--color-forest, #0f6e56); color: #fff;
  }
  .ps-404__search button:hover { background: color-mix(in srgb, var(--color-forest, #0f6e56) 85%, #000); }
  .ps-404__grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px;
    padding-top: 32px;
    border-top: 1px solid color-mix(in srgb, var(--color-ink, #2c2c2a) 12%, transparent);
  }
  .ps-404__group h2 {
    margin: 0 0 12px;
    font-family: var(--font-body-family);
    font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: color-mix(in srgb, var(--color-ink, #2c2c2a) 55%, transparent);
  }
  .ps-404__group ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 9px; }
  .ps-404__group a { font-size: 15px; color: inherit; text-decoration: none; text-underline-offset: 3px; }
  .ps-404__group a:hover, .ps-404__group a:focus-visible { text-decoration: underline; }
  .ps-404__home {
    display: inline-block; margin-top: 40px;
    font-size: 15px; font-weight: 600; color: var(--color-forest, #0f6e56);
    text-underline-offset: 4px;
  }
</style>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page does not exist." },
    { "type": "textarea", "id": "copy", "label": "Body copy", "default": "The link may be out of date, or the address mistyped. Everything below is where the science actually lives." }
  ]
}
{% endschema %}
