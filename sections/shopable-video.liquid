{% if section.blocks.size > 0 %}
<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}">
  <div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">
    {% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment, underline: section.settings.heading_underline, underline_style: section.settings.underline_style, underline_color: section.settings.underline_color %}
    <div class="video-carousel" data-carousel>
      <div class="video-carousel__track" data-carousel-viewport style="--video-cols:{{ section.settings.desktop_items }};--video-gap:{{ section.settings.column_gap }}px">
        {% for block in section.blocks %}
          <article class="shop-video-card" {{ block.shopify_attributes }}>
            <div class="shop-video-card__media ratio-{{ section.settings.video_ratio }}" {% if section.settings.sticky_video %}data-sticky-video{% endif %}>
              {% if block.settings.video %}{{ block.settings.video | video_tag: autoplay: section.settings.autoplay, loop: true, muted: true, controls: true, poster: block.settings.poster, preload: 'metadata' }}
              {% elsif block.settings.poster %}{{ block.settings.poster | image_url:width:900 | image_tag: loading:'lazy', alt:block.settings.alt }}{% endif %}
            </div>
            {% if block.settings.product %}
              <div class="shop-video-card__product"><div><div class="eyebrow">Featured</div><a href="{{ block.settings.product.url }}"><strong>{{ block.settings.product.title }}</strong></a><div>{{ block.settings.product.price | money }}</div></div>
              <form action="{{ routes.cart_add_url }}" method="post"><input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}"><button class="icon-button quick-add" type="submit" aria-label="Add {{ block.settings.product.title | escape }}">+</button></form></div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
      {% if section.settings.show_navigation %}<div class="carousel-nav"><button type="button" data-carousel-dir="prev">‹</button><button type="button" data-carousel-dir="next">›</button></div>{% endif %}
    </div>
  </div>
</section>
{% endif %}
{% schema %}
{"name":"Shopable video","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"checkbox","id":"heading_underline","label":"Enable heading underline animation","default":true},{"type":"select","id":"underline_style","label":"Underline style","default":"curve","options":[{"value":"simple","label":"Simple"},{"value":"curve","label":"Curve stroke"},{"value":"squiggle","label":"Squiggle"}]},{"type":"color","id":"underline_color","label":"Underline color","default":"#171714"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"video_ratio","label":"Video ratio","default":"portrait","options":[{"value":"square","label":"Square"},{"value":"portrait","label":"Portrait"},{"value":"landscape","label":"Landscape"}]},{"type":"checkbox","id":"autoplay","label":"Video auto play","default":true},{"type":"checkbox","id":"sticky_video","label":"Enable video sticky","default":false},{"type":"range","id":"desktop_items","label":"Items per row on desktop","min":2,"max":4,"step":1,"default":4},{"type":"range","id":"column_gap","label":"Column gap","min":0,"max":40,"step":4,"default":16,"unit":"px"},{"type":"checkbox","id":"show_navigation","label":"Show navigation","default":true},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"blocks":[{"type":"video","name":"Video","settings":[{"type":"video","id":"video","label":"Local video"},{"type":"image_picker","id":"poster","label":"Poster image"},{"type":"text","id":"alt","label":"Video alt text"},{"type":"product","id":"product","label":"Product"}]}],"max_blocks":20,"presets":[{"name":"Shopable video"}]}
{% endschema %}
