<section class="section"><div class="container"><div class="mobile-facet-bar"><button class="button button--secondary" type="button" data-filter-open>Filter</button><span class="muted">{{ collection.products_count }} products</span></div><form class="facets" method="get"><div class="facets__filters">{% if section.settings.enable_filtering %}{% for filter in collection.filters %}<div class="facet"><details><summary>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary><div class="facet__panel">{% case filter.type %}{% when 'boolean','list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}> <span>{{ value.label }}{% if section.settings.show_counts %} ({{ value.count }}){% endif %}</span></label>{% endfor %}{% when 'price_range' %}<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><input class="product-select" name="{{ filter.min_value.param_name }}" type="number" placeholder="Min" value="{{ filter.min_value.value | money_without_currency | replace:',','' }}"><input class="product-select" name="{{ filter.max_value.param_name }}" type="number" placeholder="Max" value="{{ filter.max_value.value | money_without_currency | replace:',','' }}"></div>{% endcase %}<button class="button" type="submit" style="margin-top:10px;width:100%">Apply</button></div></details></div>{% endfor %}{% endif %}</div>{% if section.settings.enable_sorting %}<select class="sort-select" name="sort_by" onchange="this.form.submit()">{% assign sort_by=collection.sort_by | default:collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select>{% endif %}</form><aside class="filter-drawer" data-filter-drawer aria-label="Filters"><div class="filter-drawer__head"><strong>Filter & sort</strong><button class="icon-button" type="button" data-filter-close aria-label="Close">{% render 'icon', name:'close' %}</button></div><form method="get" class="filter-drawer__body">{% if section.settings.enable_sorting %}<label class="filter-drawer__sort">Sort by<select class="sort-select" name="sort_by">{% assign sort_by=collection.sort_by | default:collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label>{% endif %}{% if section.settings.enable_filtering %}{% for filter in collection.filters %}<details class="mobile-facet" {% if filter.active_values.size > 0 %}open{% endif %}><summary>{{ filter.label }}<span>+</span></summary><div class="mobile-facet__panel">{% case filter.type %}{% when 'boolean','list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}><span>{{ value.label }}</span><small>{{ value.count }}</small></label>{% endfor %}{% when 'price_range' %}<div class="price-range"><input class="product-select" name="{{ filter.min_value.param_name }}" type="number" placeholder="Min" value="{{ filter.min_value.value | money_without_currency | replace:',','' }}"><input class="product-select" name="{{ filter.max_value.param_name }}" type="number" placeholder="Max" value="{{ filter.max_value.value | money_without_currency | replace:',','' }}"></div>{% endcase %}</div></details>{% endfor %}{% endif %}<button class="button button--full filter-apply" type="submit">Show results</button></form></aside><div class="filter-drawer-backdrop" data-filter-close></div>{% paginate collection.products by section.settings.items_per_page %}<div class="grid psr-product-grid" style="--psr-columns:{{ section.settings.columns_desktop }};--psr-grid-gap:{% case section.settings.gap %}{% when 'none' %}0px{% when 'small' %}14px{% when 'large' %}40px{% else %}28px{% endcase %}">{% for product in collection.products %}{% render 'product-card', product:product %}{% else %}<div style="grid-column:1/-1;text-align:center;padding:80px 0"><h3>No products found</h3><p class="muted">Try adjusting your filters.</p></div>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></section>{% schema %}{"name":"Product grid","settings":[{"type":"range","id":"items_per_page","label":"Items to show per page","min":4,"max":24,"step":4,"default":12},{"type":"range","id":"columns_desktop","label":"Columns per row on desktop","min":2,"max":5,"default":4},{"type":"select","id":"gap","label":"Column gap","options":[{"value":"none","label":"No gap"},{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}],"default":"medium"},{"type":"checkbox","id":"enable_sorting","label":"Enable sorting","default":true},{"type":"checkbox","id":"enable_filtering","label":"Enable filtering","default":true},{"type":"checkbox","id":"show_counts","label":"Show product counts","default":true}],"presets":[{"name":"Product grid"}]}{% endschema %}