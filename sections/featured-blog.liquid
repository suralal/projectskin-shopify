<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}"><div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}{% assign selected_blog=section.settings.blog | default:blog %}{% if selected_blog %}<div class="grid grid-3 ps-blog-grid">{% for related_article in selected_blog.articles limit:6 %}{% unless related_article.id == article.id %}<article class="ps-blog-card">{% if related_article.image %}<a class="ps-blog-card__media" href="{{ related_article.url }}">{{ related_article.image | image_url:width:900 | image_tag:loading:'lazy' }}</a>{% endif %}<div class="ps-blog-card__copy"><h3><a href="{{ related_article.url }}">{{ related_article.title }}</a></h3><p>{{ related_article.excerpt_or_content | strip_html | truncatewords:20 }}</p></div></article>{% endunless %}{% endfor %}</div>{% endif %}</div></section>
{% schema %}{"name":"Featured blog","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false},{"type":"blog","id":"blog","label":"Blog"}],"presets":[{"name":"Featured blog"}]}{% endschema %}
