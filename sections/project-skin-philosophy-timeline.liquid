<section class="psr-route-fallback psr-route-fallback--philosophy psr-page psr-phil-timeline">
  <div class="container">
    <header class="psr-phil-head">
      <p class="psr-phil-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="psr-phil-head__copy rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="psr-phil-timeline__track" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign fallback = 'psr-philosophy-timeline-2023.jpg'
          if forloop.index == 2
            assign fallback = 'psr-philosophy-timeline-2024.jpg'
          elsif forloop.index == 3
            assign fallback = 'psr-philosophy-timeline-2025.jpg'
          elsif forloop.index == 4
            assign fallback = 'psr-philosophy-ritual.jpg'
          endif
        %}
        <article class="psr-phil-timeline__card" role="listitem" {{ block.shopify_attributes }}>
          <div class="psr-phil-timeline__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 22vw, 70vw', alt: block.settings.heading }}
            {% else %}
              <img src="{{ fallback | asset_url }}" width="720" height="960" loading="lazy" alt="{{ block.settings.heading | escape }}">
            {% endif %}
          </div>
          <p class="psr-phil-timeline__year">{{ block.settings.year }}</p>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy timeline",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story in time" },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>From a clearer standard for Indian skin to a connected system of guidance, formula and follow-through.</p>" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "year", "label": "Year", "default": "2023" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A clearer brief" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "We began with one idea: skincare advice should respect biology, climate and daily life." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy timeline",
      "blocks": [
        { "type": "milestone" },
        { "type": "milestone" },
        { "type": "milestone" }
      ]
    }
  ]
}
{% endschema %}
