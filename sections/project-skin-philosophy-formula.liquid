{% comment %}
  Formulation philosophy — Purpose · Precision · Performance
{% endcomment %}
<section id="project-skin-formula" class="psr-route-fallback psr-route-fallback--philosophy psr-page psr-phil-formula">
  <div class="container">
    <header class="psr-phil-head psr-phil-head--center">
      <p class="psr-phil-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="psr-phil-head__copy rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.mantra != blank %}
        <p class="psr-phil-formula__mantra">{{ section.settings.mantra }}</p>
      {% endif %}
    </header>

    <div class="psr-phil-formula__grid">
      {% for block in section.blocks %}
        <article class="psr-phil-formula__card" {{ block.shopify_attributes }}>
          <span class="psr-phil-formula__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="psr-phil-formula__cta">
        <a class="psr-phil-btn" href="{{ section.settings.cta_link | default: '/pages/ingredients' }}">{{ section.settings.cta_label }}</a>
        {% if section.settings.secondary_label != blank %}
          <a class="psr-phil-text-link" href="{{ section.settings.secondary_link | default: '/pages/the-science' }}">
            {{ section.settings.secondary_label }} <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Philosophy formula",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Formulation philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Right actives. Right technology. Real results." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Clinical evidence guides every decision. Actives are dosed to work — not to decorate a label.</p>"
    },
    { "type": "text", "id": "mantra", "label": "Mantra", "default": "Purpose. Precision. Performance." },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Meet the ingredients" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link", "default": "Explore the science" },
    { "type": "url", "id": "secondary_link", "label": "Secondary URL" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Science first" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Clinical evidence guides every formulation decision, at every step."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy formula",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
