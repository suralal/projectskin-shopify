<section class="ps-section ps-quiz" style="--ps-pad-top: {{ section.settings.padding_top }}px; --ps-pad-bottom: {{ section.settings.padding_bottom }}px">
  <purity-quiz class="ps-wrap ps-quiz__layout">
    <div class="ps-quiz__media">
      {% render 'purity-image', image: section.settings.image, fallback_asset: 'quiz-text.jpg', fallback_width: 1200, fallback_height: 900, alt: section.settings.heading, sizes: '(min-width: 800px) 55vw, 100vw' %}
    </div>
    <div class="ps-quiz__content">
      <span class="ps-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="ps-title">{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
      <div class="ps-quiz__options">
        {% for block in section.blocks %}<button class="ps-quiz__option" type="button" data-quiz-option data-quiz-result="{{ block.settings.result | escape }}" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><span aria-hidden="true">›</span></button>{% endfor %}
      </div>
      <div class="ps-quiz__result" data-quiz-result data-default-text="{{ section.settings.default_result | escape }}">{{ section.settings.default_result }}</div>
      <div><a class="ps-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></div>
    </div>
  </purity-quiz>
</section>

{% schema %}
{
  "name": "Purity quiz",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The editor's edit" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Find Your Routine" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Answer one quick question and discover a routine shaped around your skin.</p>" },
    { "type": "text", "id": "default_result", "label": "Default result message", "default": "Choose what your skin needs most today." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover My Match" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 76 }
  ],
  "blocks": [
    { "type": "option", "name": "Quiz option", "settings": [{ "type": "text", "id": "label", "label": "Option", "default": "Deep hydration" }, { "type": "text", "id": "result", "label": "Result message", "default": "A barrier-supporting hydration routine is your best match." }] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Purity quiz", "blocks": [{ "type": "option" }, { "type": "option" }, { "type": "option" }, { "type": "option" }] }]
}
{% endschema %}
