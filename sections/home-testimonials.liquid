<style>
  .testimonials-section {
    background-color: #FAF6F4;
    padding: 80px 0;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .testimonials-section {
      padding: 120px 0;
    }
  }

  .testimonials-header {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    margin-bottom: 48px;
  }
  @media (min-width: 768px) {
    .testimonials-header {
      padding: 0 40px;
    }
  }

  .testimonials-heading {
    color: #181818;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 12px 0;
  }
  @media (min-width: 768px) {
    .testimonials-heading {
      font-size: 36px;
    }
  }
  @media (min-width: 1024px) {
    .testimonials-heading {
      font-size: 40px;
    }
  }

  .testimonials-subheading {
    color: #181818;
    font-size: 16px;
    line-height: 1.5;
    max-width: 480px;
    margin: 0;
    opacity: 0.9;
  }
  @media (min-width: 768px) {
    .testimonials-subheading {
      font-size: 18px;
    }
  }

  /* Full Width Slider */
  .testimonials-slider-container {
    width: 100%;
    position: relative;
    padding: 10px 0;
  }
  
  .testimonials-track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: scrollTestimonials 35s linear infinite;
    padding: 0 12px;
  }
  .testimonials-track:hover {
    animation-play-state: paused;
  }

  @keyframes scrollTestimonials {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-50% - 12px)); }
  }

  /* Card Styling */
  .testimonial-card {
    background-color: #FFFFFF; /* Using #FFFFFF based on the design, despite typo in prompt */
    border-radius: 12px;
    padding: 24px;
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    border: 1px solid rgba(0,0,0,0.02);
  }
  @media (min-width: 768px) {
    .testimonial-card {
      width: 400px;
      padding: 40px;
    }
  }

  .t-card-header {
    color: #212121;
    font-size: 16px;
    font-weight: 500;
    font-style: italic;
    line-height: 1;
    letter-spacing: 0;
    margin: 0 0 16px 0;
  }

  .t-card-body {
    color: #4A4A4A;
    font-size: 13.53px;
    font-weight: 300;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: 0;
    margin: 0 0 32px 0;
    flex-grow: 1;
  }

  .t-card-footer {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 
      "pill pill"
      "avatar info";
    row-gap: 16px;
    column-gap: 12px;
    align-items: center;
    margin-top: auto;
  }
  @media (min-width: 768px) {
    .t-card-footer {
      display: flex;
      flex-wrap: nowrap;
      gap: 16px;
    }
  }

  .t-avatar {
    grid-area: avatar;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #E0E0E0;
    object-fit: cover;
    flex-shrink: 0;
  }

  .t-author-info {
    grid-area: info;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 120px;
  }

  .t-author-name {
    color: #212121;
    font-size: 15px;
    font-weight: 500;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: 0;
    margin: 0;
  }

  .t-author-date {
    color: #BCB3B3;
    font-size: 13px;
    margin: 0;
  }

  .t-pill {
    grid-area: pill;
    justify-self: start;
    margin-left: 0;
    background-color: #FFF4DA;
    border: 1px solid #FFDFDF;
    color: #212121;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 99px;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .t-pill {
      margin-left: auto;
      font-size: 12px;
      padding: 6px 12px;
    }
  }
</style>

