{% comment %}
  Feature landing — elegant hero + steps for Get Skin Smart destinations.
  Interactive tools can be plugged into the CTA / body later.
{% endcomment %}
{% liquid
  assign fallback = 'project-skin-consultation-hero.jpg'
  case section.settings.fallback_image
    when 'scan'
      assign fallback = 'psr-science-mission-scan.jpg'
    when 'quiz'
      assign fallback = 'quiz-face.jpg'
    when 'routine'
      assign fallback = 'psr-science-mission-routine.jpg'
    when 'philosophy'
      assign fallback = 'project-skin-philosophy-people.jpg'
    when 'lab'
      assign fallback = 'project-skin-philosophy-lab.jpg'
    else
      assign fallback = 'project-skin-consultation-hero.jpg'
  endcase
%}

<section
  class="ps-feat"
  id="FeatureLanding-{{ section.id }}"
  style="--ps-feat-top: {{ section.settings.padding_top }}px; --ps-feat-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ps-feat__hero">
    <div class="ps-feat__media" aria-hidden="true">
      {% render 'purity-image',
        image: section.settings.image,
        fallback_asset: fallback,
        fallback_width: 1800,
        fallback_height: 1200,
        alt: '',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
      %}
      <span class="ps-feat__shade"></span>
    </div>

    <div class="ps-feat__hero-copy">
      {% if section.settings.eyebrow != blank %}
        <p class="ps-feat__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="ps-feat__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="ps-feat__lede">{{ section.settings.text }}</p>
      {% endif %}
      <div class="ps-feat__actions">
        {% if section.settings.button_label != blank %}
          <a class="ps-feat__cta" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="ps-feat__ghost" href="{{ section.settings.secondary_link | default: '/' }}">
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}
      </div>
      {% if section.settings.note != blank %}
        <p class="ps-feat__note">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="ps-feat__panel">
      {% if section.settings.panel_heading != blank %}
        <h2 class="ps-feat__panel-heading">{{ section.settings.panel_heading }}</h2>
      {% endif %}
      {% if section.settings.panel_text != blank %}
        <p class="ps-feat__panel-text">{{ section.settings.panel_text }}</p>
      {% endif %}

      <div class="ps-feat__steps">
        {% for block in section.blocks %}
          <article class="ps-feat__step" {{ block.shopify_attributes }}>
            <span class="ps-feat__step-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Feature landing",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get skin smart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dermatologist consultation" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "A clearer conversation about what your skin is doing — and what to do next."
    },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Fallback image",
      "options": [
        { "value": "consultation", "label": "Consultation" },
        { "value": "scan", "label": "Skin scan / analysis" },
        { "value": "quiz", "label": "Quiz / face" },
        { "value": "routine", "label": "Routine" },
        { "value": "philosophy", "label": "People / philosophy" },
        { "value": "lab", "label": "Lab" }
      ],
      "default": "consultation"
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Continue" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Back to home" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    {
      "type": "text",
      "id": "note",
      "label": "Note under buttons",
      "default": "Interactive tools are coming next — this page is ready for them."
    },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "How it works" },
    {
      "type": "textarea",
      "id": "panel_text",
      "label": "Panel text",
      "default": "Three simple steps. No account required to explore."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Share your context" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Tell us the concern, climate, and what you already use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature landing",
      "blocks": [
        { "type": "step", "settings": { "heading": "Share your context", "text": "Tell us the concern, climate, and what you already use." } },
        { "type": "step", "settings": { "heading": "Get a clear read", "text": "We map your inputs to biology and environment — not trends." } },
        { "type": "step", "settings": { "heading": "Leave with a plan", "text": "A practical next step you can actually follow." } }
      ]
    }
  ]
}
{% endschema %}
