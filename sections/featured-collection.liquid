<section class="section {% if section.settings.section_width == 'full' %}full{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.show_divider %}border-top:1px solid var(--line);{% endif %}"><div class="{% unless section.settings.section_width == 'full' %}container{% endunless %}">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment %}{% assign c=section.settings.collection %}{% if c != blank %}<div class="grid grid-4">{% for product in c.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</div></section>
{% schema %}{"name":"Featured collection","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Maximum items to show","min":2,"max":12,"step":1,"default":8}],"presets":[{"name":"Featured collection"}]}{% endschema %}