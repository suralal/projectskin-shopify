<article class="ps-template ps-article">
  <div class="container ps-article__head">
    <a class="ps-eyebrow" href="{{ blog.url }}">{{ blog.title }}</a>
    <h1>{{ article.title }}</h1>
    <div class="ps-article__meta">
      {% if section.settings.show_author %}<span>{{ article.author }}</span>{% endif %}
      {% if section.settings.show_date %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>{% endif %}
    </div>
  </div>

  {% if article.image %}
    <div class="container ps-article__hero">
      {{ article.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700,1100,1600,2200', sizes: '(max-width: 1499px) 100vw, 1440px' }}
    </div>
  {% endif %}

  <div class="container ps-article__body">
    <div class="rte">{{ article.content }}</div>
    {% render 'article-education-cta', article: article %}
    {% if section.settings.show_share %}
      <div class="ps-article__share">
        <span>Share this story</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener">Facebook</a>
        <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener">Pinterest</a>
      </div>
    {% endif %}
  </div>

  <nav class="container ps-article__nav" aria-label="More articles">
    {% if blog.previous_article %}<a href="{{ blog.previous_article.url }}"><span>Previous</span><strong>{{ blog.previous_article.title }}</strong></a>{% endif %}
    {% if blog.next_article %}<a href="{{ blog.next_article.url }}"><span>Next</span><strong>{{ blog.next_article.title }}</strong></a>{% endif %}
  </nav>
</article>

{% schema %}
{
  "name": "Blog post",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share links", "default": true }
  ]
}
{% endschema %}
