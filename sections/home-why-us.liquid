<style>
  .home-why-us {
    background: linear-gradient(180deg, #FFFFFF 0%, #FAF6F4 51.41%);
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .why-heading {
    font-weight: 600;
    font-size: 48px;
    line-height: 110%;
    color: #181818;
  }
  .why-subheading {
    font-weight: 400;
    font-size: 18px;
    color: #1B1813;
  }
  
  /* Floating Animation for Products */
  @keyframes floatAnimation {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
    100% { transform: translateY(0px); }
  }
  .why-float-1 {
    animation: floatAnimation 5s ease-in-out infinite;
  }
  .why-float-2 {
    animation: floatAnimation 6s ease-in-out infinite 1s; /* Slightly delayed */
  }

  /* List Item active states */
  .why-list-item .why-content {
    position: relative;
    padding-left: 24px; /* Matches tailwind pl-6 */
  }
  .why-list-item .why-content::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: #DFDFDF;
    border-radius: 9999px; /* Rounded top and bottom */
    transition: background-color 0.3s ease;
  }
  .why-list-item.active .why-content::before {
    background-color: var(--color-primary);
  }
  
  .why-list-item .why-details {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
    visibility: hidden;
  }
  .why-list-item.active .why-details {
    max-height: 150px;
    opacity: 1;
    margin-top: 8px;
    visibility: visible;
  }

  /* Shadows */
  .why-floor-shadow {
    position: absolute;
    bottom: -2%;
    left: 20%;
    width: 60%;
    height: 35px;
    background-color: rgba(220, 200, 200, 0.4);
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
    filter: blur(8px);
  }

  @media (max-width: 1024px) {
    .why-heading { font-size: 36px; }
  }
  @media (max-width: 768px) {
    .why-heading { font-size: 30px; }
    .why-subheading { font-size: 16px; }
  }
</style>

