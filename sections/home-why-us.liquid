<script>
  (function() {
    function initWhyUsAnimation() {
      const container = document.querySelector('.why-features-container');
      if (!container) return;
      
      const items = container.querySelectorAll('.why-list-item');
      if (items.length === 0) return;

      // Clear existing interval to prevent overlapping timers
      if (window.whyUsInterval) {
        clearInterval(window.whyUsInterval);
      }

      let currentIndex = 0;

      const activateItem = (index) => {
        items.forEach(item => item.classList.remove('active'));
        items[index].classList.add('active');
        currentIndex = index;
      };

      const nextItem = () => {
        let nextIndex = currentIndex + 1;
        if (nextIndex >= items.length) nextIndex = 0;
        activateItem(nextIndex);
      };

      const startInterval = () => {
        window.whyUsInterval = setInterval(nextItem, 3500);
      };

      // Since Shopify replaces the DOM on section reload, we can safely attach listeners directly
      items.forEach((item, index) => {
        item.addEventListener('click', () => {
          activateItem(index);
          clearInterval(window.whyUsInterval);
          startInterval(); // Restart the timer
        });
      });

      activateItem(0);
      startInterval();
    }

    // Run immediately on load
    initWhyUsAnimation();

    // Re-run if Shopify Theme Editor reloads the section
    document.addEventListener('shopify:section:load', initWhyUsAnimation);
  })();
</script>


