{% if section.settings.enable_cart_drawer %}{% render 'cart-drawer' %}{% endif %}
{% if section.settings.enable_quick_shop %}{% render 'quick-shop-modal' %}{% endif %}
{% if section.settings.enable_media_lightbox %}{% render 'media-lightbox' %}{% endif %}
{% if section.settings.enable_search %}{% render 'predictive-search' %}{% endif %}

{% schema %}
{
  "name": "Store overlays",
  "settings": [
    { "type": "checkbox", "id": "enable_search", "label": "Enable search overlay", "default": true },
    { "type": "checkbox", "id": "enable_cart_drawer", "label": "Enable cart drawer", "default": true },
    { "type": "checkbox", "id": "enable_quick_shop", "label": "Enable quick shop", "default": true },
    { "type": "checkbox", "id": "enable_media_lightbox", "label": "Enable product media lightbox", "default": true }
  ]
}
{% endschema %}
