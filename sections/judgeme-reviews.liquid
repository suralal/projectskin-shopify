<section
  class="pdp-section pdp-reviews-judgeme page-width-pdp"
  id="PdpReviews"
  style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"
>
  {% liquid
    assign review_count = 0
    if product.metafields.judgeme.review_widget_data contains '"number_of_reviews":'
      assign rw_count = product.metafields.judgeme.review_widget_data | split: '"number_of_reviews":' | last | split: ',' | first | split: '}' | first | strip | plus: 0
      if rw_count > 0
        assign review_count = rw_count
      endif
    endif
    if review_count == 0 and product.metafields.judgeme.widget contains 'data-number-of-reviews="'
      assign review_count_chunk = product.metafields.judgeme.widget | split: 'data-number-of-reviews="' | last | split: '"' | first | plus: 0
      if review_count_chunk > 0
        assign review_count = review_count_chunk
      endif
    endif
    if review_count == 0 and product.metafields.judgeme.all_reviews_count != blank
      assign jm_all_count = product.metafields.judgeme.all_reviews_count.value | default: product.metafields.judgeme.all_reviews_count | plus: 0
      if jm_all_count > 0
        assign review_count = jm_all_count
      endif
    endif
    if review_count == 0 and product.metafields.reviews.rating_count != blank
      assign sf_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
      if sf_count > 0
        assign review_count = sf_count
      endif
    endif
    if shop.metafields.judgeme.shop_reviews_count != blank
      assign shop_review_count = shop.metafields.judgeme.shop_reviews_count | plus: 0
    else
      assign shop_review_count = 0
    endif
    assign show_fallback = false
    if section.settings.show_fallback_when_empty and review_count == 0
      assign show_fallback = true
    endif
  %}

  {% if section.settings.heading != blank %}
    <header class="pdp-section-head pdp-reviews-head">
      {% if section.settings.eyebrow != blank %}<p class="pdp-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p class="pdp-reviews-judgeme__intro">{{ section.settings.intro }}</p>
      {% endif %}
      <div class="pdp-reviews-head__action">
        <button
          type="button"
          class="pdp-reviews__write-trigger-btn"
          data-write-review-trigger
          data-product-id="{{ product.id }}"
          data-fallback-url="https://api.judge.me/storefront_reviews/new?shop_domain={{ shop.permanent_domain | default: 'q9wi15-80.myshopify.com' }}&platform=shopify&product_id={{ product.id }}"
          aria-label="Write a verified review for {{ product.title | escape }}"
        >
          {% render 'icon', name: 'edit' %}
          <span>Write a review</span>
        </button>
      </div>
    </header>
  {% endif %}

  {% if show_fallback %}
    {% render 'product-reviews-fallback', product: product %}
  {% endif %}

  <!-- Start of Judge.me code -->
  {% assign has_legacy = false %}
  {% if product.metafields.judgeme.widget.size > 20 %}
    {% assign has_legacy = true %}
  {% endif %}
  <div style="clear:both"></div>
  {% if show_fallback %}
    <div class="pdp-reviews-judgeme__verified">
      <p>Verified reviews live in Judge.me. Leave the first published review — it replaces early notes automatically.</p>
    </div>
  {% endif %}
  <div
    id="judgeme_product_reviews"
    class="jdgm-widget jdgm-review-widget{% if show_fallback %} jdgm-widget--with-fallback{% endif %}"
    data-product-title="{{ product.title | escape }}"
    data-id="{{ product.id }}"
    data-product-id="{{ product.id }}"
    data-widget="review"
    data-auto-install="false"
    data-shop-reviews-count="{{ shop_review_count | escape }}"
    data-entry-point="review_widget.js"
    data-entry-key="review-widget/main.js"
  >
    {% if has_legacy %}
      <div class="jdgm-legacy-widget-content" style="display: none;">{{ product.metafields.judgeme.widget }}</div>
    {% endif %}
  </div>
  {% if product.metafields.judgeme.review_widget_data %}
    <script>
      jdgm = window.jdgm || {};
      jdgm.data = jdgm.data || {};
      jdgm.data.reviewWidget = jdgm.data.reviewWidget || {};
      jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
    </script>
  {% endif %}
  <!-- End of Judge.me code -->
  <style>
    /* Scoped override for Judge.me widget styles */
    #PdpReviews .jm-review-widget-minimal-header__title,
    #PdpReviews .jdgm-rev-widg__title {
      display: none !important;
    }
    #PdpReviews .jm-review-widget {
      --jm-review-widget-star-and-histogram-color: #ee9b00 !important;
      --jm-review-widget-button-color: #111827 !important;
      --jm-review-widget-button-text-color: #ffffff !important;
      --jm-widget-primary-color: #111827 !important;
    }
    #PdpReviews .jm-star-rating__font-icon,
    #PdpReviews .jm-star-rating,
    #PdpReviews .jdgm-star,
    #PdpReviews .jdgm-rev-widg .jdgm-star,
    #PdpReviews .jdgm-preview-badge .jdgm-star,
    #PdpReviews .jdgm-rev__rating .jdgm-star,
    #PdpReviews .jdgm-histogram .jdgm-star,
    #PdpReviews .jdgm-rev-widg__summary-stars .jdgm-star,
    #PdpReviews .jdgm-star.jdgm--on:before,
    #PdpReviews .jdgm-star.jdgm--half:before,
    #PdpReviews .jdgm-star:before {
      color: #ee9b00 !important;
      --17d289b0: #ee9b00 !important;
    }
    #PdpReviews .jdgm-star.jdgm--off:before {
      color: #e5e7eb !important;
    }
    #PdpReviews .jm-reviewer-avatar,
    #PdpReviews .jdgm-rev__icon {
      background-color: #f3f4f6 !important;
      color: #1f2937 !important;
      border-radius: 50% !important;
      font-weight: 600 !important;
    }
    #PdpReviews .jm-reviewer-avatar__initial .jm-text {
      color: #111827 !important;
      font-weight: 600 !important;
    }
    #PdpReviews .jm-review-widget__header,
    #PdpReviews .jdgm-rev-widg__header {
      border-bottom: 1px solid #e5e1d8 !important;
      padding-bottom: 20px !important;
      margin-bottom: 24px !important;
    }
  </style>
</section>

{% schema %}
{
  "name": "Judge.me reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer reviews" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Texture, climate, and consistency — from people building the same routine." },
    { "type": "checkbox", "id": "show_fallback_when_empty", "label": "Show curated feedback when Judge.me has 0 reviews", "default": true },
    { "type": "paragraph", "content": "Requires the Judge.me app for verified reviews and write-a-review. Fallback cards appear only while the product has zero published reviews." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 68 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Judge.me reviews" }]
}
{% endschema %}
