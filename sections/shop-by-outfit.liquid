<section class="section"><div class="container">{% render 'section-head', subheading:section.settings.subheading, heading:section.settings.heading, description:section.settings.description, alignment:section.settings.alignment %}<div class="grid grid-2 mobile-1"><div class="card" style="position:relative">{% if section.settings.image %}{{ section.settings.image | image_url:width:1400 | image_tag }}{% endif %}{% for block in section.blocks %}<a class="pointer" href="{{ block.settings.product.url }}" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%">+</a>{% endfor %}</div><div>{% for block in section.blocks %}{% if block.settings.product %}<p><a href="{{ block.settings.product.url }}">{{ block.settings.product.title }} — {{ block.settings.product.price | money }}</a></p>{% endif %}{% endfor %}</div></div></div></section>{% schema %}{"name":"Shop by outfit","settings":[{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"image_picker","id":"image","label":"Image"}],"blocks":[{"type":"product","name":"Product hotspot","settings":[{"type":"product","id":"product","label":"Product"},{"type":"range","id":"x","label":"Horizontal position","min":0,"max":100,"step":1,"default":50,"unit":"%"},{"type":"range","id":"y","label":"Vertical position","min":0,"max":100,"step":1,"default":50,"unit":"%"}]}],"presets":[{"name":"Shop by outfit"}]}{% endschema %}