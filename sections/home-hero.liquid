<style>
  .home-hero-slider {
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .hero-swiper {
    overflow: hidden !important;
    width: 100%;
  }

  .home-hero-slide {
    position: relative;
    height: 420px;
    overflow: hidden;
    border-radius: 32px;
    z-index: 1;
  }

  .hi{}
  
  @media (min-width: 768px) {
    .home-hero-slide {
      height: 460px;
    }
  }
  @media (min-width: 1024px) {
    .home-hero-slide {
      height: 520px;
    }
  }

  /* Small screen responsive adjustments */
  @media (max-width: 768px) {
    .home-hero-slide {
      height: 380px;
      border-radius: 20px;
    }
    .hero-heading {
      font-size: 32px !important;
      line-height: 1.15 !important;
      margin-bottom: 12px !important;
    }
    .hero-heading * {
      font-size: inherit !important;
      line-height: inherit !important;
    }
    .hero-paragraph, .hero-paragraph * {
      font-size: 15px !important;
      line-height: 1.4 !important;
      margin-bottom: 0 !important;
    }
    .hero-paragraph {
      margin-bottom: 20px !important;
    }
    .hero-btn-primary, .hero-btn-secondary {
      font-size: 14px;
      padding: 10px 16px;
      flex: 0 1 auto;
      text-align: center;
      justify-content: center;
      white-space: nowrap;
    }
    .hero-pill {
      font-size: 12px;
      padding: 6px 12px;
      margin-bottom: 12px;
    }
    .hero-bg-text {
      font-size: 48vw;
    }
    .home-hero-slide::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      z-index: 10;
      pointer-events: none;
    }
  }
  @media (min-width: 769px) {
    .home-hero-slide::before {
      display: none;
    }
  }


  /* Background Text */
  .hero-bg-text {
    position: absolute;
    top: 78%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 18vw;
    font-weight: 800;
    line-height: 1;
    z-index: 1;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Typography */
  .hero-heading {
    font-weight: 600;
    font-size: 38px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #231B15;
  }
  @media (min-width: 768px) {
    .hero-heading {
      font-size: 46px;
    }
  }
  @media (min-width: 1024px) {
    .hero-heading {
      font-size: 54px;
    }
  }

  .hero-paragraph {
    font-weight: 400;
    font-size: 16px;
    color: #231B15;
  }

  .hero-feature-text {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 1.3;
    color: #630D2D;
  }
  @media (min-width: 768px) {
    .hero-feature-text {
      font-size: 15px;
      line-height: 1.2;
    }
  }

  .hero-btn-primary, .hero-btn-secondary {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.2s ease;
  }

  .hero-btn-primary {
    background-color: var(--color-primary, #FF338F);
  }
  .hero-btn-primary:hover {
    background-color: color-mix(in srgb, var(--color-primary, #FF338F) 85%, black);
  }

  .hero-btn-secondary {
    background-color: transparent;
    border: 1px solid #222;
    color: #222;
  }
  .hero-btn-secondary:hover {
    background-color: #000;
    color: #fff;
  }
  
  .hero-btn-secondary.has-bg {
    background-color: rgba(255,255,255,0.4);
    border-color: rgba(255,255,255,0.8);
  }
  .hero-btn-secondary.has-bg:hover {
    background-color: #000;
    color: #fff;
    border-color: #000;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background-color: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 40px;
    font-size: 14px;
    font-weight: 500;
    color: #4a0d22;
    margin-bottom: 24px;
  }

  /* Full Banner Background Artwork */
  .hero-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center; /* keeps focus on the right side if cropped */
    z-index: 0;
    pointer-events: none;
    will-change: transform;
  }

  /* Absolute Model Image */
  .hero-absolute-image {
    position: absolute;
    bottom: 0;
    right: -4%;
    height: 100%;
    width: auto;
    max-width: 65%;
    object-fit: contain;
    object-position: bottom right;
    z-index: 2;
    pointer-events: none;
    will-change: transform;
  }

  @media (max-width: 1024px) {
    .hero-absolute-image {
      max-width: 55%;
      height: 85%;
      right: -2%;
    }
  }

  @media (max-width: 768px) {
    .hero-absolute-image {
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
      opacity: 0.3;
      z-index: 0;
      right: 0;
    }
  }

  /* Responsive typography */
  @media (max-width: 768px) {
    .hero-paragraph { font-size: 15px; }
    .hero-btn-primary, .hero-btn-secondary { font-size: 14px; }
    .hero-bg-text { font-size: 32vw; }
  }

  /* Pagination Dots */
  .swiper-horizontal > .hero-pagination,
  .hero-pagination.swiper-pagination-bullets,
  .hero-pagination {
    display: flex !important;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 100%;
    position: absolute;
    --swiper-pagination-bottom: 24px !important;
    bottom: var(--swiper-pagination-bottom, 24px) !important;
    left: 0;
    z-index: 30;
  }
  @media (min-width: 768px) {
    .swiper-horizontal > .hero-pagination,
    .hero-pagination.swiper-pagination-bullets,
    .hero-pagination {
      --swiper-pagination-bottom: 32px !important;
      bottom: var(--swiper-pagination-bottom, 32px) !important;
    }
  }

  .hero-pagination .swiper-pagination-bullet {
    width: 5px;
    height: 5px;
    border-radius: 99px;
    background-color: rgba(0, 0, 0, 0.12);
    opacity: 1;
    cursor: pointer;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                background-color 0.3s ease;
    border: none;
    outline: none;
    padding: 0;
    display: block;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero-pagination .swiper-pagination-bullet {
      width: 6px;
      height: 6px;
    }
  }

  .hero-pagination .swiper-pagination-bullet-active {
    width: 22px;
    background-color: rgba(0, 0, 0, 0.1);
  }
  @media (min-width: 768px) {
    .hero-pagination .swiper-pagination-bullet-active {
      width: 28px;
    }
  }

  .hero-pagination .swiper-pagination-bullet-active::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    border-radius: 99px;
    background-color: rgba(0, 0, 0, 0.5);
    animation: heroDotFill 5000ms linear forwards;
  }

  @keyframes heroDotFill {
    0% { width: 0%; }
    100% { width: 100%; }
  }

</style>

