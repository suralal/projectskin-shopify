<section class="section finder-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: section.settings.alignment, underline: section.settings.heading_underline, underline_style: section.settings.underline_style, underline_color: section.settings.underline_color %}
    {% if section.blocks.size > 0 %}
      <div class="finder finder--{{ section.settings.tab_style }}" data-tabs-root>
        <div class="finder-tabs">{% for block in section.blocks %}<button class="finder-tab {% if forloop.first %}active{% endif %}" type="button" data-tab="{{ block.id }}">{% if block.settings.image %}<span class="finder-thumb">{{ block.settings.image | image_url: width:220 | image_tag: loading:'lazy' }}</span>{% endif %}<span>{{ block.settings.title | default:block.settings.collection.title }}</span></button>{% endfor %}</div>
        {% for block in section.blocks %}<div class="finder-panel" data-panel="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}><div class="grid grid-4 product-grid-home">{% for product in block.settings.collection.products limit: section.settings.max_items %}{% render 'product-card', product:product %}{% endfor %}</div></div>{% endfor %}
      </div>
    {% else %}
      <div class="finder-tabs finder-tabs--fallback"><span class="finder-tab active">Hydration</span><span class="finder-tab">Brightening</span><span class="finder-tab">Acne care</span><span class="finder-tab">Barrier care</span></div>
      <div class="grid grid-4 product-grid-home">{% for product in collections['all'].products limit:4 %}{% render 'product-card', product:product %}{% endfor %}</div>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Suitable products finder","tag":"section","class":"section-wrapper","settings":[{"type":"select","id":"section_width","label":"Section width","default":"fixed","options":[{"value":"fixed","label":"Fixed width"},{"value":"stretch","label":"Stretch width"},{"value":"full","label":"Full width"}]},{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"checkbox","id":"heading_underline","label":"Enable heading underline animation","default":true},{"type":"select","id":"underline_style","label":"Underline style","default":"curve","options":[{"value":"simple","label":"Simple"},{"value":"curve","label":"Curve stroke"},{"value":"squiggle","label":"Squiggle"}]},{"type":"color","id":"underline_color","label":"Underline color","default":"#171714"},{"type":"richtext","id":"description","label":"Description"},{"type":"select","id":"alignment","label":"Alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"media_style","label":"Media style","default":"rounded","options":[{"value":"default","label":"Default"},{"value":"rounded","label":"Rounded"},{"value":"oval","label":"Oval"}]},{"type":"select","id":"tab_style","label":"Collection tab style","default":"color","options":[{"value":"color","label":"Color picker"},{"value":"range","label":"Range slider"}]},{"type":"checkbox","id":"inline_heading","label":"Inline with heading","default":false},{"type":"checkbox","id":"show_color_dot","label":"Show color dot","default":true},{"type":"range","id":"max_items","label":"Maximum items to show","min":2,"max":12,"step":1,"default":8},{"type":"range","id":"desktop_items","label":"Items per row on desktop","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"column_gap","label":"Column gap","min":0,"max":40,"step":4,"default":20,"unit":"px"},{"type":"checkbox","id":"show_navigation","label":"Show navigation","default":true},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":64,"unit":"px"},{"type":"checkbox","id":"show_divider","label":"Show divider","default":false}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title"},{"type":"color","id":"color","label":"Color","default":"#d8c2aa"}]}],"max_blocks":12,"presets":[{"name":"Suitable products finder"}]}
{% endschema %}
