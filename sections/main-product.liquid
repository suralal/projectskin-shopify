{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign display_title = product.title
  assign display_price = current_variant.price | money
  assign display_description = section.settings.product_description
  assign display_inventory_text = 'In stock and ready to ship'
  assign display_inventory_tone = 'available'
  if section.settings.use_custom_content
    assign display_title = section.settings.title_override | default: product.title
    assign display_price = section.settings.price_override | default: display_price
  endif
  if display_description == blank
    capture catalog_description
      render 'product-description-catalog', product: product
    endcapture
    assign catalog_description = catalog_description | strip
    if catalog_description != blank
      assign display_description = catalog_description
    else
      assign display_description = product.description
    endif
  endif
  unless current_variant.available
    assign display_inventory_text = 'Currently unavailable'
    assign display_inventory_tone = 'low'
  else
    if current_variant.inventory_management and current_variant.inventory_policy != 'continue' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10
      assign display_inventory_text = 'Only ' | append: current_variant.inventory_quantity | append: ' left in stock'
      assign display_inventory_tone = 'low'
    endif
  endunless
  assign highlight_blocks = section.blocks | where: 'type', 'highlight'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign outcome_blocks = section.blocks | where: 'type', 'outcome'
  assign action_blocks = section.blocks | where: 'type', 'action_video'
  assign accordion_blocks = section.blocks | where: 'type', 'accordion'
  assign pair_blocks = section.blocks | where: 'type', 'pair'
  capture product_palette
    render 'product-palette-name', product: product
  endcapture
  assign product_palette = product_palette | strip | default: 'brand'
  assign concern_line = section.settings.concern_line
  if concern_line == blank
    capture concern_line
      render 'product-concern-line', product: product
    endcapture
    assign concern_line = concern_line | strip
  endif
%}

<section class="pdp-main pdp-main--{{ section.settings.gallery_layout }}" data-product-section data-pdp-root data-product-palette="{{ product_palette }}">
  <div class="pdp-breadcrumb page-width-pdp">
    <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span>{{ display_title }}</span>
  </div>

  <div class="pdp-main__grid page-width-pdp">
    {% if section.settings.gallery_layout == 'thumbnails' %}
      {% render 'pdp-thumbnail-gallery', section: section, product: product, display_title: display_title %}
    {% else %}
    <div class="pdp-gallery" data-product-gallery>
      {% if section.settings.use_product_media and product.media.size > 0 and product.handle != '5-niacinamide-serum-acne-prone-skin' and product.handle != 'calming-moisturiser-acne-prone-skin' and product.handle != 'refreshing-cleanser-acne-prone-skin' and product.handle != 'protecting-sunscreen-acne-prone-skin' and product.handle != 'clear-seal' and product.handle != 'active-boba-encapsulated-cream-acne-prone-skin' and product.handle != 'project-skin-complete-4-step-skincare-routine-kit' %}
        {% for media in product.media %}
          <div class="pdp-gallery__item{% if forloop.index > 1 and forloop.index < 4 %} pdp-gallery__item--half{% endif %}" data-product-media>
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1600', sizes: '(min-width: 990px) 50vw, 92vw', alt: display_title }}
                {% if section.settings.enable_zoom %}<button class="pdp-gallery__zoom" type="button" data-media-zoom aria-label="Zoom image">{% render 'icon', name: 'zoom' %}</button>{% endif %}
              {% when 'video' %}{{ media | video_tag: controls: true, autoplay: false, loop: true, muted: true, preload: 'metadata', playsinline: true }}
              {% when 'external_video' %}{{ media | external_video_tag }}
              {% else %}{{ media | media_tag }}
            {% endcase %}
          </div>
        {% endfor %}
        {% render 'product-extra-media', product: product, mode: 'gallery-grid', display_title: display_title, enable_zoom: section.settings.enable_zoom %}
      {% else %}
        {% assign curated_extras = false %}
        {% if product.handle == '5-niacinamide-serum-acne-prone-skin' or product.handle == 'calming-moisturiser-acne-prone-skin' or product.handle == 'refreshing-cleanser-acne-prone-skin' or product.handle == 'protecting-sunscreen-acne-prone-skin' or product.handle == 'clear-seal' or product.handle == 'active-boba-encapsulated-cream-acne-prone-skin' or product.handle == 'project-skin-complete-4-step-skincare-routine-kit' %}
          {% assign curated_extras = true %}
        {% endif %}
        {% if curated_extras %}
          {% render 'product-extra-media', product: product, mode: 'gallery-grid', display_title: display_title, enable_zoom: section.settings.enable_zoom %}
        {% else %}
        <div class="pdp-gallery__item" data-product-media>
          {% render 'purity-image', image: section.settings.main_image, fallback_asset: 'pdp-lash-main.jpg', fallback_width: 900, fallback_height: 1200, loading: 'eager', fetchpriority: 'high', alt: display_title, sizes: '(min-width: 990px) 50vw, 92vw' %}
          {% if section.settings.enable_zoom %}<button class="pdp-gallery__zoom" type="button" data-media-zoom aria-label="Zoom image">{% render 'icon', name: 'zoom' %}</button>{% endif %}
        </div>
        <div class="pdp-gallery__item pdp-gallery__item--half" data-product-media>
          {% render 'purity-image', image: section.settings.detail_image_1, fallback_asset: 'pdp-lash-eye-1.jpg', fallback_width: 900, fallback_height: 1200, alt: display_title, sizes: '(min-width: 990px) 25vw, 92vw' %}
          {% if section.settings.enable_zoom %}<button class="pdp-gallery__zoom" type="button" data-media-zoom aria-label="Zoom image">{% render 'icon', name: 'zoom' %}</button>{% endif %}
        </div>
        <div class="pdp-gallery__item pdp-gallery__item--half" data-product-media>
          {% render 'purity-image', image: section.settings.detail_image_2, fallback_asset: 'pdp-action-2.jpg', fallback_width: 1080, fallback_height: 1628, alt: display_title, sizes: '(min-width: 990px) 25vw, 92vw' %}
          {% if section.settings.enable_zoom %}<button class="pdp-gallery__zoom" type="button" data-media-zoom aria-label="Zoom image">{% render 'icon', name: 'zoom' %}</button>{% endif %}
        </div>
        <div class="pdp-gallery__item" data-product-media>
          {% render 'purity-image', image: section.settings.detail_image_3, fallback_asset: 'pdp-lash-eye-2.jpg', fallback_width: 900, fallback_height: 1200, alt: display_title, sizes: '(min-width: 990px) 50vw, 92vw' %}
          {% if section.settings.enable_zoom %}<button class="pdp-gallery__zoom" type="button" data-media-zoom aria-label="Zoom image">{% render 'icon', name: 'zoom' %}</button>{% endif %}
        </div>
        {% endif %}
      {% endif %}
    </div>
    {% endif %}

    <div class="pdp-info">
      {% form 'product', product, id: product_form_id, data-product-form: '', data-main-product-form: '' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <script type="application/json" data-product-json>{{ product | json }}</script>

        <header class="pdp-info__header">
          {% if concern_line != blank %}
            <p class="pdp-concern">{{ concern_line }}</p>
          {% endif %}
          <h1>{{ display_title }}</h1>
          {% capture mechanism_line %}{% render 'product-mechanism-line', product: product %}{% endcapture %}
          {% assign mechanism_line = mechanism_line | strip %}
          {% if section.settings.mechanism_line != blank %}
            {% assign mechanism_line = section.settings.mechanism_line %}
          {% endif %}
          {% if mechanism_line != blank %}
            <p class="pdp-mechanism">{{ mechanism_line }}</p>
          {% endif %}
          {% if section.settings.use_judgeme_rating %}
            <div class="pdp-rating pdp-rating--judgeme">
              <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
                {{ product.metafields.judgeme.badge }}
              </div>
            </div>
          {% elsif section.settings.show_rating %}
            <div class="pdp-rating" aria-label="{{ section.settings.rating }} out of 5 stars">
              <span class="pdp-stars" aria-hidden="true">★★★★★</span>
              <strong>{{ section.settings.rating }}</strong>
              <a href="#PdpReviews">({{ section.settings.review_count }} reviews)</a>
            </div>
          {% endif %}
          <div class="pdp-price" {% unless section.settings.use_custom_content %}data-product-price{% endunless %}>{{ display_price }}</div>
          <p class="pdp-tax">Taxes included. <a href="{{ shop.shipping_policy.url }}">Shipping</a> calculated at checkout.</p>
        </header>

        {% if section.settings.show_demo_swatches %}
          <fieldset class="pdp-swatches" data-pdp-swatches>
            <legend>Color: <strong data-pdp-swatch-label>{{ section.settings.swatch_1_label }}</strong></legend>
            <div>
              <label title="{{ section.settings.swatch_1_label }}"><input type="radio" name="display-color-{{ section.id }}" value="{{ section.settings.swatch_1_label }}" checked><span style="--swatch: {{ section.settings.swatch_1_color }}"></span></label>
              <label title="{{ section.settings.swatch_2_label }}"><input type="radio" name="display-color-{{ section.id }}" value="{{ section.settings.swatch_2_label }}"><span style="--swatch: {{ section.settings.swatch_2_color }}"></span></label>
            </div>
          </fieldset>
        {% elsif section.settings.show_variant_picker and product.has_only_default_variant == false %}
          {% for option in product.options_with_values %}
            <fieldset class="pdp-variants">
              <legend>{{ option.name }}: <strong>{{ option.selected_value }}</strong></legend>
              <div>{% for value in option.values %}<label><input type="radio" name="option-{{ option.position }}-{{ section.id }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}><span>{{ value }}</span></label>{% endfor %}</div>
            </fieldset>
          {% endfor %}
        {% endif %}

        <div class="pdp-inventory pdp-inventory--{{ display_inventory_tone }}"><span></span>{{ display_inventory_text }}</div>
        {% if section.settings.show_purchase_options %}
        <div class="pdp-purchase" data-pdp-purchase>
          <label class="pdp-purchase__option is-active"><input type="radio" name="purchase-choice-{{ section.id }}" value="one-time" checked><span>{{ section.settings.one_time_label }}</span><strong>{{ display_price }}</strong></label>
          <label class="pdp-purchase__option"><input type="radio" name="purchase-choice-{{ section.id }}" value="subscribe"><span>{{ section.settings.subscribe_label }}</span><strong>{{ section.settings.subscribe_price }} <s>{{ display_price }}</s></strong></label>
          <div class="pdp-purchase__frequency" data-pdp-frequency hidden>
            {% assign allocations = current_variant.selling_plan_allocations %}
            {% if allocations.size > 0 %}
              <select name="selling_plan" aria-label="Subscription delivery frequency">{% for allocation in allocations %}<option value="{{ allocation.selling_plan.id }}">{{ allocation.selling_plan.name }}</option>{% endfor %}</select>
            {% else %}
              <select aria-label="Subscription delivery frequency"><option>{{ section.settings.frequency_label }}</option></select>
            {% endif %}
          </div>
        </div>
        {% endif %}

        <div class="pdp-buy-row">
          <div class="quantity pdp-quantity"><button type="button" data-qty="minus" aria-label="Decrease quantity">−</button><input name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity"><button type="button" data-qty="plus" aria-label="Increase quantity">+</button></div>
          <button class="pdp-atc" type="submit" data-product-submit data-add-label="{{ section.settings.add_label | escape }}" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ section.settings.add_label }} - {{ display_price }}{% else %}Sold out{% endif %}</button>
        </div>
        {% if section.settings.show_dynamic_checkout %}
          <button
            class="pdp-buy-now shopify-payment-button__button shopify-payment-button__button--unbranded"
            type="button"
            id="flo-buy-now-button"
            name="flo-buy-now-button"
            data-pdp-buy-now
            onclick="if(typeof handleFloBuyNowBtn==='function'){handleFloBuyNowBtn(event);return false;}"
          >
            Buy it now
          </button>
        {% endif %}
        {% if section.settings.shipping_text != blank or section.settings.returns_text != blank %}
          <ul class="pdp-policy-list" role="list">
            {% if section.settings.shipping_text != blank %}
              <li>{% render 'icon', name: 'shipping' %}{{ section.settings.shipping_text }}</li>
            {% endif %}
            {% if section.settings.returns_text != blank %}
              <li>{% render 'icon', name: 'guarantee' %}{{ section.settings.returns_text }}</li>
            {% endif %}
          </ul>
        {% endif %}
        {% render 'pdp-share', product: product %}
        {% if outcome_blocks.size > 0 %}
          <div class="pdp-outcomes" aria-label="Key product outcomes">
            {% for block in outcome_blocks %}
              <article class="pdp-outcome" {{ block.shopify_attributes }}>
                {% if block.settings.stat != blank %}<strong>{{ block.settings.stat }}</strong>{% endif %}
                <span>{{ block.settings.label }}</span>
                {% if block.settings.detail != blank %}<small>{{ block.settings.detail }}</small>{% endif %}
              </article>
            {% endfor %}
          </div>
        {% else %}
          {% render 'product-outcomes', product: product %}
        {% endif %}
        {% if display_description != blank %}<div class="pdp-description rte">{{ display_description }}</div>{% endif %}
        {% if section.settings.gift_text != blank %}<div class="pdp-gift">{{ section.settings.gift_text }}</div>{% endif %}
      {% endform %}

      {% if highlight_blocks.size > 0 %}<div class="pdp-highlights">
        {% assign highlight_index = 0 %}
        {% for block in section.blocks %}{% if block.type == 'highlight' %}
          {% assign highlight_index = highlight_index | plus: 1 %}
          {% assign fallback_highlight = 'pdp-highlight-cruelty.jpg' %}{% if highlight_index == 2 %}{% assign fallback_highlight = 'pdp-highlight-paraben.jpg' %}{% elsif highlight_index == 3 %}{% assign fallback_highlight = 'pdp-highlight-vegan.jpg' %}{% endif %}
          {% if section.settings.gallery_layout == 'thumbnails' %}{% assign fallback_highlight = 'pdp-hydra-highlight-vegan.jpg' %}{% if highlight_index == 2 %}{% assign fallback_highlight = 'pdp-hydra-highlight-alcohol.jpg' %}{% elsif highlight_index == 3 %}{% assign fallback_highlight = 'pdp-hydra-highlight-paraben.jpg' %}{% endif %}{% endif %}
          <article {{ block.shopify_attributes }}>{% render 'purity-image', image: block.settings.image, fallback_asset: fallback_highlight, fallback_width: 130, fallback_height: 130, alt: block.settings.heading, sizes: '72px' %}<span>{{ block.settings.heading }}</span></article>
        {% endif %}{% endfor %}
      </div>{% endif %}

      {% if benefit_blocks.size > 0 %}<div class="pdp-benefits"><h2>{{ section.settings.benefits_heading }}</h2><ul role="list">{% for block in benefit_blocks %}<li {{ block.shopify_attributes }}><span>✓</span>{{ block.settings.text }}</li>{% endfor %}</ul></div>{% endif %}

      {% if action_blocks.size > 0 %}<div class="pdp-action">
        <div class="pdp-action__head"><h2>{{ section.settings.action_heading }}</h2><div class="pdp-action__nav"><button type="button" data-pdp-action-dir="prev" aria-label="Previous video">{% render 'icon', name: 'arrow-left' %}</button><button type="button" data-pdp-action-dir="next" aria-label="Next video">{% render 'icon', name: 'arrow-right' %}</button></div></div>
        <div class="pdp-action__rail" data-pdp-action-rail>
          {% assign action_index = 0 %}{% for block in section.blocks %}{% if block.type == 'action_video' %}{% assign action_index = action_index | plus: 1 %}{% assign fallback_action = 'pdp-action-' | append: action_index | append: '.jpg' %}
            <button class="pdp-action__card" type="button" data-pdp-video-open data-video-url="{{ block.settings.video_url }}" aria-label="Play {{ block.settings.label }}" {{ block.shopify_attributes }}>{% render 'purity-image', image: block.settings.poster, fallback_asset: fallback_action, fallback_width: 1080, fallback_height: 1628, alt: block.settings.label, sizes: '150px' %}<span class="pdp-action__play" aria-hidden="true">▶</span></button>
          {% endif %}{% endfor %}
        </div>
      </div>{% endif %}

      {% if section.settings.show_pickup %}
        <div class="pdp-pickup"><span class="pdp-pickup__pin" aria-hidden="true">⌖</span><div><strong>{{ section.settings.pickup_heading }}</strong><p>{{ section.settings.pickup_text }}</p></div></div>
      {% endif %}

      {% if accordion_blocks.size > 0 %}
        <div class="pdp-accordions" id="ProductIngredients">{% for block in accordion_blocks %}<details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.heading }} <span aria-hidden="true">+</span></summary><div class="pdp-accordion__content rte">{{ block.settings.content }}</div></details>{% endfor %}</div>
      {% else %}
        {% render 'product-accordion-defaults', product: product %}
      {% endif %}

      {% render 'product-education-cta', product: product %}

      {% if pair_blocks.size > 0 %}<div class="pdp-pairs">
        <div class="pdp-pairs__head"><h2>{{ section.settings.pairs_heading }}</h2><div><button type="button" data-pdp-pair-dir="prev" aria-label="Previous product">{% render 'icon', name: 'arrow-left' %}</button><button type="button" data-pdp-pair-dir="next" aria-label="Next product">{% render 'icon', name: 'arrow-right' %}</button></div></div>
        <div class="pdp-pairs__rail" data-pdp-pair-rail>{% for block in pair_blocks %}{% assign pair = block.settings.product %}<article class="pdp-pair" {{ block.shopify_attributes }}><a href="{{ pair.url | default: '#' }}">{% if pair != blank and pair.featured_image != blank %}{{ pair.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '110,160,220', sizes: '92px', alt: pair.title }}{% else %}<img src="{{ 'product-serum.jpg' | asset_url }}" width="92" height="116" loading="lazy" alt="{{ block.settings.fallback_title | escape }}">{% endif %}<div><strong>{{ pair.title | default: block.settings.fallback_title }}</strong><span>{% if pair != blank %}{{ pair.price | money }}{% else %}{{ block.settings.fallback_price }}{% endif %}</span></div></a>{% if pair != blank %}{% form 'product', pair %}<input type="hidden" name="id" value="{{ pair.selected_or_first_available_variant.id }}"><button type="submit">Add</button>{% endform %}{% else %}<button type="button">Add</button>{% endif %}</article>{% endfor %}</div>
      </div>{% endif %}

      <div class="pdp-help-share">
        <div class="pdp-help-share__copy">
          <p><strong>{{ section.settings.help_heading }}</strong> {{ section.settings.help_text }}</p>
          <button type="button" data-pdp-question-open>{{ section.settings.help_button }}</button>
        </div>
      </div>
      {% if section.settings.disclaimer != blank %}<p class="pdp-disclaimer">{{ section.settings.disclaimer }}</p>{% endif %}
    </div>
  </div>

  {% if section.settings.sticky_add_to_cart %}<div class="pdp-sticky-atc" data-sticky-atc><div class="pdp-sticky-atc__inner"><div class="pdp-sticky-atc__product">{% if product.handle == 'project-skin-complete-4-step-skincare-routine-kit' %}<img src="{{ 'project-skin-routine-kit.jpg' | asset_url }}" width="100" height="126" loading="lazy" alt="{{ display_title | escape }}">{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: display_title }}{% endif %}<div><strong>{{ display_title }}</strong><span>{{ display_price }}</span></div></div>{% unless product.has_only_default_variant %}<div class="pdp-sticky-atc__variant">{{ current_variant.title }}</div>{% endunless %}{% form 'product', product %}<input type="hidden" name="id" value="{{ current_variant.id }}"><div class="quantity pdp-quantity"><button type="button" data-qty="minus">−</button><input name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity"><button type="button" data-qty="plus">+</button></div><button class="pdp-atc" type="submit">{{ section.settings.add_label }} - {{ display_price }}</button>{% endform %}</div></div>{% endif %}

  <dialog class="pdp-video-dialog" data-pdp-video-dialog><button class="pdp-video-dialog__close" type="button" data-pdp-video-close aria-label="Close video">{% render 'icon', name: 'close' %}</button><video controls playsinline data-pdp-dialog-video></video></dialog>
  <dialog class="pdp-question-dialog" data-pdp-question-dialog><button class="pdp-question-dialog__close" type="button" data-pdp-question-close aria-label="Close question form">{% render 'icon', name: 'close' %}</button><p class="pdp-eyebrow">Help Center</p><h2>{{ section.settings.question_heading }}</h2>{% form 'contact' %}<label>Name<input type="text" name="contact[name]" autocomplete="name"></label><label>Email<input type="email" name="contact[email]" autocomplete="email" required></label><label>Your question<textarea name="contact[body]" rows="5" required></textarea></label><button class="pdp-atc" type="submit">Send Question</button>{% endform %}</dialog>
</section>

{% schema %}
{
  "name": "Purity product",
  "settings": [
    { "type": "select", "id": "gallery_layout", "label": "Gallery layout", "options": [{ "value": "stacked", "label": "Stacked editorial" }, { "value": "thumbnails", "label": "Thumbnail slider" }], "default": "stacked" },
    { "type": "checkbox", "id": "use_product_media", "label": "Use product media", "default": true },
    { "type": "checkbox", "id": "use_custom_content", "label": "Use custom display content", "default": false },
    { "type": "text", "id": "title_override", "label": "Display title", "default": "Lift Lash Mascara" },
    { "type": "text", "id": "price_override", "label": "Display price", "default": "$40.00" },
    { "type": "image_picker", "id": "main_image", "label": "Main image" },
    { "type": "image_picker", "id": "detail_image_1", "label": "Detail image 1" },
    { "type": "image_picker", "id": "detail_image_2", "label": "Detail image 2" },
    { "type": "image_picker", "id": "detail_image_3", "label": "Detail image 3" },
    { "type": "image_picker", "id": "thumbnail_image_1", "label": "Thumbnail gallery image 1" },
    { "type": "image_picker", "id": "thumbnail_image_2", "label": "Thumbnail gallery image 2" },
    { "type": "image_picker", "id": "thumbnail_image_3", "label": "Thumbnail gallery image 3" },
    { "type": "image_picker", "id": "thumbnail_image_4", "label": "Thumbnail gallery image 4" },
    { "type": "checkbox", "id": "enable_zoom", "label": "Enable image zoom", "default": true },
    { "type": "text", "id": "concern_line", "label": "Concern / solution line", "info": "Leave blank to use the product-specific default." },
    { "type": "textarea", "id": "mechanism_line", "label": "Mechanism line", "info": "Short buy-box line under the title. Leave blank for the formula catalog default." },
    { "type": "checkbox", "id": "use_judgeme_rating", "label": "Use Judge.me star rating", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show manual rating (fallback)", "default": false },
    { "type": "text", "id": "rating", "label": "Rating", "default": "5.0" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "2" },
    { "type": "checkbox", "id": "show_demo_swatches", "label": "Show custom color swatches", "default": false },
    { "type": "checkbox", "id": "show_variant_picker", "label": "Show product variant picker", "default": true },
    { "type": "text", "id": "swatch_1_label", "label": "Swatch 1 label", "default": "Orange" },
    { "type": "color", "id": "swatch_1_color", "label": "Swatch 1 color", "default": "#e66b23" },
    { "type": "text", "id": "swatch_2_label", "label": "Swatch 2 label", "default": "Green" },
    { "type": "color", "id": "swatch_2_color", "label": "Swatch 2 color", "default": "#667853" },
    { "type": "text", "id": "inventory_text", "label": "Inventory message", "default": "Low stock: 20 left" },
    { "type": "select", "id": "inventory_tone", "label": "Inventory color", "options": [{ "value": "low", "label": "Low stock" }, { "value": "available", "label": "In stock" }], "default": "low" },
    { "type": "checkbox", "id": "show_purchase_options", "label": "Show purchase options", "default": true },
    { "type": "text", "id": "one_time_label", "label": "One-time purchase label", "default": "One Time Purchase" },
