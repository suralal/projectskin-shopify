<section class="section offers-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: 'left' %}<div class="offer-grid" data-mobile-scroll>{% for block in section.blocks %}<article class="offer-card" {{ block.shopify_attributes }}>{% if block.settings.image %}<div class="offer-card__media">{{ block.settings.image | image_url: width:1000 | image_tag:loading:'lazy', widths:'480,720,1000' }}</div>{% endif %}<div class="offer-card__overlay"></div><div class="offer-card__content"><span class="offer-card__badge">{{ block.settings.badge }}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>{% if block.settings.link %}<a class="btn btn--light" href="{{ block.settings.link }}">{{ block.settings.label }}</a>{% endif %}</div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Promotional offers","settings":[{"type":"text","id":"subheading","label":"Subheading","default":"Special skincare offers"},{"type":"text","id":"heading","label":"Heading","default":"Today's Best Deals"},{"type":"richtext","id":"description","label":"Description"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":72,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":72,"unit":"px"}],"blocks":[{"type":"offer","name":"Offer","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"badge","label":"Badge","default":"Save 35%"},{"type":"text","id":"heading","label":"Heading","default":"Build Your Routine"},{"type":"textarea","id":"text","label":"Text","default":"Pick your favorites and save when you build a complete routine."},{"type":"text","id":"label","label":"Button label","default":"Shop offer"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":6,"presets":[{"name":"Promotional offers","blocks":[{"type":"offer"},{"type":"offer"},{"type":"offer"}]}]}{% endschema %}