<section class="psr-route-fallback psr-route-fallback--science psr-page psr-section psr-science-guardrails">
  <div class="container psr-science-guardrails__grid">
    <div class="psr-science-guardrails__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '700,1000,1400,1800', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.image_alt }}
      {% else %}
        <img src="{{ 'project-skin-philosophy-lab.jpg' | asset_url }}" width="1536" height="864" loading="lazy" alt="Project Skin formulation review">
      {% endif %}
    </div>
    <div class="psr-science-guardrails__content">
      <span class="psr-kicker">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      <div class="psr-guardrail-list">
        {% for block in section.blocks %}
          <article {{ block.shopify_attributes }}><span>0{{ forloop.index }}</span><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></article>
        {% endfor %}
      </div>
      {% if section.settings.button_label != blank %}<a class="psr-button" href="{{ section.settings.button_link | default: '/pages/consultation' }}">{{ section.settings.button_label }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science guardrails",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technology with boundaries" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Useful guidance. Clear limits." },
    { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Project Skin technology is designed to improve cosmetic skincare decisions. It does not diagnose disease or replace qualified medical care.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alternative text", "default": "Human review within the Project Skin system" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book a dermatologist consultation" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "guardrail",
      "name": "Guardrail",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Guidance, not diagnosis" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Visible signals help organize cosmetic concerns; clinical symptoms need a dermatologist." }
      ]
    }
  ],
  "presets": [{ "name": "Science guardrails", "blocks": [{ "type": "guardrail" }, { "type": "guardrail" }, { "type": "guardrail" }] }]
}
{% endschema %}
