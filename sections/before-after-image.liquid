<section class="section"><div class="container">{% render 'section-head', eyebrow:section.settings.subheading, heading:section.settings.heading %}<div class="before-after" data-before-after><div class="before-after__after">{% if section.settings.after %}{{ section.settings.after | image_url:width:1800 | image_tag:loading:'lazy' }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div class="before-after__before" data-before-layer>{% if section.settings.before %}{{ section.settings.before | image_url:width:1800 | image_tag:loading:'lazy' }}{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div class="before-after__labels"><span>{{ section.settings.before_label }}</span><span>{{ section.settings.after_label }}</span></div><div class="before-after__line" data-before-line><span>↔</span></div><input class="before-after__range" type="range" min="0" max="100" value="50" aria-label="Compare before and after" data-before-range></div></div></section>{% schema %}{"name":"Before/After image","settings":[{"type":"text","id":"subheading","label":"Subheading"},{"type":"text","id":"heading","label":"Heading"},{"type":"image_picker","id":"before","label":"Before image"},{"type":"image_picker","id":"after","label":"After image"},{"type":"text","id":"before_label","label":"Before label","default":"Before"},{"type":"text","id":"after_label","label":"After label","default":"After"}],"presets":[{"name":"Before/After image"}]}{% endschema %}