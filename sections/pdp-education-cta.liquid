<section
  class="pdp-section pdp-edu-section"
  style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"
>
  <div class="page-width-pdp">
    {% render 'product-education-cta', product: product %}
  </div>
</section>

{% schema %}
{
  "name": "PDP education CTAs",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "PDP education CTAs" }]
}
{% endschema %}
