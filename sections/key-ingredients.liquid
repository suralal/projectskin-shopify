<section class="section ingredients-section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="container">{% render 'section-head', subheading: section.settings.subheading, heading: section.settings.heading, description: section.settings.description, alignment: 'left' %}<div class="ingredient-grid" data-mobile-scroll>{% for block in section.blocks %}<article class="ingredient-card" {{ block.shopify_attributes }}>{% if block.settings.image %}<div class="ingredient-card__media">{{ block.settings.image | image_url: width:700 | image_tag:loading:'lazy', widths:'320,480,700' }}</div>{% endif %}<div class="ingredient-card__body"><span class="eyebrow">{{ block.settings.benefit }}</span><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></article>{% endfor %}</div>{% if section.settings.link != blank %}<div class="ingredients-section__footer"><a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }} →</a></div>{% endif %}</div></section>
{% schema %}{"name":"Key ingredients","settings":[{"type":"text","id":"subheading","label":"Subheading","default":"Plant-powered care"},{"type":"text","id":"heading","label":"Heading","default":"Key Ingredients"},{"type":"richtext","id":"description","label":"Description"},{"type":"text","id":"link_label","label":"Link label","default":"View all ingredients"},{"type":"url","id":"link","label":"Link"},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"default":72,"unit":"px"},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"default":72,"unit":"px"}],"blocks":[{"type":"ingredient","name":"Ingredient","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"benefit","label":"Benefit","default":"Hydration"},{"type":"text","id":"heading","label":"Ingredient","default":"Hyaluronic Acid"},{"type":"textarea","id":"text","label":"Description","default":"A hydration-supporting ingredient selected to help skin feel smooth, comfortable and replenished."}]}],"max_blocks":10,"presets":[{"name":"Key ingredients","blocks":[{"type":"ingredient"},{"type":"ingredient"},{"type":"ingredient"},{"type":"ingredient"}]}]}{% endschema %}