<section
  class="pdp-section psr-journal-teaser"
  style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px"
>
  <div class="page-width-pdp{% if section.settings.wide %} container{% endif %}">
    <div class="psr-journal-teaser__head">
      <div class="psr-journal-teaser__intro">
        {% if section.settings.eyebrow != blank %}
          <span class="psr-kicker">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}
          <p class="psr-journal-teaser__lede">{{ section.settings.text }}</p>
        {% endif %}
      </div>
      {% if section.settings.cta_label != blank %}
        <a class="psr-journal-teaser__cta-link" href="{{ section.settings.cta_link | default: '/pages/journal' }}">
          {{ section.settings.cta_label }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="psr-journal-teaser__grid">
        {% for block in section.blocks %}
          {% liquid
            assign season_theme = block.settings.theme | default: 'monsoon'
            assign fallback = 'project-skin-journal-monsoon.png'
            case season_theme
              when 'festive'
                assign fallback = 'project-skin-journal-festive.png'
              when 'winter'
                assign fallback = 'project-skin-journal-winter.png'
              else
                assign fallback = 'project-skin-journal-monsoon.png'
            endcase
            assign card_alt = block.settings.heading | default: season_theme | append: ' season module'
          %}
          <a
            class="psr-journal-teaser__card psr-journal-teaser__card--{{ season_theme }}"
            href="{{ block.settings.link | default: '/pages/journal' }}"
            {{ block.shopify_attributes }}
          >
            <span class="psr-journal-teaser__media">
              {% render 'purity-image',
                image: block.settings.image,
                fallback_asset: fallback,
                fallback_width: 1024,
                fallback_height: 682,
                alt: card_alt,
                sizes: '(min-width: 990px) 30vw, 88vw',
                loading: 'lazy'
              %}
            </span>
            <span class="psr-journal-teaser__body visually-hidden">
              {% if block.settings.eyebrow != blank %}
                <span class="psr-journal-teaser__eyebrow">{{ block.settings.eyebrow }}</span>
              {% endif %}
              <strong>{{ block.settings.heading }}</strong>
              {% if block.settings.text != blank %}
                <span class="psr-journal-teaser__text">{{ block.settings.text }}</span>
              {% endif %}
              <span class="psr-journal-teaser__go">Read module</span>
            </span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Journal teaser",
  "settings": [
    { "type": "checkbox", "id": "wide", "label": "Use homepage container width", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Project Skin Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Education on a calendar." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Seasonal climate modules and literacy threads — not sale banners." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Open the journal" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "theme",
          "label": "Season theme",
          "options": [
            { "value": "monsoon", "label": "Monsoon" },
            { "value": "festive", "label": "Festive" },
            { "value": "winter", "label": "Winter" }
          ],
          "default": "monsoon"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Season" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Monsoon" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Humidity does not cancel acne biology." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal teaser",
      "blocks": [
        { "type": "card", "settings": { "theme": "monsoon", "eyebrow": "Season", "heading": "Monsoon", "text": "Humidity does not cancel acne biology.", "link": "/pages/monsoon" } },
        { "type": "card", "settings": { "theme": "festive", "eyebrow": "Season", "heading": "Festive", "text": "Celebration skin still needs biology.", "link": "/pages/festive" } },
        { "type": "card", "settings": { "theme": "winter", "eyebrow": "Season", "heading": "Winter", "text": "Dryness is often a barrier story.", "link": "/pages/winter" } }
      ]
    }
  ]
}
{% endschema %}
