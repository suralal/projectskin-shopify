<section class="pdp-section psr-journal-teaser" style="--pdp-pad-top: {{ section.settings.padding_top }}px; --pdp-pad-bottom: {{ section.settings.padding_bottom }}px">
  <div class="page-width-pdp{% if section.settings.wide %} container{% endif %}">
    <div class="psr-journal-teaser__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="psr-kicker">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>
    <div class="psr-journal-teaser__grid">
      {% for block in section.blocks %}
        <a class="psr-journal-teaser__card" href="{{ block.settings.link | default: '/pages/journal' }}" {{ block.shopify_attributes }}>
          <span class="psr-kicker">{{ block.settings.eyebrow }}</span>
          <strong>{{ block.settings.heading }}</strong>
          <span>{{ block.settings.text }}</span>
        </a>
      {% endfor %}
    </div>
    {% if section.settings.cta_label != blank %}
      <div class="psr-journal-teaser__cta">
        <a class="psr-button" href="{{ section.settings.cta_link | default: '/pages/journal' }}">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Journal teaser",
  "settings": [
    { "type": "checkbox", "id": "wide", "label": "Use homepage container width", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Project Skin Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Education on a calendar." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Seasonal climate modules and literacy threads — not sale banners." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Open the journal" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Season" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Monsoon" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Humidity does not cancel acne biology." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal teaser",
      "blocks": [
        { "type": "card", "settings": { "eyebrow": "Season", "heading": "Monsoon", "text": "Humidity does not cancel acne biology.", "link": "/pages/monsoon" } },
        { "type": "card", "settings": { "eyebrow": "Season", "heading": "Festive", "text": "Celebration skin still needs biology.", "link": "/pages/festive" } },
        { "type": "card", "settings": { "eyebrow": "Season", "heading": "Winter", "text": "Dryness is often a barrier story.", "link": "/pages/winter" } }
      ]
    }
  ]
}
{% endschema %}
