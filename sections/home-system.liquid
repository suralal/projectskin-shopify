<style>
  .system-section {
    background-color: #F6F6F6;
    padding: 30px;
  }
  @media (min-width: 768px) {
    .system-section {
      padding: 30px;
    }
  }
  
  .system-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0,0,0,0.05);
  }
  @media (min-width: 768px) {
    .system-container {
      flex-direction: row;
      min-height: 600px;
    }
  }
  
  .system-left {
    background-color: #B43C57;
    padding: 60px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }
  @media (min-width: 768px) {
    .system-left {
      width: 50%;
      flex: none;
      padding: 80px 8%;
    }
  }
  
  .system-right {
    background-image: url('{{ 'home_section_6_bg.webp' | asset_url }}');
    background-size: cover;
    background-position: center;
    padding: 60px 16px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .system-right {
      width: 50%;
      flex: none;
      padding: 60px 30px;
    }
  }
  
  .system-cards-wrapper {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 320px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, black 65%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 65%, transparent 100%);
  }
  @media (min-width: 768px) {
    .system-cards-wrapper {
      height: 400px;
    }
  }
  
  .system-cards-track {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .system-card {
    border-radius: 12px;
    padding: 16px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: top center;
  }
  @media (min-width: 768px) {
    .system-card {
      padding: 24px;
    }
  }
  
  /* Initial hidden state before JS kicks in */
  .system-card {
    opacity: 0;
  }
  
  /* State Classes applied by JS */
  .system-card.pos-0 {
    background-color: #FFFFFF;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    transform: scale(1);
    opacity: 1;
    z-index: 3;
    border: 1px solid transparent;
  }
  
  .system-card.pos-1 {
    background-color: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.4);
    transform: scale(0.95);
    opacity: 0.9;
    z-index: 2;
  }
  
  .system-card.pos-2 {
    background-color: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.2);
    transform: scale(0.90);
    opacity: 0.7;
    z-index: 1;
  }
  
  .system-card.pos-3 {
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
  }
  
  .system-card.pos-out {
    opacity: 0 !important;
    transform: translateY(-20px) scale(0.95) !important;
    pointer-events: none;
  }
  
  /* Internal Elements Styling */
  .card-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .card-icon.active-icon {
    background-color: #F9428B;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 14px;
  }
  
  .card-icon.dotted-icon {
    border: 1.5px dashed #888888;
  }
  
  .card-content {
    flex: 1;
  }
  
  .card-title-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 8px;
    gap: 8px;
  }
  @media (min-width: 768px) {
    .card-title-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  
  .card-title {
    font-weight: 600;
    font-size: 16px;
    color: #181818;
    margin: 0;
    line-height: 1.3;
  }
  @media (min-width: 768px) {
    .card-title {
      font-size: 18px;
    }
  }
  
  .pos-1 .card-title, .pos-2 .card-title {
    opacity: 0.85;
  }
  
  .card-subtext {
    font-size: 13px;
    color: #555555;
    line-height: 1.5;
    margin: 0;
  }
  @media (min-width: 768px) {
    .card-subtext {
      font-size: 14px;
    }
  }
  
  .pill-coming-soon {
    border: 1px solid #8D3200;
    color: #8D3200;
    border-radius: 99px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0.9;
    flex-shrink: 0;
  }
  
  /* Left Section Typography & Buttons */
  .left-heading {
    color: #FFFFFF;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 24px;
  }
  @media (min-width: 768px) {
    .left-heading {
      font-size: 36px;
    }
  }
  @media (min-width: 1024px) {
    .left-heading {
      font-size: 56px;
    }
  }
  
  .left-text {
    color: #FFFFFF;
    font-size: 16px;
    line-height: 1.6;
    opacity: 0.9;
    max-width: 480px;
  }
  
  .btn-waitlist {
    background-color: #F9428B;
    color: #FFFFFF;
    padding: 14px 28px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 32px;
    transition: opacity 0.2s;
  }
  .btn-waitlist:hover {
    opacity: 0.9;
    color: white;
  }
  .btn-waitlist svg {
    margin-left: 8px;
  }
</style>

<section class="system-section">
  <div class="system-container">
    <div class="system-left">
      <h2 class="left-heading">Skincare is step one. This is the whole system.</h2>
      <p class="left-text">Skin reflects deeper health—from your gut to hormones and environment. Like a cardiologist treats causes, we address what drives your skin, not just symptoms. We're delivering the solution step by step.</p>
      
      <a href="#home-waitlist" class="btn-waitlist">
        Join the waitlist
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
    
    <div class="system-right">
      <div class="system-cards-wrapper">
        <div class="system-cards-track" id="systemCardsTrack">
          
            <div class="system-card">
              <div class="card-icon active-icon">
                1
              </div>
              <div class="card-content">
                <div class="card-title-row">
                  <h3 class="card-title">Science-backed skincare</h3>
                  
                </div>
                <p class="card-subtext">Topical treatment at efficacious concentrations.</p>
              </div>
            </div>
          
            <div class="system-card">
              <div class="card-icon dotted-icon">
                
              </div>
              <div class="card-content">
                <div class="card-title-row">
                  <h3 class="card-title">Gut nutraceuticals</h3>
                  
                    <span class="pill-coming-soon">Coming soon</span>
                  
                </div>
                <p class="card-subtext">The gut-skin axis is real. Target inflammation from the inside.</p>
              </div>
            </div>
          
            <div class="system-card">
              <div class="card-icon dotted-icon">
                
              </div>
              <div class="card-content">
                <div class="card-title-row">
                  <h3 class="card-title">Online dermatologist consultations</h3>
                  
                    <span class="pill-coming-soon">Coming soon</span>
                  
                </div>
                <p class="card-subtext">Prescription-grade care when topicals alone aren't enough.</p>
              </div>
            </div>
          
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initSystemAnimation() {
    const track = document.getElementById('systemCardsTrack');
    if (!track || track.children.length <= 1 || track.dataset.initialized) return;
    track.dataset.initialized = 'true';
    
    // Clone cards for seamless infinite loop
    const originalCards = Array.from(track.children);
    originalCards.forEach(card => {
      const clone = card.cloneNode(true);
      track.appendChild(clone);
    });

    // Initialize CSS classes based on index
    const updatePositions = () => {
      Array.from(track.children).forEach((card, index) => {
        card.classList.remove('pos-0', 'pos-1', 'pos-2', 'pos-3', 'pos-out');
        if (index === 0) card.classList.add('pos-0');
        else if (index === 1) card.classList.add('pos-1');
        else if (index === 2) card.classList.add('pos-2');
        else card.classList.add('pos-3');
      });
    };
    
    updatePositions(); // Initial render

    if (window.systemInterval) clearInterval(window.systemInterval);

    window.systemInterval = setInterval(() => {
      const currentCards = Array.from(track.children);
      const firstCard = currentCards[0];
      const secondCard = currentCards[1];
      const thirdCard = currentCards[2];
      const fourthCard = currentCards[3];
      
      const cardHeight = firstCard.offsetHeight;
      const gap = 16;
      
      // Step 1: Add transitioning classes
      firstCard.classList.remove('pos-0');
      firstCard.classList.add('pos-out');
      
      if (secondCard) {
        secondCard.classList.remove('pos-1');
        secondCard.classList.add('pos-0');
      }
      
      if (thirdCard) {
        thirdCard.classList.remove('pos-2');
        thirdCard.classList.add('pos-1');
      }
      
      if (fourthCard) {
        fourthCard.classList.remove('pos-3');
        fourthCard.classList.add('pos-2');
      }
      
      track.style.transform = `translateY(-${cardHeight + gap}px)`;
      
      // Step 2: Cleanup and Reset Track
      setTimeout(() => {
        track.style.transition = 'none';
        track.style.transform = 'translateY(0)';
        
        // Move the first card to the bottom
        track.appendChild(firstCard);
        
        // Ensure classes are perfectly aligned with DOM state
        updatePositions();
        
        // Force reflow
        void track.offsetHeight;
        track.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
      }, 600);
      
    }, 2500);
  }

  document.addEventListener('DOMContentLoaded', initSystemAnimation);
  document.addEventListener('shopify:section:load', initSystemAnimation);

  document.addEventListener('DOMContentLoaded', function() {
    const sysBtns = document.querySelectorAll('.btn-waitlist');
    sysBtns.forEach(btn => {
      if(btn.getAttribute('href') && btn.getAttribute('href').includes('#home-waitlist')) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.getElementById('home-waitlist');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
    });
  });
</script>


</div>
{% schema %}
{
  "name": "Home System",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Skincare is step one. This is the whole system."
    }
  ],
  "presets": [
    {
      "name": "Home System"
    }
  ]
}
{% endschema %}
