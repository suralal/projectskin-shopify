<section class="ps-template ps-contact psr-route-fallback psr-route-fallback--contact" id="ContactForm">
  <div class="container ps-contact__layout">
    <div class="ps-contact__copy">
      <span class="ps-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{% endif %}
      {% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>{% endif %}
    </div>

    {% form 'contact', class: 'ps-contact__form' %}
      {% if form.posted_successfully? %}<div class="ps-form-message" role="status">Thanks. We'll be in touch soon.</div>{% endif %}
      {% if form.errors %}<div class="ps-form-message ps-form-message--error">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="ps-field-row">
        <div class="ps-field">
          <label for="ContactName-{{ section.id }}">Name</label>
          <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required>
        </div>
        <div class="ps-field">
          <label for="ContactEmail-{{ section.id }}">Email</label>
          <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required>
        </div>
      </div>
      <div class="ps-field">
        <label for="ContactPhone-{{ section.id }}">Phone <span>(optional)</span></label>
        <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
      </div>
      <div class="ps-field">
        <label for="ContactTopic-{{ section.id }}">Topic</label>
        <select id="ContactTopic-{{ section.id }}" name="contact[topic]">
          <option>Product advice</option>
          <option>Order support</option>
          <option>Returns</option>
          <option>Partnerships</option>
          <option>Other</option>
        </select>
      </div>
      <div class="ps-field">
        <label for="ContactMessage-{{ section.id }}">Message</label>
        <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea>
      </div>
      <button class="ps-button" type="submit">{{ section.settings.button_label }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "We're here to help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to Project Skin" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ask about products, routines, orders, or anything else on your mind. Our support team will reply as soon as possible.</p>" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@projectskin.co" },
    { "type": "text", "id": "phone", "label": "Phone" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Send message" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
