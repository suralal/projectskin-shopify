{% liquid
  assign announcement_palette = ''
  if request.page_type == 'product' and product != blank
    capture announcement_palette
      render 'product-palette-name', product: product
    endcapture
    assign announcement_palette = announcement_palette | strip
  endif
%}
<div
  class="announcement announcement--slider"
  data-announcement-slider
  data-follow-hero-palette="true"
  {% if announcement_palette != blank %}data-active-palette="{{ announcement_palette }}"{% endif %}
  data-speed="{{ section.settings.speed | times: 1000 }}"
>
  {% if section.blocks.size > 1 %}
    <button class="announcement__arrow announcement__arrow--prev" type="button" data-announcement-prev aria-label="Previous announcement">‹</button>
  {% endif %}
  <div class="announcement__inner">
    {% for block in section.blocks %}
      <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" data-announcement-slide>
        {{ block.settings.text }}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Shop now' }}</a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <button class="announcement__arrow announcement__arrow--next" type="button" data-announcement-next aria-label="Next announcement">›</button>
  {% endif %}
</div>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "range", "id": "speed", "label": "Change every", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on qualifying orders" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Get Deals" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }, { "type": "announcement" }, { "type": "announcement" }]
    }
  ]
}
{% endschema %}
