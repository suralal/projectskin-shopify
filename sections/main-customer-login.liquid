<section class="ps-customer ps-auth" data-customer-account>
  <div class="ps-auth__form">
    <div class="ps-auth__form-inner">
      {% form 'recover_customer_password', class: 'ps-account-form' %}
        {% assign recover_success = form.posted_successfully? %}
        <div class="ps-recover" data-recover-panel {% unless form.errors or form.posted_successfully? %}hidden{% endunless %}>
          <span class="ps-customer__eyebrow">Account access</span>
          <h1>{{ section.settings.recover_heading }}</h1>
          <p class="ps-customer__lede">{{ section.settings.recover_text }}</p>

          {% if form.posted_successfully? %}
            <div class="ps-form-success" role="status">We sent a password reset link to your email address.</div>
          {% endif %}
          {% if form.errors %}
            <div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="ps-field">
            <label for="RecoverEmail">Email address</label>
            <input
              id="RecoverEmail"
              type="email"
              name="email"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              value="{{ form.email }}"
              required
            >
          </div>
          <button class="ps-button-account" type="submit">Send reset link</button>
          <button class="ps-account-link" type="button" data-recover-close>Back to sign in</button>
        </div>
      {% endform %}

      <div class="ps-login-panel" data-login-panel {% if recover_success %}hidden{% endif %}>
        <span class="ps-customer__eyebrow">{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="ps-customer__lede">{{ section.settings.text }}</p>

        {% form 'customer_login', class: 'ps-account-form', novalidate: 'novalidate' %}
          {% if form.errors %}
            <div class="ps-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="ps-field">
            <label for="CustomerEmail">Email address</label>
            <input
              id="CustomerEmail"
              type="email"
              name="customer[email]"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              required
            >
          </div>

          {% if form.password_needed %}
            <div class="ps-field">
              <label for="CustomerPassword">Password</label>
              <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
            </div>
          {% endif %}

          <div class="ps-account-form__meta">
            <span>Secure access to your Project Skin account.</span>
            <button class="ps-account-link" type="button" data-recover-open>Forgot password?</button>
          </div>
          <button class="ps-button-account" type="submit">{{ section.settings.button_label }}</button>
        {% endform %}

        {% if shop.checkout.guest_login %}
          {% form 'guest_login', class: 'ps-account-form' %}
            <button class="ps-button-account--secondary" type="submit">Continue as guest</button>
          {% endform %}
        {% endif %}
      </div>
    </div>
  </div>

  <aside class="ps-auth__aside">
    <span class="ps-customer__eyebrow">{{ section.settings.aside_eyebrow }}</span>
    <h2>{{ section.settings.aside_heading }}</h2>
    <p>{{ section.settings.aside_text }}</p>
    <ul class="ps-auth__benefits" role="list">
      <li>See orders and delivery status</li>
      <li>Save addresses for faster checkout</li>
      <li>Keep your routine in one place</li>
    </ul>
    <a class="ps-button-account--secondary" href="{{ routes.account_register_url }}">{{ section.settings.register_label }}</a>
  </aside>
</section>

{% schema %}
{
  "name": "Customer sign in",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your Project Skin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome back" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sign in to view your orders, saved details, and the care selected for your skin." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign in" },
    { "type": "text", "id": "recover_heading", "label": "Recovery heading", "default": "Reset your password" },
    { "type": "textarea", "id": "recover_text", "label": "Recovery text", "default": "Enter the email linked to your account and we will send you a secure reset link." },
    { "type": "header", "content": "New customer panel" },
    { "type": "text", "id": "aside_eyebrow", "label": "Eyebrow", "default": "New to Project Skin?" },
    { "type": "text", "id": "aside_heading", "label": "Heading", "default": "Care that remembers you." },
    { "type": "textarea", "id": "aside_text", "label": "Text", "default": "Create an account for a calmer, more connected way to manage your skincare journey." },
    { "type": "text", "id": "register_label", "label": "Register button", "default": "Create an account" }
  ]
}
{% endschema %}
