    "formula_earn": {
      "type": "ps-formula-earn",
      "blocks": {
        "niacinamide": {
          "type": "ingredient",
          "settings": {
            "heading": "Niacinamide",
            "inci": "Niacinamide (Vitamin B3), encapsulated",
            "caption": "C₆H₆N₂O · pyridine-3-carboxamide",
            "mechanism": "Regulates sebum at the sebocyte and interrupts pigment transfer between cells. One reason a single active can address oil and post-acne marks at once.",
            "note": "Effect appears from about 2%. Benefit plateaus near 5% and irritation climbs past 10% — so 5% is a ceiling worth formulating to, not a number chosen for the label.",
            "dose": "5",
            "band_min": "2",
            "band_max": "5",
            "scale_max": "10",
            "products": "Serum, Moisturiser, Sunscreen, Clear Seal",
            "molecule": "niacinamide"
          }
        },
        "salicylic": {
          "type": "ingredient",
          "settings": {
            "heading": "Salicylic Acid",
            "inci": "Salicylic Acid (BHA)",
            "caption": "C₇H₆O₃ · 2-hydroxybenzoic acid",
            "mechanism": "Oil-soluble, so it travels through sebum rather than sitting on it. Breaks the bonds between dead cells inside the follicle — where the blockage forms.",
            "note": "2% is the permitted maximum for leave-on cosmetic use in most markets, and the concentration used in the majority of published acne trials.",
            "dose": "2",
            "band_min": "0.5",
            "band_max": "2",
            "scale_max": "4",
            "products": "Cleanser, Clear Seal, Active Boba",
            "molecule": "salicylic"
          }
        },
        "zinc": {
          "type": "ingredient",
          "settings": {
            "heading": "Zinc PCA",
            "inci": "Zinc PCA",
            "caption": "Zn²⁺ · pyroglutamate complex",
            "mechanism": "Inhibits 5-alpha reductase in the sebaceous gland, lowering sebum production at source rather than absorbing it afterwards. It’s what keeps a sunscreen wearable in Indian humidity.",
            "note": "Effective from 0.1–1%. We formulate at 0.5% and pair it with a second sebum pathway instead of pushing one further.",
            "dose": "0.5",
            "band_min": "0.1",
            "band_max": "1",
            "scale_max": "2",
            "products": "Sunscreen, Serum, Active Boba",
            "molecule": "zinc"
          }
        },
        "glycolic": {
          "type": "ingredient",
          "settings": {
            "heading": "Glycolic Acid",
            "inci": "Glycolic Acid (AHA)",
            "caption": "C₂H₄O₃ · smallest alpha-hydroxy acid",
            "mechanism": "The smallest AHA molecule, so it penetrates fastest. Loosens adhesion between surface cells and accelerates turnover — how marks clear rather than merely fade.",
            "note": "Deliberately low. At 1% in a rinse-off cleanser it works alongside salicylic acid without the barrier cost leave-on glycolic carries.",
            "dose": "1",
            "band_min": "0.5",
            "band_max": "10",
            "scale_max": "12",
            "products": "Cleanser, Clear Seal",
            "molecule": "glycolic"
          }
        },
        "ceramides": {
          "type": "ingredient",
          "settings": {
            "heading": "Ceramides NP·AP·EOP",
            "inci": "Ceramide NP, AP, EOP",
            "caption": "sphingoid base + fatty acid chain",
            "mechanism": "Skin holds its cells together with a lipid mortar roughly half made of ceramide. Damage strips it. These three replace the specific subtypes human skin uses, in the ratio it uses them.",
            "note": "Ratio matters more than raw percentage — which is why the number alone is a weak claim, and why most brands quote it anyway.",
            "dose": "3",
            "band_min": "1",
            "band_max": "5",
            "scale_max": "6",
            "products": "Active Boba, Moisturiser",
            "molecule": "ceramides"
          }
        },
